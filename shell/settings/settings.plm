scene TohruSettings {
 surface { kind: window; title: "Tohru Settings"; app_id: "dev.tohru.Settings"; size: 800, 800; keyboard: exclusive }
 permissions { services: "say:tohru" }
 include "state.plm"
 include "../wallpaper/picker-state.plm"
 text settings_error = ""
 include "window.plm"
 on change settings_open while not settings_open { quit }
}
