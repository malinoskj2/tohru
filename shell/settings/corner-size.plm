part CornerSizePreferences {
    group {
        show: settings_appearance_page
        text "Corner size (logical pixels, 1–100)" { at: 244, 454; size: 12; family: "SF Pro Text"; color: ink_sub0 }
        input settings_corner_size_edit { at: 244, 480; width: 160; size: 13; family: "SF Pro Text"; color: ink_text; placeholder: "32"; label: "Corner size in logical pixels" }
        text "Press Enter to apply." { at: 244, 514; size: 11; family: "SF Pro Text"; color: ink_sub0 }
        text settings_corner_size_notice { at: 244, 534; width: settings_width - 28; lines: 2; size: 11; family: "SF Pro Text"; color: ink_sub0 }
    }
}
