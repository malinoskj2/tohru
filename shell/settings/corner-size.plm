part CornerSizePreferences {
    group {
        show: settings_appearance_page
        text "Corner size (logical pixels, 1–100)" { at: 244, 330; size: 12; color: #a6adc8 }
        input settings_corner_size_edit { at: 244, 362; width: 160; size: 13; color: #cdd6f4; placeholder: "32"; label: "Corner size in logical pixels" }
        text "Press Enter to apply." { at: 244, 398; size: 11; color: #a6adc8 }
        text settings_corner_size_notice { at: 244, 426; width: settings_width - 28; lines: 2; size: 11; color: #a6adc8 }
    }
}
