part RailSprings {
    // The ribbon's springs for `rail_count` rails, each with a `rail_span` (0 for slots of 16 px) and a
    // `rail_base`, declared before this is included. rail.luau sets the goal and the per-switch draws.
    fact rail_palette = 0
    shader rail_shader = file "ribbon.wgsl"
    // Five palette stops for the ribbon (peach, yellow, green, lavender, mauve) per appearance.palette.
    let r0 = pick(rail_palette, 250, 245, 235, 208, 254, 255, 255, 230)
    let r1 = pick(rail_palette, 249, 238, 246, 235, 250, 224, 241, 219)
    let r2 = pick(rail_palette, 166, 166, 156, 163, 184, 158,  80, 167)
    let r3 = pick(rail_palette, 180, 183, 196, 136, 131, 122, 139, 127)
    let r4 = pick(rail_palette, 203, 198, 235, 180, 211, 187, 189, 214)
    let g0 = pick(rail_palette, 179, 169, 188, 135, 128, 158, 184, 152)
    let g1 = pick(rail_palette, 226, 212, 193, 203, 189, 175, 250, 188)
    let g2 = pick(rail_palette, 227, 218, 207, 190, 187, 206, 250, 192)
    let g3 = pick(rail_palette, 190, 189, 167, 192, 165, 162, 233, 187)
    let g4 = pick(rail_palette, 166, 160, 111, 142, 134, 154, 147, 153)
    let b0 = pick(rail_palette, 135, 127, 186, 112,  25, 100, 108, 117)
    let b1 = pick(rail_palette, 175, 159, 119, 139,  47, 104, 140, 127)
    let b2 = pick(rail_palette, 161, 149, 216, 140,  38, 106, 123, 128)
    let b3 = pick(rail_palette, 254, 248, 231, 208, 152, 247, 253, 179)
    let b4 = pick(rail_palette, 247, 246, 146, 173, 155, 247, 249, 182)
    let rail.skew[rail_count]
    let rail.bead[rail_count]
    let rail.wave[rail_count]
    let rail.pos[rail_count]
    let rail.lo[rail_count]
    let rail.red[rail_count]
    let rail.green[rail_count]
    let rail.blue[rail_count]
    repeat r in 0..rail_count {
        fact rail.slots.$r = 5
        fact rail.present.$r = false
        fact rail.goal.$r = 8
        fact rail.target.$r = 8
        fact rail.serial.$r = 0
        fact rail.land.$r = 0
        fact rail.kind.$r = 2
        fact rail.draw.$r = 1
        fact rail.gain.$r = 1
        fact rail.reach.$r = 12
        fact rail.life.$r = 0.5
        fact rail.dir.$r = 1
        fact rail.crest.$r = 0
        prop rail.x.$r = 8 ~spring(175, 13.23)
        prop rail.hh.$r = 2 ~spring(420, 16.39)
        prop rail.rd.$r = 0 ~spring(260, 17.74)
        prop rail.c.$r = 8 ~spring(70, 11)
        prop rail.amp.$r = 0 ~spring(220, 23.73)
        // First-order lags (the wash decays at 4.2/s and its centre trails the crest at 6/s),
        // as springs whose second pole is far away.
        prop rail.wash.$r = 0 ~spring(840, 204.2)
        prop rail.wc.$r = 8 ~spring(1200, 206)
        prop rail.t.$r = 9 ~0ms
        rail.skew[r] = min(1, rail.t.$r / rail.life.$r)
        follow rail.x.$r = rail.target.$r
        follow rail.hh.$r = 2 + min(3, abs(vel(rail.x.$r)) * 0.02)
        follow rail.rd.$r = min(1, abs(vel(rail.x.$r)) / 50)
        follow rail.c.$r = rail.x.$r + rail.dir.$r * (3 + rail.reach.$r * rail.skew.$r)
        // With reduced motion the clock stands still, so the swell is held flat rather than left raised.
        follow rail.amp.$r = rail.gain.$r * (min(3, abs(vel(rail.x.$r)) * 0.032) + 0.9 * (1 - rail.skew.$r) * if(rail.t.$r < rail.life.$r, 1, 0)) * (1 - motion.reduced)
        follow rail.wash.$r = max(0, -vel(rail.amp.$r)) * 1.3 * (0.4 + rail.skew.$r) / 4.2
        follow rail.wc.$r = rail.c.$r + rail.dir.$r * 4
        spin rail.t.$r by if(rail.t.$r < 3 and (rail.t.$r < rail.life.$r or abs(rail.amp.$r) > 0.02 or rail.wash.$r > 0.02), 1, 0)
        // The shader's eight inputs: the bead's rounding rides in its half-height's integer part,
        // the wave's direction in the sign of its phase.
        rail.bead[r] = clamp(rail.hh.$r, 0, 7.99) + 8 * round(clamp(rail.rd.$r, 0, 1) * 255)
        rail.wave[r] = rail.dir.$r * (1 + rail.t.$r / rail.life.$r)
        // A rail with no span takes the palette slot by slot; one with a span spreads it from its base across that span.
        rail.pos[r] = if(rail_span[r] == 0, clamp((rail.x.$r - 8) / 16, 0, rail.slots.$r - 1), clamp((rail.x.$r - rail_base[r]) / rail_span[r] * 4, 0, 4))
        rail.lo[r] = min(floor(rail.pos[r]), if(rail_span[r] == 0, rail.slots.$r - 2, 3))
        rail.red[r] = mix(pick(mod(rail.lo[r], 5), r0, r1, r2, r3, r4), pick(mod(rail.lo[r] + 1, 5), r0, r1, r2, r3, r4), rail.pos[r] - rail.lo[r]) / 255
        rail.green[r] = mix(pick(mod(rail.lo[r], 5), g0, g1, g2, g3, g4), pick(mod(rail.lo[r] + 1, 5), g0, g1, g2, g3, g4), rail.pos[r] - rail.lo[r]) / 255
        rail.blue[r] = mix(pick(mod(rail.lo[r], 5), b0, b1, b2, b3, b4), pick(mod(rail.lo[r] + 1, 5), b0, b1, b2, b3, b4), rail.pos[r] - rail.lo[r]) / 255
    }
}
