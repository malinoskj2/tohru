part BarState {
    text bar_title = ""
    text bar_icon = ""
    text bar_media = ""
    text bar_date = ""
    text bar_time = "--:--"
    text bar_error = ""
    fact bar_has_icon = false
    fact bar_playing = false
    fact bar_mooncoil = false
    fact bar_info_button = false
    fact bar_about_button = false
    event calendar_toggle ->
    event session_toggle ->
    image bar_app_icon = from bar_icon, 14, 14
    image bar_mark = file "mooncoil.svg", 15, 15
    // Root-owned measured allocation inputs; these defaults preserve private scenes.
    prop bar_title_cap = 360 ~0ms
    measure bar_media_measure
    measure bar_title_measure
    measure bar_date_measure
    measure bar_time_measure
    // j2bar's row: 22px buttons at least 24px wide, 2px apart, ending 110px from the right edge.
    let row_end = screen.width - 110
    let date_w = round(bar_date_measure.width)
    let clock_w = date_w + 10 + round(bar_time_measure.width) + 14
    let clock_x = row_end - clock_w
}
