part BarContents {
    // Workspace geometry is reserved for the exact motion slice; never a generic spring.
    zone box bar_mark_hit { from: 107, 4.5; size: 24, 22; active: bar_mooncoil; cursor: pointer }
    image bar_mark { at: 111, 8; size: 15, 15; opacity: 30%; show: bar_mooncoil }
    on press bar_mark_hit { emit session_toggle }

    let bar_title_limit = clamp(bar_title_cap, 0, 360)
    let bar_title_icon = bar_has_icon and bar_title_limit >= 21
    let bar_title_lead = if(bar_title_icon, 20, 0)
    let bar_title_width = min(bar_title_limit, bar_title_measure.width + bar_title_lead)
    group {
        move: (screen.width - bar_title_width) / 2, 0
        show: bar_title_limit > 0
        image bar_app_icon { at: 0, 8.5; size: 14, 14; show: bar_title_icon }
        text bar_title { at: bar_title_lead, 14.5; anchor: left center; width: max(1, bar_title_limit - bar_title_lead); lines: 1; tight: true; size: 13; weight: 500; family: "SF Pro Text"; color: #ffffff; opacity: 92%; measure: bar_title_measure }
    }
    zone box bar_clock_hit { from: clock_x, 4.5; size: clock_w, 22; corner: 7; cursor: pointer }
    box { from: clock_x, 4.5; size: clock_w, 22; corner: 7; color: #ffffff; opacity: max(bar_clock_hit.hover * 10%, bar_clock_hit.pressed * 16%) }
    text bar_date { at: clock_x + 7, 14.5; anchor: left center; size: 13; weight: 500; family: "SF Pro Text"; color: #ffffff; opacity: 92%; measure: bar_date_measure }
    text bar_time { at: clock_x + 17 + bar_date_measure.width, 14.5; anchor: left center; size: 13; weight: 500; family: "SF Pro Text"; color: #ffffff; opacity: 92%; measure: bar_time_measure }
    on press bar_clock_hit { emit calendar_toggle }
}
