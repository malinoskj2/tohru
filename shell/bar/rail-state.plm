part RailState {
    // Rail 0 is the workspace switcher, rail 1 the calendar's months. bar/rail.luau sets the
    // goal and the per-switch draws; everything that moves is a spring here.
    shader rail_shader = file "ribbon.wgsl"
    let rail.skew[2]
    let rail.bead[2]
    let rail.wave[2]
    let rail.pos[2]
    let rail.lo[2]
    let rail.red[2]
    let rail.green[2]
    let rail.blue[2]
    repeat r in 0..2 {
        fact rail.slots.$r = 5
        fact rail.present.$r = false
        fact rail.goal.$r = 8
        fact rail.target.$r = 8
        fact rail.serial.$r = 0
        fact rail.land.$r = 0
        fact rail.kind.$r = 2
        fact rail.draw.$r = 1
        fact rail.gain.$r = 1
        fact rail.reach.$r = 12
        fact rail.life.$r = 0.5
        fact rail.dir.$r = 1
        prop rail.x.$r = 8 ~spring(175, 13.23)
        prop rail.hh.$r = 2 ~spring(420, 16.39)
        prop rail.rd.$r = 0 ~spring(260, 17.74)
        prop rail.c.$r = 8 ~spring(70, 11)
        prop rail.amp.$r = 0 ~spring(220, 23.73)
        // First-order lags (the wash decays at 4.2/s and its centre trails the crest at 6/s),
        // as springs whose second pole is far away.
        prop rail.wash.$r = 0 ~spring(840, 204.2)
        prop rail.wc.$r = 8 ~spring(1200, 206)
        prop rail.t.$r = 9 ~0ms
        rail.skew[r] = min(1, rail.t.$r / rail.life.$r)
        follow rail.x.$r = rail.target.$r
        follow rail.hh.$r = 2 + min(3, abs(vel(rail.x.$r)) * 0.02)
        follow rail.rd.$r = min(1, abs(vel(rail.x.$r)) / 50)
        follow rail.c.$r = rail.x.$r + rail.dir.$r * (3 + rail.reach.$r * rail.skew.$r)
        // With reduced motion the clock stands still, so the swell is held flat rather than left raised.
        follow rail.amp.$r = rail.gain.$r * (min(3, abs(vel(rail.x.$r)) * 0.032) + 0.9 * (1 - rail.skew.$r) * if(rail.t.$r < rail.life.$r, 1, 0)) * (1 - motion.reduced)
        follow rail.wash.$r = max(0, -vel(rail.amp.$r)) * 1.3 * (0.4 + rail.skew.$r) / 4.2
        follow rail.wc.$r = rail.c.$r + rail.dir.$r * 4
        spin rail.t.$r by if(rail.t.$r < 3 and (rail.t.$r < rail.life.$r or abs(rail.amp.$r) > 0.02 or rail.wash.$r > 0.02), 1, 0)
        on change rail.serial.$r {
            rail.target.$r = rail.goal.$r
            rail.dir.$r = if(rail.goal.$r > rail.x.$r, 1, -1)
            rail.gain.$r = rail.draw.$r * min(1.3, 0.7 + abs(rail.goal.$r - rail.x.$r) / 40)
            rail.c.$r: rail.x.$r - rail.dir.$r * 5 ~0ms
            rail.wc.$r: rail.x.$r ~0ms
            rail.t.$r: 0 ~0ms
        }
        // j2bar draws stiffness 140-210 and damping ratio 0.4-0.6 per switch.
        on change rail.serial.$r while rail.kind.$r == 0 { rail.x.$r: rail.goal.$r ~spring(145, 10.84) }
        on change rail.serial.$r while rail.kind.$r == 1 { rail.x.$r: rail.goal.$r ~spring(160, 13.91) }
        on change rail.serial.$r while rail.kind.$r == 2 { rail.x.$r: rail.goal.$r ~spring(175, 13.23) }
        on change rail.serial.$r while rail.kind.$r == 3 { rail.x.$r: rail.goal.$r ~spring(190, 11.58) }
        on change rail.serial.$r while rail.kind.$r == 4 { rail.x.$r: rail.goal.$r ~spring(205, 16.61) }
        on change rail.land.$r {
            rail.target.$r = rail.goal.$r
            rail.x.$r: rail.goal.$r ~0ms
            rail.hh.$r: 2 ~0ms
            rail.rd.$r: 0 ~0ms
            rail.amp.$r: 0 ~0ms
            rail.wash.$r: 0 ~0ms
            rail.t.$r: 9 ~0ms
        }
        // The shader's eight inputs: the bead's rounding rides in its half-height's integer part,
        // the wave's direction in the sign of its phase.
        rail.bead[r] = clamp(rail.hh.$r, 0, 7.99) + 8 * round(clamp(rail.rd.$r, 0, 1) * 255)
        rail.wave[r] = rail.dir.$r * (1 + rail.t.$r / rail.life.$r)
        // Workspaces take the palette slot by slot; the months spread it across the whole rail.
        rail.pos[r] = if(r == 0, clamp((rail.x.$r - 8) / 16, 0, rail.slots.$r - 1), clamp(rail.x.$r / 192 * 4, 0, 4))
        rail.lo[r] = min(floor(rail.pos[r]), if(r == 0, rail.slots.$r - 2, 3))
        rail.red[r] = mix(pick(mod(rail.lo[r], 5), 250, 249, 166, 180, 203), pick(mod(rail.lo[r] + 1, 5), 250, 249, 166, 180, 203), rail.pos[r] - rail.lo[r]) / 255
        rail.green[r] = mix(pick(mod(rail.lo[r], 5), 179, 226, 227, 190, 166), pick(mod(rail.lo[r] + 1, 5), 179, 226, 227, 190, 166), rail.pos[r] - rail.lo[r]) / 255
        rail.blue[r] = mix(pick(mod(rail.lo[r], 5), 135, 175, 161, 254, 247), pick(mod(rail.lo[r] + 1, 5), 135, 175, 161, 254, 247), rail.pos[r] - rail.lo[r]) / 255
    }
    let ws_width = rail.slots.0 * 16
    text ws_error = ""
    text bar_outputs = ""
    repeat i in 1..11 { fact ws_advertised.$i = false }
    fact ws_available = false
    event workspace_select ->
}
