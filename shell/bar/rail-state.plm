part RailState {
    // Rail 0 is the workspace switcher, rail 1 the calendar's months, rail 2 the sound popup's master volume,
    // rail 3 the information popup's seven pages, rail 4 the Bluetooth popup's Off / On / Scan, rail 5 the media popup's progress,
    // rails 6 and 7 the wallpaper popup's monitor tabs and playback, rail 8 the network popup's Wi-Fi power.
    let rail_count = 9
    let rail_span[9]
    let rail_base[9]
    rail_span[0] = 0
    rail_span[1] = 252
    rail_span[2] = 194
    rail_span[3] = 96
    rail_span[4] = 172
    rail_span[5] = 204
    rail_span[6] = 312
    rail_span[7] = 210
    rail_span[8] = 80
    rail_base[0] = 0
    rail_base[1] = 0
    rail_base[2] = 0
    rail_base[3] = 8
    rail_base[4] = 0
    rail_base[5] = 0
    rail_base[6] = 0
    rail_base[7] = 0
    rail_base[8] = 8
    include "rail-springs.plm"
    include "rail-rules.plm"
    let ws_width = rail.slots.0 * 16
    text ws_error = ""
    text bar_outputs = ""
    repeat i in 1..11 { fact ws_advertised.$i = false }
    fact ws_available = false
    event workspace_select ->
}
