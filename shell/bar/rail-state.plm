part WorkspaceRailState {
    shader ws_shader = file "ribbon.wgsl"
    fact ws_width = 80
    fact ws_present = false
    fact ws_moving = false
    fact ws_r = 0.98
    fact ws_g = 0.702
    fact ws_b = 0.529
    text ws_error = ""
    text bar_outputs = ""
    repeat i in 0..16 { fact ws_v.$i = 0 }
    repeat i in 1..11 { fact ws_advertised.$i = false }
    fact ws_available = false
    event workspace_select ->
}
