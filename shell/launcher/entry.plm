scene TohruLauncher {
    // Empty-input1px native bootstrap supplies names; it never matches recession.
    surface { size: 1, 1; anchor: top_left; screens: each max 8; reserve: 0; keyboard: none; open: false }
    permissions { services: "apps", "apps.launch", "files", "files.write", "window", "say:tohru" }
    // The sidebar's ribbon is the workspace switcher's, as rail 0: a 32 px slot per tab, the palette spread
    // from the first tab's bead to the last's.
    let rail_count = 1
    let rail_span[1]
    let rail_base[1]
    rail_span[0] = 192
    rail_base[0] = 16
    include "../bar/rail-springs.plm"
    shader launcher_water = file "../water.wgsl"
    shader launcher_tile = file "tile.wgsl"
    shader launcher_reveal = file "reveal.wgsl"
    fact launcher_visible = false
    fact launcher_bar_state = 0
    fact launcher_focus_armed = false
    fact launcher_closing = false
    fact launcher_close_token = 0
    fact launcher_output_count = 0
    fact launcher_outputs_known = false
    text launcher_outputs = ""
    text launcher_backdrop_outputs = ""
    text launcher_focused_output = ""
    fact launcher_searching = false
    fact launcher_typed = false
    text launcher_query = ""
    text launcher_message = ""
    text launcher_hint = ""
    text launcher_heading = "Applications"
    text launcher_count = "00"
    text launcher_count_label = ""
    repeat i in 0..7 { fact launcher_tab_count.$i = 0 }
    fact launcher_tab = 0
    fact launcher_selected = -1
    fact launcher_selected_x = 0
    fact launcher_selected_y = 0
    fact launcher_pointer = false
    fact launcher_hovered = -1
    fact launcher_total = 0
    fact launcher_pins = 0
    fact launcher_pin_rows = 0
    fact launcher_menu = false
    fact launcher_scroll = 0
    fact launcher_content = 0
    fact launcher_menu_height = 42
    fact launcher_menu_selected = -1
    fact launcher_menu_offset = 0
    fact launcher_menu_x = 0
    fact launcher_menu_y = 0
    // Above 0 it stands in for the deck's light clock, so a capture can be matched deterministically.
    fact launcher_clock = 0
    text launcher_error = ""
    measure launcher_query_measure
    model launcher_tiles max 96 { position: number; x: number; y: number; name: text; id: text; icon: image 96, 96; iconless: bool; pinned: bool }
    image launcher_app_window = file "../service-assets/app-window.svg", 27, 27
    model launcher_choices max 14 { position: number; y: number; label: text; action: number }
    event launcher_unmap ->
    event launcher_outputs_changed ->
    event launcher_toggle ->
    event launcher_open ->
    event launcher_close ->
    event launcher_tab ->
    event launcher_layout ->
    event launcher_viewport ->
    event launcher_scroll ->
    event launcher_select ->
    event launcher_move ->
    event launcher_vertical ->
    event launcher_page ->
    event launcher_launch ->
    event launcher_context ->
    event launcher_choice ->
    event launcher_menu_close ->
    event launcher_menu_scroll ->
    event launcher_menu_move ->
    event launcher_escape ->
    event launcher_report ->
    event launcher_mapped ->
    event launcher_palette ->
    prop launcher_seen = 0 ~spring(170, 13.04)
    follow launcher_seen = if(launcher_visible, 1, 0)
    // What the Hyprland plugin recedes the windows for: an empty layer, gone the moment the launcher
    // starts closing, so the windows spring back while the deck sinks.
    surface launcher_backdrop {
        size: full, full
        anchor: top
        level: overlay
        reserve: -1
        screens: launcher_backdrop_outputs
        layer_namespace: "tohru-launcher-backdrop"
        keyboard: none
        open: launcher_visible
    }
    surface launcher_layer {
        size: full, full
        anchor: top
        level: overlay
        reserve: -1
        screens: launcher_outputs
        keyboard: exclusive while launcher_visible
        open: launcher_visible or launcher_seen != 0 or vel(launcher_seen) != 0
        bright: panel_bright
        include "../panel-ink.plm"
        include "../bar/rail-rules.plm"
        // The deck: a 176 px frosted sidebar beside a clearer stage of 3 to 7 columns of 80 px tiles.
        let cols = clamp(floor((launcher_layer.width - 264) / 80), 3, 7)
        let view_height = clamp(launcher_layer.height - 260, 164, 440)
        let side_w = 176
        let card_width = side_w + cols * 80 + 40
        let card_height = view_height + 84
        let card_x = round((launcher_layer.width - card_width) / 2)
        let card_y = round((launcher_layer.height + 21 - card_height) / 2)
        let card_cx = card_x + card_width / 2
        let card_cy = card_y + card_height / 2
        let stage_x = card_x + side_w
        let field_x = stage_x + 20
        let field_y = card_y + 18
        let field_w = cols * 80
        let view_x = stage_x + 20
        let view_y = card_y + 68
        let bead = rgb(rail.red.0, rail.green.0, rail.blue.0)
        // Out of a 12 px blur, under one ripple that dies as it settles.
        let revealing = abs(launcher_seen - 1) > 0.0005 or abs(vel(launcher_seen)) > 0.001
        let reveal_blur = if(revealing, (1 - clamp(launcher_seen, 0, 1)) * 12, 0)
        let ripple_map = max(1, (0.15 + 0.8 * smooth(0, 1, clamp(launcher_seen, 0, 1))) * max(card_width, card_height) * 0.6 / 0.72)
        let ripple_strength = if(revealing, (1 - smooth(0.75, 1.05, launcher_seen)) * 14 + min(5, abs(vel(launcher_seen)) * 2), 0)
        // What the pointer lights fades when the keyboard takes over, until the pointer moves again.
        prop pointer_lit = 0 ~140ms
        follow pointer_lit = if(launcher_pointer, 1, 0)
        prop tile_scroll = 0 ~250ms
        follow tile_scroll = launcher_scroll
        // The sidebar's frost settles first, over 180 ms; the stage clears behind it.
        prop side_settle = 1 ~180ms
        prop stage_settle = 1 ~320ms
        on change launcher_visible while launcher_visible { side_settle: 0 ~0ms; stage_settle: 0 ~0ms; side_settle: 1 ~180ms after 1ms; stage_settle: 1 ~320ms after 140ms }
        on launcher_open { focus launcher_query; emit launcher_layout(cols); emit launcher_viewport(view_height) }
        on launcher_toggle { focus launcher_query; emit launcher_layout(cols); emit launcher_viewport(view_height) }
        on change launcher_menu while launcher_menu { blur }
        on change launcher_menu while not launcher_menu { focus launcher_query }
        on change cols { emit launcher_layout(cols) }
        on change launcher_seen > 0.02 while launcher_visible and launcher_seen > 0.02 { emit launcher_mapped }
        on change view_height { emit launcher_viewport(view_height) }
        // The opening's clock, a critically damped spring at 1 - (1 + 3t)·e^(-3t): each icon surges
        // once as the reveal reaches it, 0.2 s plus 1 s per 1500 px from the deck's centre.
        prop reveal_clock = 1 ~spring(9, 6)
        on change launcher_visible while launcher_visible { reveal_clock: 0 ~0ms; reveal_clock: 1 ~spring(9, 6) after 1ms }
        box { from: 0, 0; size: launcher_layer.width, launcher_layer.height; color: #0e0816; opacity: (14% - 8% * pk) * clamp(launcher_seen, 0, 1) * if(launcher_visible, 1, 0) }
        group {
            pivot: card_cx, card_cy
            scale: 0.94 + 0.06 * launcher_seen
            move: 0, (1 - launcher_seen) * 12
            opacity: smooth(0, 0.55, launcher_seen)
            // Two densities of the panels' glass: the sidebar frosted thick, the stage clearer.
            body {
                color: ink_glass; glass: 100%; frost: 55% + 45% * side_settle; tint: 50% + 24% * side_settle; vivid: 135%; refraction: 0%; dispersion: 0%; mirror: 0%; highlight: 0%; ripple: 0%
                shadow: 0, 18, 44, 30% - 14% * pk
                box { from: card_x, card_y; size: side_w, card_height; corner: 20 }
                box { from: card_x + 20, card_y; size: side_w - 20, card_height }
            }
            body {
                color: ink_glass; glass: 100%; frost: 100% - 50% * stage_settle; tint: 74% - 30% * stage_settle; vivid: 135%; refraction: 0%; dispersion: 0%; mirror: 0%; highlight: 0%; ripple: 0%
                shadow: 0, 18, 44, 30% - 14% * pk
                box { from: stage_x, card_y; size: card_width - side_w, card_height; corner: 20 }
                box { from: stage_x, card_y; size: card_width - side_w - 20, card_height }
            }
            // The network popup's drifting palette light over both, at twice its size, gathering as the deck settles.
            group {
                pivot: card_x, card_y
                scale: 2
                show: launcher_visible or launcher_seen > 0.002
                shader launcher_water { at: card_x, card_y; size: card_width / 2, card_height / 2; corner: 10; values: 1, card_height + 400, 1, card_width / 2, 0, pk, 0, launcher_clock; opacity: 0.4 + 0.6 * stage_settle }
            }
            box { from: card_x + 0.5, card_y + 0.5; size: card_width - 1, card_height - 1; corner: 19.5; stroke: 1; color: ink_white; opacity: 0.6 * (26% - 10% * pk) }
            box { from: stage_x - 0.375, card_y + 14; size: 0.75, card_height - 28; color: ink_white; opacity: 12% - 2% * pk }
            zone box launcher_card { active: launcher_visible; from: card_x, card_y; size: card_width, card_height }
            group {
                shader: launcher_reveal, reveal_blur, ripple_map, ripple_strength, card_cx, card_cy while revealing
                // The tabs, on the vertical ribbon.
                repeat i in 0..7 {
                    group {
                        let tab_y = card_y + 20 + i * 32
                        prop hover = 0 ~140ms
                        prop ink = 0.5 ~350ms
                        follow ink = if(launcher_searching, 0.32, if(launcher_tab == i, 0.96, 0.5))
                        prop lit = 0 ~200ms
                        follow lit = if(launcher_tab == i and not launcher_searching, 1, 0)
                        zone box launcher_tab_hit.$i { from: card_x + 36, tab_y; size: 124, 30; corner: 8; active: launcher_visible; cursor: pointer; label: pick(i, "Home", "Create", "Code", "Media", "Web", "Office", "System"); role: tab; selected: launcher_tab == i }
                        box { from: card_x + 36, tab_y; size: 124, 30; corner: 8; color: ink_white; opacity: max((8% - 2% * pk) * lit, 5% * hover * pointer_lit) }
                        text pick(i, "Home", "Create", "Code", "Media", "Web", "Office", "System") { at: card_x + 46, tab_y + 15; anchor: left center; size: 13; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: ink }
                        text "{launcher_tab_count.$i}" { at: card_x + 150, tab_y + 15; anchor: right center; size: 11; weight: 500; family: "SF Pro Text:tnum"; color: ink_white; opacity: 0.45 * ink }
                        on enter launcher_tab_hit.$i { hover: 1 ~140ms; launcher_pointer = true }
                        on leave launcher_tab_hit.$i { hover: 0 ~140ms }
                        on press launcher_tab_hit.$i { emit launcher_tab(i) }
                    }
                }
                // The ribbon turned upright: its x runs down the tabs from 19 px below the deck's top.
                group {
                    pivot: card_x + 25, card_y + 19
                    rotate: 90deg
                    box { from: card_x + 25, card_y + 18; size: 224, 2; corner: 1; color: ink_white; opacity: pk * 22% }
                    shader rail_shader { at: card_x + 13, card_y - 2; size: 248, 42; values: rail.x.0, vel(rail.x.0), rail.bead.0, rail.c.0, rail.amp.0, rail.wash.0, rail.wc.0, rail.wave.0; colors: mix(bead, #1c1826, 0.35 * pk), ink_white; opacity: if(launcher_searching, 38%, 100%) }
                }
                // The count, large and thin, at the sidebar's foot.
                group {
                    show: card_height >= 330
                    text launcher_count { at: card_x + 26, card_y + card_height - 38; anchor: left bottom; size: 62; weight: 200; family: "SF Pro Text:tnum"; color: ink_white; opacity: 88%; letter_move: -2.2 * letter, 0 }
                    text launcher_count_label { at: card_x + 28, card_y + card_height - 25; anchor: left center; size: 11.5; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 52% }
                }
                // The search field.
                box { from: field_x, field_y; size: field_w, 40; corner: 11; color: ink_white; opacity: 6% - 1.5% * pk }
                box { from: field_x + 0.5, field_y + 0.5; size: field_w - 1, 39; corner: 10.5; stroke: 1; color: ink_white; opacity: 7% - 1% * pk }
                ellipse { at: field_x + 18.2, field_y + 19.2; radius: 4.2; stroke: 1.3; color: ink_white; opacity: 50% }
                line { from: field_x + 21.4, field_y + 22.4; to: field_x + 24.4, field_y + 25.4; width: 1.3; color: ink_white; opacity: 50% }
                text "Search applications…" { at: field_x + 35, field_y + 20; anchor: left center; size: 15; family: "SF Pro Text"; color: ink_white; opacity: 42%; show: not launcher_typed }
                text launcher_query { at: field_x + 35, field_y + 20; anchor: left center; width: field_w - 95; lines: 1; tight: true; size: 15; family: "SF Pro Text"; color: ink_white; opacity: 94%; measure: launcher_query_measure }
                box { from: round(field_x + 36 + min(launcher_query_measure.width, field_w - 95)), round(field_y + 12); size: 1.5, 16; color: mix(bead, #1c1826, 0.35 * pk); opacity: 90%; show: launcher_visible and launcher_typed }
                text "Tab ↕" { at: field_x + field_w - 12, field_y + 20; anchor: right center; size: 11; family: "SF Pro Text"; color: ink_white; opacity: 42%; show: not launcher_typed }
                group {
                    show: launcher_typed
                    zone box launcher_clear { from: field_x + field_w - 52, field_y + 8; size: 44, 24; corner: 7; active: launcher_visible and launcher_typed; cursor: pointer; label: "Clear the search" }
                    box { from: field_x + field_w - 52, field_y + 8; size: 44, 24; corner: 7; color: ink_white; opacity: max(launcher_clear.hover * 10% * pointer_lit, launcher_clear.pressed * 16%) }
                    text "× Esc" { at: field_x + field_w - 12, field_y + 20; anchor: right center; size: 11; family: "SF Pro Text"; color: ink_white; opacity: 42% + 30% * launcher_clear.hover }
                    on enter launcher_clear { launcher_pointer = true }
                }
                text launcher_error { at: field_x + field_w - 6, view_y + 13; anchor: right center; width: field_w - 160; lines: 1; align: right; size: 11; weight: 500; family: "SF Pro Text"; color: ink_red }
                group {
                    clip box { from: stage_x, view_y; size: card_width - side_w, view_height }
                    text launcher_heading { at: view_x + 6, view_y + 13 - tile_scroll; anchor: left center; size: 11; weight: 500; family: "SF Pro Text:tnum"; color: ink_white; opacity: 48%; show: launcher_total > 0 }
                    text "Applications" { at: view_x + 6, view_y + 39 + launcher_pin_rows * 82 - tile_scroll; anchor: left center; size: 11; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 48%; show: launcher_tab == 0 and launcher_pins > 0 and not launcher_searching and launcher_total > launcher_pins }
                    box { from: card_x + card_width - 10, view_y + tile_scroll / max(1, launcher_content - view_height) * (view_height - view_height * view_height / max(1, launcher_content)); size: 3, view_height * view_height / max(1, launcher_content); corner: 1.5; color: ink_white; opacity: 18%; show: launcher_content > view_height }
                }
                text launcher_message { at: view_x + field_w / 2, view_y + view_height / 2 - 10; anchor: center; align: center; width: field_w - 32; lines: 1; size: 14; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 80% }
                text launcher_hint { at: view_x + field_w / 2, view_y + view_height / 2 + 12; anchor: center; align: center; width: field_w - 32; lines: 1; size: 12; family: "SF Pro Text"; color: ink_white; opacity: 46% }
            }
            // The selected tile's plate and the mark under it slide from tile to tile.
            prop plate_x = 0 ~spring(260, 26)
            prop plate_y = 0 ~spring(260, 26)
            follow plate_x = launcher_selected_x
            follow plate_y = launcher_selected_y
            on change launcher_visible while launcher_visible { plate_x: launcher_selected_x ~0ms; plate_y: launcher_selected_y ~0ms }
            prop plate_shown = 0 ~160ms
            follow plate_shown = if(launcher_selected >= 0 and launcher_total > 0, 1, 0)
            on change launcher_selected >= 0 while launcher_selected >= 0 and plate_shown < 0.05 { plate_x: launcher_selected_x ~0ms; plate_y: launcher_selected_y ~0ms }
            group {
                clip box { from: stage_x, view_y; size: card_width - side_w, view_height }
                show: plate_shown > 0.001
                opacity: plate_shown
                box { from: view_x + plate_x, view_y + plate_y - tile_scroll; size: 80, 78; corner: 13; color: ink_white; opacity: 10% - 3% * pk }
                box { from: view_x + plate_x + 0.375, view_y + plate_y - tile_scroll + 0.375; size: 79.25, 77.25; corner: 12.6; stroke: 0.75; color: ink_white; opacity: 22% - 5% * pk }
                group {
                    glow: 9, 35%, ink_white
                    box { from: view_x + plate_x + 38, view_y + plate_y - tile_scroll + 70; size: 4, 4; corner: 2; color: ink_white }
                }
                group {
                    glow: 3.5, 45%, ink_white
                    box { from: view_x + plate_x + 38, view_y + plate_y - tile_scroll + 70; size: 4, 4; corner: 2; color: ink_white }
                }
            }
            group {
                clip box { from: stage_x, view_y; size: card_width - side_w, view_height }
                for t in launcher_tiles {
                    group {
                        let k = t.index
                        move: view_x + t.x, view_y + t.y - tile_scroll
                        box launcher_tile.$k { from: 0, 0; size: 80, 78; color: #ffffff; opacity: 0%; active: launcher_visible; cursor: pointer; label: t.name }
                        // LiquidWarp: under the pointer, or the keyboard while the pointer is not on the launcher.
                        let held = if(launcher_pointer, launcher_hovered == t.position, launcher_selected == t.position)
                        let reach = 0.2 + length(view_x + 40 + t.x - card_cx, view_y + 30 + t.y - tile_scroll - card_cy) / 1500
                        let surging = held or (launcher_visible and reveal_clock > 1 - (1 + 3 * reach) * exp(-3 * reach) and reveal_clock < 1 - (1 + 3 * reach + 0.45) * exp(-3 * reach - 0.45))
                        prop surge = 0 ~spring(170, 13.04)
                        follow surge = if(surging, 0.6, 0)
                        on change surging while surging { impulse surge 20 }
                        on change surging while not surging { impulse surge -9 }
                        group {
                            glow: 22, 0
                            shader: launcher_tile, surge, vel(surge), 1, card_cx, reveal_blur, ripple_map, ripple_strength, card_cy while revealing or abs(surge) > 0.002 or abs(vel(surge)) > 0.02
                            image t.icon { at: 20, 10; size: 40, 40 }
                            image launcher_app_window { at: 27.5, 17.5; size: 25, 25; tint: ink_white; opacity: 62%; show: t.iconless }
                        }
                        text t.name { at: 40, 61.5; anchor: center; align: center; width: 72; lines: 1; size: 11; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 88% }
                        on enter launcher_tile.$k while not launcher_menu { launcher_pointer = true; launcher_hovered = t.position; emit launcher_select(t.position) }
                        on leave launcher_tile.$k while launcher_hovered == t.position { launcher_hovered = -1 }
                        on press launcher_tile.$k while not launcher_menu { emit launcher_launch(t.position) }
                        on press launcher_tile.$k while launcher_menu { emit launcher_menu_close }
                        on press right launcher_tile.$k { launcher_menu_x = pointer.x; launcher_menu_y = pointer.y; emit launcher_context(t.position) }
                    }
                }
            }
            on press launcher_card while launcher_menu { emit launcher_menu_close }
            on scroll launcher_card while not launcher_menu { emit launcher_scroll(wheel) }
            group {
                show: launcher_menu
                let menu_x = round(clamp(launcher_menu_x, 8, launcher_layer.width - 228))
                let menu_y = round(clamp(launcher_menu_y, 8, launcher_layer.height - launcher_menu_height - 8))
                body {
                    color: ink_glass; glass: 100%; frost: 100%; tint: 70%; vivid: 135%; refraction: 0%; dispersion: 0%; mirror: 0%; highlight: 0%; ripple: 0%
                    shadow: 0, 6, 18, 28% - 10% * pk
                    box { from: menu_x, menu_y; size: 220, launcher_menu_height; corner: 13 }
                }
                box { from: menu_x + 0.5, menu_y + 0.5; size: 219, launcher_menu_height - 1; corner: 12.5; stroke: 1; color: ink_white; opacity: 0.6 * (26% - 10% * pk) }
                zone box launcher_menu_area { from: menu_x, menu_y; size: 220, launcher_menu_height }
                on scroll launcher_menu_area { emit launcher_menu_scroll(wheel) }
                // The plate under the row the pointer or the keyboard is on.
                prop pill_y = 0 ~spring(260, 26)
                follow pill_y = 6 + launcher_menu_selected * 30 - launcher_menu_offset
                on change launcher_menu_selected >= 0 while launcher_menu_selected >= 0 { pill_y: 6 + launcher_menu_selected * 30 - launcher_menu_offset ~0ms }
                prop pill_shown = 0 ~160ms
                follow pill_shown = if(launcher_menu_selected >= 0, 1, 0)
                group {
                    clip box { from: menu_x + 6, menu_y + 6; size: 208, launcher_menu_height - 12 }
                    box { from: menu_x + 6, menu_y + pill_y; size: 208, 30; corner: 8; color: ink_white; opacity: (10% - 3% * pk) * pill_shown }
                    for c in launcher_choices {
                        let k = c.index
                        zone box launcher_choice_hit.$k { from: menu_x + 6, menu_y + 6 + c.y; size: 208, 30; active: launcher_visible; cursor: pointer; label: c.label }
                        text c.label { at: menu_x + 18, menu_y + 21 + c.y; anchor: left center; width: 186; lines: 1; size: 13; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 92% }
                        on enter launcher_choice_hit.$k { launcher_menu_selected = c.position }
                        on leave launcher_choice_hit.$k while launcher_menu_selected == c.position { launcher_menu_selected = -1 }
                        on press launcher_choice_hit.$k { emit launcher_choice(c.position) }
                    }
                }
            }
            input launcher_query { show: launcher_visible; at: field_x + 35, field_y + 10; width: field_w - 95; size: 15; family: "SF Pro Text"; color: ink_white; opacity: 0 }
            on press launcher_clear { launcher_query = ""; focus launcher_query }
            on submit launcher_query while not launcher_menu { emit launcher_launch(max(0, launcher_selected)) }
        }
        on key Escape { emit launcher_escape }
        on key Left while not launcher_menu { emit launcher_move(-1) }
        on key Right while not launcher_menu { emit launcher_move(1) }
        on key Up while not launcher_menu { emit launcher_vertical(-1) }
        on key Down while not launcher_menu { emit launcher_vertical(1) }
        on key Return while not launcher_menu { emit launcher_launch(max(0, launcher_selected)) }
        on key Up while launcher_menu { emit launcher_menu_move(-1) }
        on key Down while launcher_menu { emit launcher_menu_move(1) }
        on key Return while launcher_menu { emit launcher_choice(max(0, launcher_menu_selected)) }
        on key Next while not launcher_menu { emit launcher_page(1) }
        on key Prior while not launcher_menu { emit launcher_page(-1) }
        on key Menu while not launcher_menu { launcher_menu_x = view_x + 40 + launcher_selected_x; launcher_menu_y = view_y + 60 + launcher_selected_y - launcher_scroll; emit launcher_context(max(0, launcher_selected)) }
        on key Shift+F10 while not launcher_menu { launcher_menu_x = view_x + 40 + launcher_selected_x; launcher_menu_y = view_y + 60 + launcher_selected_y - launcher_scroll; emit launcher_context(max(0, launcher_selected)) }
        on key Tab { emit launcher_tab(launcher_tab + 1) }
        on key Shift+Tab { emit launcher_tab(launcher_tab - 1) }
        on key Shift+ISO_Left_Tab { emit launcher_tab(launcher_tab - 1) }
        on key ISO_Left_Tab { emit launcher_tab(launcher_tab - 1) }
        on key KP_Up while not launcher_menu { emit launcher_vertical(-1) }
        on key KP_Down while not launcher_menu { emit launcher_vertical(1) }
        on key KP_Left while not launcher_menu { emit launcher_move(-1) }
        on key KP_Right while not launcher_menu { emit launcher_move(1) }
        on key KP_Next while not launcher_menu { emit launcher_page(1) }
        on key KP_Prior while not launcher_menu { emit launcher_page(-1) }
        // Separate timer condition and firing guard: keep one native appointment
        // through final spring snap, then remove the role on the next check.
        every 16.666667ms while launcher_closing while launcher_seen == 0 and vel(launcher_seen) == 0 {
            emit launcher_unmap(launcher_close_token)
        }
    }
    on change screens.count { launcher_output_count = screens.count; launcher_outputs_known = true; emit launcher_outputs_changed }
}
