scene TohruLauncher {
    surface { size: full, full; anchor: top; level: overlay; keyboard: exclusive while launcher_visible; open: launcher_visible }
    permissions { services: "apps", "apps.launch", "files", "files.write" }
    fact launcher_visible = false
    fact launcher_tab = 0
    fact launcher_selected = 0
    fact launcher_total = 0
    fact launcher_pins = 0
    fact launcher_pin_rows = 0
    fact launcher_menu = false
    fact launcher_scroll = 0
    fact launcher_content = 0
    fact launcher_menu_height = 42
    fact launcher_menu_selected = 0
    fact launcher_menu_x = 0
    fact launcher_menu_y = 0
    text launcher_error = ""
    model launcher_tiles max 96 { position: number; x: number; y: number; name: text; id: text; icon: image 96, 96; pinned: bool }
    model launcher_choices max 14 { position: number; y: number; label: text; action: number }
    event launcher_toggle ->
    event launcher_open ->
    event launcher_close ->
    event launcher_tab ->
    event launcher_layout ->
    event launcher_viewport ->
    event launcher_scroll ->
    event launcher_select ->
    event launcher_move ->
    event launcher_launch ->
    event launcher_context ->
    event launcher_choice ->
    event launcher_menu_close ->
    event launcher_menu_scroll ->
    event launcher_menu_move ->
    let cols = clamp(floor((screen.width - 94) / 72), 3, 8)
    let view_height = clamp(screen.height - 230, 72, 452)
    let card_width = cols * 72 + 32
    let card_height = view_height + 104
    let card_x = floor((screen.width - card_width) / 2)
    let card_y = floor((screen.height + 37 - card_height) / 2)
    prop tile_scroll = 0 ~120ms
    follow tile_scroll = launcher_scroll
    on launcher_open { emit launcher_layout(cols); emit launcher_viewport(view_height) }
    on launcher_toggle { emit launcher_layout(cols); emit launcher_viewport(view_height) }
    on change cols { emit launcher_layout(cols) }
    on change view_height { emit launcher_viewport(view_height) }
    body {
        color: #181825; rim: 4%; shadow: 0, 18, 44, 25%
        box { from: card_x, card_y; size: card_width, card_height; corner: 22 }
    }
    zone box launcher_card { from: card_x, card_y; size: card_width, card_height }
    text launcher_error { at: card_x + 22, card_y + 49; anchor: left center; width: card_width - 44; lines: 1; size: 10; color: #f38ba8 }
    text "Applications" { at: card_x + 22, card_y + 30; anchor: left center; size: 15; color: #cdd6f4 }
    repeat i in 0..7 {
        let tab_width = (card_width - 16) / 7
        box launcher_tab_hit.$i { from: card_x + 8 + i * tab_width, card_y + 62; size: tab_width - 2, 26; corner: 7; color: #89dceb; opacity: if(launcher_tab == i, 12%, 0%); cursor: pointer }
        text pick(i, "Home", "Create", "Code", "Media", "Web", "Office", "System") { at: card_x + 8 + (i + 0.5) * tab_width, card_y + 75; anchor: center; size: 13; color: #cdd6f4 }
        box { from: card_x + 8 + (i + 0.5) * tab_width - 7, card_y + 90; size: 14, 3; color: #89dceb; show: launcher_tab == i }
        on press launcher_tab_hit.$i { emit launcher_tab(i) }
    }
    group {
        clip box { from: card_x + 8, card_y + 96; size: card_width - 16, view_height }
        text "Pinned" { at: card_x + 16, card_y + 110 - tile_scroll; anchor: left center; size: 11; color: #a6adc8; show: launcher_tab == 0 and launcher_pins > 0 }
        text "Applications" { at: card_x + 16, card_y + 139 + launcher_pin_rows * 72 - tile_scroll; anchor: left center; size: 11; color: #a6adc8; show: launcher_tab == 0 and launcher_pins > 0 }
        for t in launcher_tiles {
            group {
                move: card_x + 16 + t.x, card_y + 96 + t.y - tile_scroll
                prop hover = 0 ~140ms
                box launcher_tile.$t.index { from: 0, 0; size: 72, 72; corner: 12; color: #89dceb; opacity: hover * 10% + if(launcher_selected == t.position, 8%, 0%); cursor: pointer }
                image t.icon { at: 14, 10; size: 44, 44 }
                text t.name { at: 36, 64; anchor: center; width: 68; lines: 1; size: 11; color: #cdd6f4 }
                on enter launcher_tile.$t.index { hover: 1 ~140ms; emit launcher_select(t.position) }
                on leave launcher_tile.$t.index { hover: 0 ~140ms }
                on press launcher_tile.$t.index while not launcher_menu { emit launcher_launch(t.position) }
                on press launcher_tile.$t.index while launcher_menu { emit launcher_menu_close }
                on press right launcher_tile.$t.index { launcher_menu_x = pointer.x; launcher_menu_y = pointer.y; emit launcher_context(t.position) }
            }
        }
    }
    on press launcher_card while launcher_menu { emit launcher_menu_close }
    on scroll launcher_card while not launcher_menu { emit launcher_scroll(wheel) }
    group {
        show: launcher_menu
        let menu_x = clamp(launcher_menu_x, 8, screen.width - 228)
        let menu_y = clamp(launcher_menu_y, 8, screen.height - launcher_menu_height - 8)
        body { color: #181825; rim: 4%; box { from: menu_x, menu_y; size: 220, launcher_menu_height; corner: 12 } }
        zone box launcher_menu_area { from: menu_x, menu_y; size: 220, launcher_menu_height }
        on scroll launcher_menu_area { emit launcher_menu_scroll(wheel) }
        clip box { from: menu_x + 6, menu_y + 6; size: 208, launcher_menu_height - 12 }
        for c in launcher_choices {
            box launcher_choice_hit.$c.index { from: menu_x + 6, menu_y + 6 + c.y; size: 208, 30; corner: 6; color: #89dceb; opacity: if(launcher_menu_selected == c.position, 12%, 4%); cursor: pointer }
            text c.label { at: menu_x + 16, menu_y + 21 + c.y; anchor: left center; size: 13; color: #cdd6f4 }
            on press launcher_choice_hit.$c.index { emit launcher_choice(c.position) }
        }
    }
    on key Escape while launcher_menu { emit launcher_menu_close }
    on key Escape while not launcher_menu { emit launcher_close }
    on blur { emit launcher_close }
    on key Left while not launcher_menu { emit launcher_move(-1) }
    on key Right while not launcher_menu { emit launcher_move(1) }
    on key Up while not launcher_menu { emit launcher_move(-cols) }
    on key Down while not launcher_menu { emit launcher_move(cols) }
    on key Return while not launcher_menu { emit launcher_launch(launcher_selected) }
    on key Up while launcher_menu { emit launcher_menu_move(-1) }
    on key Down while launcher_menu { emit launcher_menu_move(1) }
    on key Return while launcher_menu { emit launcher_choice(launcher_menu_selected) }
    on key Tab { emit launcher_tab(launcher_tab + 1) }
    on key Shift+Tab { emit launcher_tab(launcher_tab - 1) }
}
