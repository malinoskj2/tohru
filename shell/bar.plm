scene Tohru {
 surface { size: full, 42; anchor: top; margin: 0; reserve: 31; screens: all; keyboard: exclusive while sound_open or cal_open }
 permissions { services: "window", "apps", "media", "clock" }
 include "bar/state.plm"
 include "calendar/state.plm"
 include "sound/declarations.plm"
 fact mooncoil = false
 fact corners = true
 text settings_status = "{}"
 text settings_error = ""
 text routing_error = ""
 text output_request = ""
 event config_reload ->
 event setting_mooncoil ->
 event setting_corners ->
 event setting_output ->
 box { from: 100, 0; size: screen.width - 200, 31; corner: 10; color: #160e14; opacity: 70% }
 include "bar/contents.plm"
 include "sound/view.plm"
 popup sound_panel {
  at: clamp(sound_button_x - 150, 8, screen.width - 308), 37
  size: 300, 116 + audio_failed * 62
  open: sound_open
  include "sound/panel.plm"
 }
 include "calendar/popup.plm"
}
