scene Tohru {
 surface { size: full, 42; anchor: top; margin: 0; reserve: 31; level: top, overlay while bar_launcher >= 2; screens: bar_outputs; keyboard: exclusive while sound_open or media_open or cal_open or net_open or bt_open or info_visible or about_visible or wall_open }
 permissions { services: "audio", "audio.step", "audio.volume", "audio.mute", "audio.input", "audio.input_mute", "audio.default", "audio.app_volume", "audio.app_mute", "window", "apps", "media", "media.*", "clock", "workspaces", "network.*", "bluetooth.*", "battery", "say:tohru-notifications", "say:tohru-session", "say:tohru-launcher"; run: "tohru-wallpaper" }
 include "bar/state.plm"
 include "bar/rail-state.plm"
 include "calendar/state.plm"
 include "settings/state.plm"
 include "network/state.plm"
 include "media/state.plm"
 include "bluetooth/state.plm"
 include "info/state.plm"
 include "about/state.plm"
 include "sound/declarations.plm"
 include "wallpaper/state.plm"
 include "osd/state.plm"
 include "corners/state.plm"
 include "panel-ink.plm"
 fact mooncoil = false
 // j2bar raises the bar over the launcher's scrim while it is mapped and tints it sky while it is open.
 fact bar_launcher = 0
 event launcher_bar ->
 event launcher_check ->
 // The critically damped spring closest to CSS `ease` over j2bar's 350 ms, within 0.05 of it throughout.
 prop bar_sky = 0 ~390ms
 follow bar_sky = if(bar_launcher == 1 or bar_launcher == 2, 1, 0)
 every 1s while bar_launcher != 0 { emit launcher_check }
 shader bar_fill = file "bar/fill.wgsl"
 text settings_status = "{}"
 text settings_error = ""
 text managed_config = ""
 text routing_error = ""
 text output_request = ""
 event config_reload ->
 event setting_mooncoil ->
 event setting_info_button ->
 event setting_polkit_agent ->
 event setting_about_button ->
 event setting_corners ->
 event setting_corner_size ->
 event setting_output ->
 event setting_lock_style ->
 event setting_notifications_position ->
 body {
  gradient: 0, 0 to 0, 31, #140a1e, #140a1e
  opacity: 14%
  glass: 100%
  lens: false
  highlight: 0%
  box { from: 100, 0; size: screen.width - 200, 31; corner: 10 }
  box { from: 100, 0; size: screen.width - 200, 21 }
 }
 // The box starts above the screen so only its bottom corners show.
 shader bar_fill { at: 100, -10; size: screen.width - 200, 41; corner: 10; values: 0.18, 0.06, 9, 0.14 * 0.36; colors: #140a1e, #140a1e }
 shader bar_fill { at: 100, -10; size: screen.width - 200, 41; corner: 10; values: 0.05 * bar_sky, 0.20 * bar_sky, 9, 0; colors: #89dceb, #89dceb; show: bar_sky > 0.002 }
 path {
  // Pleamar firms up light edges; 0.55 at 27.65% lands on j2bar's linear 1px hairline at 24%.
  stroke: 0.55; color: #ffffff; opacity: 27.65%
  move 92.5, -0.5
  curve 98.157, 1.843 via 95.814, -0.5
  curve 100.5, 7.5 via 100.5, 4.186
  line 100.5, 21
  curve 103.283, 27.717 via 100.5, 24.935
  curve 110, 30.5 via 106.065, 30.5
  line screen.width - 110, 30.5
  curve screen.width - 103.283, 27.717 via screen.width - 106.065, 30.5
  curve screen.width - 100.5, 21 via screen.width - 100.5, 24.935
  line screen.width - 100.5, 7.5
  curve screen.width - 98.157, 1.843 via screen.width - 100.5, 4.186
  curve screen.width - 92.5, -0.5 via screen.width - 95.814, -0.5
 }
 include "bar/contents.plm"
 include "bar/workspace.plm"
 include "services.plm"
 include "bar/bell.plm"
 include "sound/view.plm"
 include "wallpaper/view.plm"
 popup sound_panel {
  at: clamp(sound_button_x - 140, 8, screen.width - 288) - 12, 37
  size: 304, max(190, sound_open_h) + audio_failed * 54 + 18
  open: sound_open
  bright: panel_bright
  include "sound/panel.plm"
 }
 include "calendar/popup.plm"
 include "network/popup.plm"
 include "media/popup.plm"
 include "bluetooth/popup.plm"
 include "info/popup.plm"
 include "about/popup.plm"
 include "wallpaper/popup.plm"
 include "wallpaper/desktop.plm"
 include "corners/view.plm"
 include "osd/view.plm"
}
