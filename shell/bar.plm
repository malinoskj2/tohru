scene Tohru {
 surface { size: full, 42; anchor: top; margin: 0; reserve: 31; screens: bar_outputs; keyboard: exclusive while sound_open or cal_open or net_open or bt_open or info_visible or about_visible }
 permissions { services: "audio", "audio.step", "audio.volume", "audio.mute", "audio.input", "audio.input_mute", "audio.default", "audio.app_volume", "audio.app_mute", "window", "apps", "media", "clock", "workspaces", "network.*", "bluetooth.*", "battery", "say:tohru-notifications", "say:tohru-session" }
 include "bar/state.plm"
 include "bar/rail-state.plm"
 include "calendar/state.plm"
 include "settings/state.plm"
 include "network/state.plm"
 include "bluetooth/state.plm"
 include "info/state.plm"
 include "about/state.plm"
 include "sound/declarations.plm"
 include "osd/state.plm"
 include "corners/state.plm"
 include "panel-ink.plm"
 fact mooncoil = false
 shader bar_fill = file "bar/fill.wgsl"
 text settings_status = "{}"
 text settings_error = ""
 text managed_config = ""
 text routing_error = ""
 text output_request = ""
 event config_reload ->
 event setting_mooncoil ->
 event setting_info_button ->
 event setting_about_button ->
 event setting_corners ->
 event setting_corner_size ->
 event setting_output ->
 body {
  gradient: 0, 0 to 0, 31, #140a1e, #140a1e
  opacity: 14%
  glass: 100%
  lens: false
  highlight: 0%
  box { from: 100, 0; size: screen.width - 200, 31; corner: 10 }
  box { from: 100, 0; size: screen.width - 200, 21 }
 }
 // The box starts above the screen so only its bottom corners show.
 shader bar_fill { at: 100, -10; size: screen.width - 200, 41; corner: 10; values: 0.18, 0.06, 9, 0.14 * 0.36; colors: #140a1e, #140a1e }
 path {
  // Pleamar firms up light edges; 0.55 at 27.65% lands on j2bar's linear 1px hairline at 24%.
  stroke: 0.55; color: #ffffff; opacity: 27.65%
  move 92.5, -0.5
  curve 98.157, 1.843 via 95.814, -0.5
  curve 100.5, 7.5 via 100.5, 4.186
  line 100.5, 21
  curve 103.283, 27.717 via 100.5, 24.935
  curve 110, 30.5 via 106.065, 30.5
  line screen.width - 110, 30.5
  curve screen.width - 103.283, 27.717 via screen.width - 106.065, 30.5
  curve screen.width - 100.5, 21 via screen.width - 100.5, 24.935
  line screen.width - 100.5, 7.5
  curve screen.width - 98.157, 1.843 via screen.width - 100.5, 4.186
  curve screen.width - 92.5, -0.5 via screen.width - 95.814, -0.5
 }
 include "bar/contents.plm"
 include "bar/workspace.plm"
 include "services.plm"
 include "bar/bell.plm"
 include "sound/view.plm"
 popup sound_panel {
  at: clamp(sound_button_x - 150, 8, screen.width - 308), 37
  size: 300, 116 + sound_details * 316 + audio_failed * 62
  open: sound_open
  bright: panel_bright
  include "sound/panel.plm"
 }
 include "calendar/popup.plm"
 include "network/popup.plm"
 include "bluetooth/popup.plm"
 include "info/popup.plm"
 include "about/popup.plm"
 include "corners/view.plm"
 include "osd/view.plm"
}
