part AssistantDragon {
    // The sheets are 2x cells of a 150 px dragon drawn at 30, 40; puppet.luau picks the cell, eyes, mouth and heart.
    shader ai_dg_glass = file "dragon/glass.wgsl"
    let ai_float = 4 * sin(time * 90)
    let ai_dg_x = 30
    let ai_dg_y = 40
    surface ai_dragon_surface {
        size: 210, 230; anchor: bottom_right; margin: 0, 18, 18, 0; level: overlay; reserve: -1; keyboard: none
        // Opened unseen for a moment once the sheets are set, so they are loaded before she first shows.
        open: ai_dragon_k > 0.01 or ai_dg_warm
        layer_namespace: "tohru-dragon"
        group {
            opacity: max(ai_dragon_k, if(ai_dg_warm, 0.2%, 0%))
            move: 0, (1 - ai_dragon_k) * 24
            ellipse { at: 105, 214; radius: 46; scale: 1, 0.16; color: #000000; opacity: 18% - 6% * ai_float / 4 }
            group {
                move: 0, ai_float
                pivot: 105, 190
                rotate: ai_dg_tilt_s * 1deg
                scale: (1 + 0.04 * ai_dg_sq_s) * (1 + 0.012 * ai_mouth_s), (1 - 0.05 * ai_dg_sq_s) * (1 - 0.008 * ai_mouth_s)
                group {
                    show: ai_dg_ready
                    // One sheet for every body frame: changing between separate large images blanked her for a few frames.
                    // Light moving through the glass: a slow drift of hue across the body and a highlight now and then.
                    shader: ai_dg_glass, 1
                    image ai_dg_body { at: ai_dg_x, ai_dg_y; size: 150, 150; cell: ai_dg_frame, 8, 26 }
                    image ai_dg_eyes { at: ai_dg_x + 28 + ai_dg_ex, ai_dg_y + 33 + ai_dg_ey; size: 50, 26; cell: max(ai_dg_eye, 0), 4, 1; opacity: if(ai_dg_eye >= 0, 100%, 0.1%) }
                    image ai_dg_mouths {
                        at: ai_dg_x + 43.5 + ai_dg_mx, ai_dg_y + 47 + ai_dg_my + 0.8 * ai_mouth_s; size: 22, 20
                        cell: max(ai_dg_mouth, 0), 8, 1; opacity: if(ai_dg_mouth >= 0, 100%, 0.1%)
                    }
                }
                image ai_sprite { at: ai_dg_x, ai_dg_y; size: 150, 150; show: not ai_dg_ready }
                ellipse { at: ai_dg_x + 70.2, ai_dg_y + 46.5; radius: 3.4; scale: 1.15, 0.15 + 0.95 * ai_mouth_s; color: #4a2238; opacity: if(ai_dg_ready, 0%, min(90%, ai_mouth_s * 400%)) }
                image ai_dg_heart { at: ai_dg_h1_x - 12 * ai_dg_h1_s, ai_dg_h1_y - 12 * ai_dg_h1_s; size: 24 * max(ai_dg_h1_s, 0.05), 24 * max(ai_dg_h1_s, 0.05); opacity: max(ai_dg_h1_a, 0.001) }
                image ai_dg_heart { at: ai_dg_h2_x - 12 * ai_dg_h2_s, ai_dg_h2_y - 12 * ai_dg_h2_s; size: 24 * max(ai_dg_h2_s, 0.05), 24 * max(ai_dg_h2_s, 0.05); opacity: max(ai_dg_h2_a, 0.001) }
            }
            text ai_transcript { at: 105, 8; anchor: center top; width: 198; lines: 2; align: center; size: 11; family: "SF Pro Text"; color: #cdd6f4 }
            zone box ai_dragon_hit { from: 30, 30; size: 150, 170; corner: 40; cursor: pointer; active: ai_dragon_open; label: "Open this conversation" }
        }
        on press ai_dragon_hit { emit assistant_dragon }
    }
}
