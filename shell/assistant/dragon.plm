part AssistantDragon {
    // Body cells are 240 px, drawn at 150 logical px; puppet.luau registers the body, face features and hearts.
    shader ai_dg_glass = file "dragon/glass.wgsl"
    let ai_float = if(ai_dg_reduced or ai_actor_quiet, 0, 4 * sin(time * 90))
    let ai_dg_x = 30
    let ai_dg_y = 40
    image ai_wingbeat = file "dragon/flight.webp", 1800, 450
    text ai_actor_skin_src = ""
    image ai_actor_skin = from ai_actor_skin_src, 0, 0
    text ai_actor_closeup_src = ""
    image ai_actor_closeup = from ai_actor_closeup_src, 0, 0
    fact ai_actor_closeup_open = false
    fact ai_actor_skin_rows = 1
    fact ai_actor_skin_frame = 0
    fact ai_actor_skin_open = false
    fact ai_actor_scale = 1
    fact ai_actor_rotation = 0
    fact ai_actor_released = false
    fact ai_actor_quiet = false
    fact ai_actor_open = false
    image ai_landing = file "dragon/landing.webp", 1470, 882
    fact ai_landing_x = 0
    fact ai_landing_y = 0
    fact ai_landing_w = 0
    fact ai_landing_h = 0
    fact ai_landing_art = false
    fact ai_landing_frame = 0
    fact ai_landing_target = 0
    fact ai_landing_progress = 0
    fact ai_landing_scale = 1
    fact ai_flight_art = false
    fact ai_flight_cell = 0
    fact ai_flight_phase = 0
    fact ai_flying = false
    fact ai_flight_x = 0
    fact ai_flight_y = 0
    fact ai_flight_bank = 0
    fact ai_flight_alpha = 1
    fact ai_flight_altitude = 0
    fact ai_flight_behind = false
    event dragon_view_width ->
    event dragon_view_height ->
    on change ai_dragon_surface.width { emit dragon_view_width(ai_dragon_surface.width) }
    on change ai_dragon_surface.height { emit dragon_view_height(ai_dragon_surface.height) }
    fact ai_use_flight_surface = false
    text ai_flight_output = ""
    text ai_flight_trace = ""
    component DragonActor(dx: number, dy: number) {
        group {
            opacity: if(ai_actor_released, 0, ai_flight_alpha) * max(ai_dragon_k, if(ai_dg_warm, 0.2%, 0%))
            move: dx, dy
            pivot: 105, 115
            scale: ai_actor_scale, ai_actor_scale
            rotate: ai_actor_rotation * 1deg
            ellipse { at: 105, 214; radius: 46; scale: ai_dg_shadow_s, 0.16; color: #000000; opacity: (1 - ai_flight_altitude) * (18% - 6% * ai_float / 4) }
            group {
                move: 0, ai_float
                pivot: 105, 190
                rotate: (if(ai_actor_open, 0, ai_dg_tilt_s) + ai_flight_bank) * 1deg
                scale: (1 + if(ai_actor_open, 0, 0.04 * ai_dg_sq_s)) * (1 + if(ai_dg_reduced, 0, 0.012 * ai_mouth_s)), (1 - if(ai_actor_open, 0, 0.05 * ai_dg_sq_s)) * (1 - if(ai_dg_reduced, 0, 0.008 * ai_mouth_s))
                group {
                    show: ai_dg_ready
                    pivot: 105, 115
                    scale: ai_dg_pose_scale, ai_dg_pose_scale
                    // Keep the registered landing cell resident during the wingbeat.
                    opacity: if(ai_landing_art or ai_flight_art or ai_actor_skin_open or ai_actor_closeup_open, 0.2%, 100%)
                    // One sheet for every body frame: changing between separate large images blanked her for a few frames.
                    // Light moving through the glass: a slow drift of hue across the body and a highlight now and then.
                    shader: ai_dg_glass, if(ai_dg_reduced, 0, 1)
                    image ai_dg_body { at: ai_dg_x, ai_dg_y; size: 150, 150; cell: ai_dg_frame, 24, 24 }
                    image ai_dg_faces {
                        at: ai_dg_x + ai_dg_fx, ai_dg_y + ai_dg_fy; size: 50, 34
                        cell: max(ai_dg_face, 0), 8, 60; opacity: if(ai_dg_face >= 0, 100%, 0.1%)
                    }
                    image ai_dg_travel_mouths {
                        at: ai_dg_x + ai_dg_tx, ai_dg_y + ai_dg_ty; size: 24, 18
                        cell: max(ai_dg_travel, 0), 16, 170; opacity: if(ai_dg_travel >= 0, 100%, 0.1%)
                    }
                    image ai_dg_eyes { at: ai_dg_x + 28 + ai_dg_ex, ai_dg_y + 33 + ai_dg_ey; size: 50, 26; cell: max(ai_dg_eye, 0), 4, 1; opacity: if(ai_dg_eye >= 0, 100%, 0.1%) }
                    image ai_dg_mouths {
                        at: ai_dg_x + 43.5 + ai_dg_mx, ai_dg_y + 47 + ai_dg_my + 0.8 * ai_mouth_s; size: 22, 20
                        cell: max(ai_dg_mouth, 0), 8, 1; opacity: if(ai_dg_mouth >= 0, 100%, 0.1%)
                    }
                }
                group {
                    move: ai_dg_x + 2.585512, ai_dg_y + 26.779307
                    pivot: 70.060577, 50.052537
                    scale: 1.924510, 1.924510
                    rotate: 4.256904deg
                    shader: ai_afk_detail, 0, ai_afk_action, ai_afk_phase, 0
                    image ai_afk_body { at: 0, 0; size: 150, 150; show: ai_afk_body_open and (ai_afk_preparing or ai_afk_bust_mix < 0.9999); opacity: if(ai_afk_preparing, 100%, 1 - ai_afk_bust_mix * ai_afk_bust_mix * ai_afk_bust_mix * ai_afk_bust_mix) }
                }
                group {
                    move: ai_dg_x, ai_dg_y
                    shader: ai_afk_detail, ai_afk_art_kind, ai_afk_action, ai_afk_phase, ai_afk_fog
                    image ai_actor_closeup { at: 0, 0; size: 150, 150; show: ai_actor_closeup_open; opacity: if(ai_afk_preparing or not ai_afk_body_open, 100%, ai_afk_bust_mix) }
                }
                group {
                    move: ai_dg_x, ai_dg_y
                    shader: ai_afk_detail, ai_afk_art_kind, ai_afk_action, ai_afk_phase, ai_afk_fog
                    image ai_actor_skin { at: 0, 0; size: 150, 150; cell: ai_actor_skin_frame, 8, ai_actor_skin_rows; show: ai_actor_skin_open }
                }
                group {
                    show: ai_landing_art
                    pivot: 105, 115
                    scale: ai_landing_scale, ai_landing_scale
                    shader: ai_dg_glass, ai_landing_progress
                    image ai_landing { at: ai_dg_x + ai_landing_x, ai_dg_y + ai_landing_y; size: ai_landing_w, ai_landing_h; cell: ai_landing_frame, 15, 9 }
                }
                image ai_wingbeat { at: ai_dg_x, ai_dg_y; size: 150, 150; cell: ai_flight_cell, 12, 3; show: ai_flight_art }
                image ai_sprite { at: ai_dg_x, ai_dg_y; size: 150, 150; show: not ai_dg_ready }
                ellipse { at: ai_dg_x + 70.2, ai_dg_y + 46.5; radius: 3.4; scale: 1.15, 0.15 + 0.95 * ai_mouth_s; color: #4a2238; opacity: if(ai_dg_ready, 0%, min(90%, ai_mouth_s * 400%)) }
                image ai_dg_heart { at: ai_dg_h1_x - 12 * ai_dg_h1_s, ai_dg_h1_y - 12 * ai_dg_h1_s; size: 24 * max(ai_dg_h1_s, 0.05), 24 * max(ai_dg_h1_s, 0.05); opacity: max(ai_dg_h1_a, 0.001) }
                image ai_dg_heart { at: ai_dg_h2_x - 12 * ai_dg_h2_s, ai_dg_h2_y - 12 * ai_dg_h2_s; size: 24 * max(ai_dg_h2_s, 0.05), 24 * max(ai_dg_h2_s, 0.05); opacity: max(ai_dg_h2_a, 0.001) }
            }
            text ai_transcript { at: 105, 8; anchor: center top; width: 198; lines: 2; align: center; size: 11; family: "SF Pro Text"; color: #cdd6f4 }
        }
    }
    surface ai_idle_surface {
        size: 210, 230; anchor: bottom_right; margin: 0, 18, 18, 0; level: overlay; reserve: -1; keyboard: none
        open: not ai_use_flight_surface and (ai_dragon_k > 0.01 or ai_dg_warm)
        layer_namespace: "tohru-dragon"
        zone box ai_idle_hit { from: 30, 30; size: 150, 170; corner: 40; cursor: pointer; active: ai_dragon_open and not ai_use_flight_surface; label: "Open this conversation" }
        on press ai_idle_hit { emit assistant_dragon }
        DragonActor(0, if(ai_dg_reduced, 0, (1 - ai_dragon_k) * 24))
    }
    surface ai_dragon_surface {
        size: full, full; anchor: center; level: overlay, bottom while ai_flight_behind; reserve: -1; keyboard: none
        open: ai_use_flight_surface and (ai_dragon_k > 0.01 or ai_dg_warm)
        screens: ai_flight_output
        layer_namespace: "tohru-dragon-flight"
        let flight_left = if(ai_flying or ai_actor_open, ai_flight_x - 105, ai_dragon_surface.width - 228)
        let flight_top = if(ai_flying or ai_actor_open, ai_flight_y - 115, ai_dragon_surface.height - 248 + if(ai_dg_reduced, 0, (1 - ai_dragon_k) * 24))
        DragonActor(flight_left, flight_top)
        zone box ai_dragon_hit { from: flight_left + 30, flight_top + 30; size: 150, 170; corner: 40; cursor: pointer; active: ai_use_flight_surface and ai_dragon_open and ai_flight_alpha > 0.5; label: "Open this conversation" }
        on press ai_dragon_hit { emit assistant_dragon }
    }
}
