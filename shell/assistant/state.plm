part AssistantState {
    // Root measured button center; negative uses the native screen-relative default.
    prop ai_button_x = -1 ~0ms
    fact ai_open = false
    // 0 the chat, 1 history.
    fact ai_view = 0
    fact ai_picker = false
    // The provider in use: its row in ai_providers and its palette slot (0 peach … 4 mauve).
    fact ai_current = -1
    fact ai_slot = 0
    fact ai_signed_in = false
    fact ai_loaded = false
    // An answer is streaming (and in which provider's colour), or one arrived that has not been seen.
    fact ai_streaming = false
    fact ai_stream_slot = 0
    fact ai_ready = false
    fact ai_ready_slot = 0
    fact ai_menu_open = false
    // The voice service has the microphone open.
    fact ai_listening = false
    fact ai_memory_on = true
    fact ai_forget_armed = false
    text ai_memory_note = ""
    fact ai_voice_enabled = false
    fact ai_voice_conversation = false
    fact ai_voice_paused = false
    fact ai_speaking = false
    fact ai_mouth = 0
    text ai_voice_error = ""
    text ai_show_request = ""
    fact ai_voice_failed = false
    prop ai_glow = 0 ~400ms
    follow ai_glow = if(ai_streaming and not ai_open, 1, 0)
    prop ai_dragon_k = 0 ~spring(170, 20)
    follow ai_dragon_k = if(ai_dragon_open, 1, 0)
    prop ai_mouth_s = 0 ~70ms
    follow ai_mouth_s = ai_mouth
    // The conversation shown is the one streaming.
    fact ai_live_here = false
    fact ai_actions = false
    fact ai_copied = false
    fact ai_history_sel = -1
    text ai_provider_name = "Assistant"
    text ai_provider_model = ""
    text ai_provider_cli = ""
    text ai_prompt = ""
    text ai_search = ""
    text ai_live = ""
    text ai_error = ""
    fact ai_failed = false
    fact ai_searching = false
    fact ai_typed = false
    text ai_placeholder = "Ask"
    model ai_providers max 5 { id: text; name: text; slot: number; signed_in: bool; model: text; meta: text }
    model ai_turns max 64 { text: text; mine: bool; failed: bool; stopped: bool; voice: bool }
    model ai_memories max 40 { id: text; text: text; kind: text }
    model ai_history max 40 { id: text; title: text; when: text; slot: number; voice: bool; header: bool; group: text; match: text; matched: bool }
    event assistant_open ->
    event assistant_close ->
    event assistant_toggle ->
    event assistant_picker ->
    event assistant_choose ->
    event assistant_signin ->
    event assistant_history ->
    event assistant_new ->
    event assistant_send ->
    event assistant_stop ->
    event assistant_copy ->
    event assistant_retry ->
    event assistant_pick ->
    event assistant_search ->
    event assistant_move ->
    event assistant_activate ->
    event assistant_menu ->
    event assistant_menu_close ->
    event assistant_show_history ->
    event assistant_memory ->
    event assistant_memory_forget ->
    event assistant_memory_clear ->
    event assistant_hush ->
    event assistant_dragon ->
    event assistant_show_request ->

    image ai_history_icon = file "history.svg", 14, 14
    image ai_plus_icon = file "plus.svg", 14, 14
    image ai_copy_icon = file "copy.svg", 14, 14
    image ai_retry_icon = file "retry.svg", 14, 14
    image ai_send_icon = file "send.svg", 12, 12
    image ai_search_icon = file "search.svg", 13, 13
    image ai_terminal_icon = file "terminal.svg", 12, 12
    image ai_signin_icon = file "signin.svg", 12, 12
    image ai_mascot = file "../brand/mascot.png", 68, 68
    image ai_dragon = file "../brand/dragon.png", 16, 16
    image ai_sprite = file "../brand/mascot.png", 150, 150
    fact ai_dragon_open = false
    // The voice dragon's sheets (dragon/README.md), loaded only once voice is on and she first shows: puppet.luau sets the paths.
    text ai_dg_body_src = ""
    text ai_dg_eyes_src = ""
    text ai_dg_mouths_src = ""
    text ai_dg_heart_src = ""
    image ai_dg_body = from ai_dg_body_src, 1200, 3450
    image ai_dg_eyes = from ai_dg_eyes_src, 200, 26
    image ai_dg_mouths = from ai_dg_mouths_src, 176, 20
    image ai_dg_heart = from ai_dg_heart_src, 24, 24
    fact ai_dg_ready = false
    fact ai_dg_warm = false
    // The cell of body.webp: the idle and flutter loop, the drawn moves, then the still poses. The eye and mouth patches go over it (-1 none).
    fact ai_dg_sheet = 0
    fact ai_dg_cell = 0
    fact ai_dg_frame = 0
    fact ai_dg_eye = -1
    fact ai_dg_ex = 0
    fact ai_dg_ey = 0
    fact ai_dg_mouth = -1
    fact ai_dg_mx = 0
    fact ai_dg_my = 0
    fact ai_dg_tilt = 0
    fact ai_dg_sq = 0
    fact ai_dg_h1_x = 0
    fact ai_dg_h1_y = 0
    fact ai_dg_h1_s = 0
    fact ai_dg_h1_a = 0
    fact ai_dg_h2_x = 0
    fact ai_dg_h2_y = 0
    fact ai_dg_h2_s = 0
    fact ai_dg_h2_a = 0
    prop ai_dg_tilt_s = 0 ~spring(120, 16)
    follow ai_dg_tilt_s = ai_dg_tilt
    prop ai_dg_sq_s = 0 ~50ms
    follow ai_dg_sq_s = ai_dg_sq

    let ai_colour = pick(ai_slot, ink_peach, ink_yellow, ink_green, ink_lavender, ink_mauve)
    let ai_stream_colour = pick(ai_stream_slot, ink_peach, ink_yellow, ink_green, ink_lavender, ink_mauve)
    let ai_ready_colour = pick(ai_ready_slot, ink_peach, ink_yellow, ink_green, ink_lavender, ink_mauve)
    let ai_has_chat = ai_turns.count > 0 or ai_live_here
    let ai_needs_signin = ai_current >= 0 and not ai_signed_in
    // The popup is docked: as wide as ai_w and as tall as the screen under the bar, 12 px clear at the foot.
    // screen.height is the bar's own 42 px, so an empty 1 px strip on the bar's monitor measures it.
    surface ai_screen_probe {
        size: 1, full; anchor: right; level: background; reserve: -1; keyboard: none; screens: bar_outputs
        layer_namespace: "tohru-measure"
    }
    let ai_picker_h = 44 + 30 * max(1, ai_providers.count) + 36
    let ai_w = 380
    let ai_h = max(400, ai_screen_probe.height - 49)
}
