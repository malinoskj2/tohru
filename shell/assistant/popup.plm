part AssistantPopup {
    let ai_anchor_x = if(ai_button_x < 0, screen.width - 357, ai_button_x)
    // Docked down the right edge, under the bar, 12 px clear of the screen's edges.
    popup assistant {
        at: screen.width - ai_w - 24, 37
        size: ai_w + 24, ai_h + 12
        open: ai_open
        bright: panel_bright
        let ai_ox = 12
        let ai_right = ai_ox + ai_w - 8
        let ai_field_y = ai_h - 42
        let ai_chat_shown = not ai_picker and ai_view == 0 and not ai_needs_signin

        body {
            color: ink_glass; glass: 100%; frost: 100%; tint: 60%; vivid: 135%; refraction: 0%; dispersion: 0%; mirror: 0%; highlight: 0%; ripple: 0%
            shadow: 0, 4, 10, 0.22 - 0.1 * pk
            box { from: ai_ox, 0; size: ai_w, ai_h; corner: 15 }
        }
        box { from: ai_ox + 0.5, 0.5; size: ai_w - 1, ai_h - 1; corner: 14.5; stroke: 1; color: ink_white; opacity: 0.6 * (26% - 10% * pk) }

        // The heading: the provider (or "History") with the fold chevron, then history and new chat.
        measure ai_name
        let ai_name_w = min(150, ai_name.width)
        let ai_dot_w = if(ai_view >= 1 and not ai_picker, 0, 13)
        zone box ai_head { from: ai_ox + 10, 10; size: ai_name_w + ai_dot_w + 28, 22; corner: 7; cursor: pointer; label: if(ai_picker, "Fold providers", "Choose provider") }
        box { from: ai_ox + 10, 10; size: ai_name_w + ai_dot_w + 28, 22; corner: 7; color: ink_white; opacity: max(if(ai_picker, 8%, 0%), max(ai_head.hover * 10%, ai_head.pressed * 16%)) }
        group {
            show: ai_dot_w > 0 and ai_signed_in
            glow: 4, 40%, ai_colour
            ellipse { at: ai_ox + 19, 21; radius: 3; color: ai_colour }
        }
        ellipse { at: ai_ox + 19, 21; radius: 2.4; stroke: 1.2; color: ai_colour; show: ai_dot_w > 0 and not ai_signed_in }
        text pick(if(ai_picker, 0, ai_view), ai_provider_name, "History", "Memory") { at: ai_ox + 16 + ai_dot_w, 21; anchor: left center; size: 13; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 0%; measure: ai_name }
        text pick(if(ai_picker, 0, ai_view), ai_provider_name, "History", "Memory") { at: ai_ox + 16 + ai_dot_w, 21; anchor: left center; width: 150; lines: 1; size: 13; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 92% }
        text ai_provider_model { at: ai_ox + 16 + ai_dot_w + ai_name_w + 22, 21.5; anchor: left center; width: ai_w - ai_dot_w - ai_name_w - 108; lines: 1; size: 11; family: "SF Pro Text"; color: ink_white; opacity: 50%; show: not ai_picker and ai_view == 0 and ai_signed_in }
        group {
            pivot: ai_ox + 16 + ai_dot_w + ai_name_w + 11, 22
            rotate: if(ai_picker, 3.14159, 0)
            path {
                at: ai_ox + 16 + ai_dot_w + ai_name_w + 11, 22
                stroke: 1.25; color: ink_white; opacity: 60%
                move -2.5, -1.25
                line 0, 1.25
                line 2.5, -1.25
            }
        }
        on press ai_head { emit assistant_picker }

        zone box ai_history_hit { from: ai_right - 50, 10; size: 24, 22; corner: 7; cursor: pointer; label: if(ai_view >= 1, "Back to chat", "History") }
        box { from: ai_right - 50, 10; size: 24, 22; corner: 7; color: ink_white; opacity: max(if(ai_view >= 1 and not ai_picker, 14%, 0%), max(ai_history_hit.hover * 10%, ai_history_hit.pressed * 16%)) }
        image ai_history_icon { at: ai_right - 45, 14; size: 14, 14; tint: ink_white; opacity: 80% }
        zone box ai_new_hit { from: ai_right - 24, 10; size: 24, 22; corner: 7; cursor: pointer; label: "New chat" }
        box { from: ai_right - 24, 10; size: 24, 22; corner: 7; color: ink_white; opacity: max(ai_new_hit.hover * 10%, ai_new_hit.pressed * 16%) }
        image ai_plus_icon { at: ai_right - 19, 14; size: 14, 14; tint: ink_white; opacity: 80% }
        on press ai_history_hit { emit assistant_history }
        on press ai_new_hit { emit assistant_new }

        // The picker: every installed CLI with its model, or Sign in for one that is signed out.
        group {
            show: ai_picker
            for p in ai_providers {
                let p_y = 40 + 30 * p.index
                let p_colour = pick(p.slot, ink_peach, ink_yellow, ink_green, ink_lavender, ink_mauve)
                let p_on = p.index == ai_current
                zone box ai_prow { from: ai_ox + 8, p_y; size: ai_w - 16 - if(p.signed_in, 0, 78), 28; corner: 7; cursor: pointer; active: ai_picker; label: "Use {p.name}"; selected: p_on }
                box { from: ai_ox + 8, p_y; size: ai_w - 16, 28; corner: 7; color: ink_white; opacity: max(if(p_on, 12%, 0%), max(ai_prow.hover * 10%, ai_prow.pressed * 16%)) }
                group {
                    show: p.signed_in
                    glow: 4, 40%, p_colour
                    ellipse { at: ai_ox + 20, p_y + 14; radius: 3; color: if(p_on, ink_white, p_colour) }
                }
                ellipse { at: ai_ox + 20, p_y + 14; radius: 2.4; stroke: 1.2; color: p_colour; show: not p.signed_in }
                measure ai_pname
                text p.name { at: ai_ox + 32, p_y + 14; anchor: left center; size: 13; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: if(p.signed_in, 92%, 62%); measure: ai_pname }
                text p.id { at: ai_ox + 38 + ai_pname.width, p_y + 15; anchor: left center; size: 10.5; family: "SF Pro Text"; color: ink_white; opacity: 42% }
                text p.meta { at: ai_right - 6, p_y + 14; anchor: right center; width: 90; lines: 1; align: right; size: 11; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 55%; show: p.signed_in }
                zone box ai_psign { from: ai_right - 74, p_y + 4; size: 68, 20; corner: 6; cursor: pointer; active: ai_picker and not p.signed_in; label: "Sign in to {p.name}" }
                group {
                    show: not p.signed_in
                    box { from: ai_right - 74, p_y + 4; size: 68, 20; corner: 6; color: ink_white; opacity: 12% + max(ai_psign.hover * 6%, ai_psign.pressed * 12%) }
                    image ai_signin_icon { at: ai_right - 67, p_y + 8; size: 12, 12; tint: ink_white; opacity: 80% }
                    text "Sign in" { at: ai_right - 50, p_y + 14; anchor: left center; size: 11; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 92% }
                }
                on press ai_prow { emit assistant_choose(p.index) }
                on press ai_psign { emit assistant_signin(p.index) }
            }
            text if(ai_providers.count == 0, "No AI CLIs found on PATH", "Installed AI CLIs on this machine") { at: ai_ox + 14, ai_picker_h - 18; anchor: left center; size: 10.5; family: "SF Pro Text"; color: ink_white; opacity: 42% }
        }

        // Signed out (or Orca bot offline): status note, plus Sign in… for local CLIs.
        group {
            show: not ai_picker and ai_view == 0 and ai_needs_signin
            box { from: ai_ox + 10, 46; size: ai_w - 20, if(ai_can_signin, 122, 92); corner: 11; color: ink_white; opacity: 6% }
            box { from: ai_ox + 10.5, 46.5; size: ai_w - 21, if(ai_can_signin, 121, 91); corner: 10.5; stroke: 1; color: ink_white; opacity: 12% }
            ellipse { at: ai_ox + 26, 64; radius: 2.4; stroke: 1.2; color: ai_colour }
            text ai_offline_title { at: ai_ox + 36, 64; anchor: left center; width: ai_w - 60; lines: 1; size: 12.5; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 92% }
            text ai_offline_body { at: ai_ox + 36, 78; width: ai_w - 60; lines: 3; size: 10.5; family: "SF Pro Text"; color: ink_white; opacity: 62% }
            zone box ai_signin_hit { from: ai_ox + 34, 112; size: 80, 22; corner: 6; cursor: pointer; active: ai_can_signin and ai_needs_signin and not ai_picker and ai_view == 0; label: "Sign in to {ai_provider_name}" }
            group {
                show: ai_can_signin
                box { from: ai_ox + 34, 112; size: 80, 22; corner: 6; color: ink_white; opacity: 16% + max(ai_signin_hit.hover * 6%, ai_signin_hit.pressed * 12%) }
                image ai_terminal_icon { at: ai_ox + 42, 117; size: 12, 12; tint: ink_white; opacity: 85% }
                text "Sign in…" { at: ai_ox + 59, 123; anchor: left center; size: 11; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 92% }
                text "runs {ai_provider_cli}" { at: ai_ox + 36, 151; anchor: left center; size: 10.5; family: "SF Pro Text"; color: ink_white; opacity: 42% }
            }
            on press ai_signin_hit { emit assistant_signin(ai_current) }
        }

        // The empty chat: the mascot and what is ready to answer.
        group {
            show: ai_chat_shown and not ai_has_chat
            image ai_mascot { at: ai_ox + ai_w / 2 - 34, ai_h / 2 - 90; size: 68, 68; opacity: 95% }
            text if(ai_current < 0, "No AI CLIs found", "Ask anything") { at: ai_ox + ai_w / 2, ai_h / 2 - 4; anchor: center; size: 13; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 92% }
            text if(ai_current < 0, "Install claude, codex, gemini, agy or opencode", "{ai_provider_name}{? · {ai_provider_model}} · signed in") { at: ai_ox + ai_w / 2, ai_h / 2 + 15; anchor: center; width: ai_w - 30; lines: 1; align: center; size: 11; family: "SF Pro Text"; color: ink_white; opacity: 55% }
            text ai_voice_error { at: ai_ox + 15, ai_h / 2 + 30; anchor: left top; width: ai_w - 30; lines: 8; align: center; size: 10; family: "SF Pro Text"; color: ink_red; show: ai_voice_failed }
        }

        // The chat: questions on plates at the right, answers as plain text, the live answer with its caret.
        measure ai_live_box
        column ai_chat {
            at: ai_ox + 10, 44
            view: ai_w - 20, max(10, ai_h - 44 - 52)
            stick: end
            gap: 10
            show: ai_chat_shown and ai_has_chat
            for t in ai_turns {
                row { padding: 8; corner: 10; fill: mix(#3a3346, #e6e2ee, pk); place: 1; show: t.mine
                    text t.text { width: ai_w - 84; tight: true; lines: 0; size: 13; family: "SF Pro Text"; color: ink_white; opacity: 92%; selectable: true }
                }
                row { padding: 2; show: not t.mine
                    text t.text { width: ai_w - 34; lines: 0; size: 13; line_height: 1.35; family: "SF Pro Text"; color: if(t.failed, ink_red, ink_white); opacity: 92%; markdown: true; selectable: true }
                }
            }
            group { size: ai_w - 20, max(18, ai_live_box.height); show: ai_live_here
                text "{ai_live}▍" { at: 4, 0; width: ai_w - 34; lines: 0; size: 13; line_height: 1.35; family: "SF Pro Text"; color: ink_white; opacity: 92%; markdown: true; measure: ai_live_box; letter_opacity: if(letter >= letters - 1, 0, 1) }
                text "{ai_live}▍" { at: 4, 0; width: ai_w - 34; lines: 0; size: 13; line_height: 1.35; family: "SF Pro Text"; color: ai_stream_colour; markdown: true; letter_opacity: if(letter >= letters - 1, 0.5 + 0.5 * sin(time * 360), 0) }
            }
            group { size: ai_w - 20, 24; show: ai_actions
                zone box ai_copy_hit { from: 0, 2; size: 24, 22; corner: 7; cursor: pointer; active: ai_actions; label: "Copy answer" }
                box { from: 0, 2; size: 24, 22; corner: 7; color: ink_white; opacity: max(ai_copy_hit.hover * 10%, ai_copy_hit.pressed * 16%) }
                image ai_copy_icon { at: 5, 6; size: 14, 14; tint: ink_white; opacity: 70% }
                zone box ai_retry_hit { from: 26, 2; size: 24, 22; corner: 7; cursor: pointer; active: ai_actions; label: "Retry" }
                box { from: 26, 2; size: 24, 22; corner: 7; color: ink_white; opacity: max(ai_retry_hit.hover * 10%, ai_retry_hit.pressed * 16%) }
                image ai_retry_icon { at: 31, 6; size: 14, 14; tint: ink_white; opacity: 70% }
                text "Copied" { at: 58, 13; anchor: left center; size: 10.5; family: "SF Pro Text"; color: ink_white; opacity: if(ai_copied, 55%, 0%) }
            }
        }
        on press ai_copy_hit { emit assistant_copy }
        on press ai_retry_hit { emit assistant_retry }

        // The field, always at the foot; Stop in it while an answer streams here.
        group {
            show: not ai_picker and ai_view == 0
            opacity: if(ai_needs_signin or ai_current < 0, 50%, 100%)
            box { from: ai_ox + 10, ai_field_y; size: ai_w - 20, 32; corner: 10; color: ink_white; opacity: 7% }
            box { from: ai_ox + 10.5, ai_field_y + 0.5; size: ai_w - 21, 31; corner: 9.5; stroke: 1; color: ink_white; opacity: 16% - 4% * pk }
            input ai_prompt { at: ai_ox + 22, ai_field_y + 8; width: ai_w - 64; size: 13; family: "SF Pro Text"; color: ink_white; label: "Message" }
            text ai_placeholder { at: ai_ox + 22, ai_field_y + 16; anchor: left center; width: ai_w - 64; lines: 1; size: 13; family: "SF Pro Text"; color: ink_white; opacity: 42%; show: not ai_typed }
            zone box ai_send_hit { from: ai_right - 35, ai_field_y + 5; size: 22, 22; corner: 11; cursor: pointer; active: ai_live_here or (ai_typed and ai_signed_in); label: if(ai_live_here, "Stop", "Send") }
            ellipse { at: ai_right - 24, ai_field_y + 16; radius: 11; color: if(ai_typed and not ai_live_here, ai_colour, ink_white); opacity: if(ai_live_here, 16%, if(ai_typed, 100%, 10%)) + ai_send_hit.hover * 6% }
            image ai_send_icon { at: ai_right - 30, ai_field_y + 10; size: 12, 12; tint: if(ai_typed, #1b1622, ink_white); opacity: if(ai_typed, 100%, 55%); show: not ai_live_here }
            box { from: ai_right - 28, ai_field_y + 12; size: 8, 8; corner: 2; color: ink_white; opacity: 85%; show: ai_live_here }
            text ai_error { at: ai_ox + 14, ai_field_y - 10; width: ai_w - 28; lines: 1; anchor: left center; size: 10.5; family: "SF Pro Text"; color: ink_red; show: ai_failed }
        }
        on press ai_send_hit { emit assistant_send }
        on submit ai_prompt { emit assistant_send }

        // History: search, then the chats under Today, Yesterday, This week and Earlier.
        group {
            show: not ai_picker and ai_view == 1
            box { from: ai_ox + 10, 42; size: ai_w - 90, 28; corner: 8; color: ink_white; opacity: 7% }
            box { from: ai_ox + 10.5, 42.5; size: ai_w - 91, 27; corner: 7.5; stroke: 1; color: ink_white; opacity: 16% - 4% * pk }
            image ai_search_icon { at: ai_ox + 19, 49.5; size: 13, 13; tint: ink_white; opacity: 55% }
            zone box ai_memory_hit { from: ai_right - 72, 42; size: 72, 28; corner: 8; cursor: pointer; active: ai_view == 1 and not ai_picker; label: "What Tohru remembers" }
            box { from: ai_right - 72, 42; size: 72, 28; corner: 8; color: ink_white; opacity: 7% + max(ai_memory_hit.hover * 6%, ai_memory_hit.pressed * 12%) }
            text "Memory" { at: ai_right - 36, 56; anchor: center; size: 12; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 85% }
            on press ai_memory_hit { emit assistant_memory }
            input ai_search { at: ai_ox + 38, 48; width: ai_w - 128; size: 12.5; family: "SF Pro Text"; color: ink_white; placeholder: "Search chats"; label: "Search chats" }
            column ai_hist {
                at: ai_ox + 6, 76
                view: ai_w - 12, ai_h - 88
                gap: 0
                for h in ai_history {
                    group { size: ai_w - 12, if(h.header, 20, 28)
                        text h.group { at: 8, 12; anchor: left center; size: 10.5; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 55%; show: h.header }
                        zone box ai_hrow { from: 0, 0; size: ai_w - 12, 28; corner: 7; cursor: pointer; active: not h.header and ai_view == 1; label: "Open {h.title}"; selected: h.index == ai_history_sel }
                        group {
                            show: not h.header
                            box { from: 0, 0; size: ai_w - 12, 28; corner: 7; color: ink_white; opacity: max(if(h.index == ai_history_sel, 12%, 0%), max(ai_hrow.hover * 10%, ai_hrow.pressed * 16%)) }
                            ellipse { at: 14, 14; radius: 3; color: pick(h.slot, ink_peach, ink_yellow, ink_green, ink_lavender, ink_mauve) }
                            text h.title { at: 25, if(h.matched, 9, 14); anchor: left center; width: ai_w - 110; lines: 1; size: 13; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 92% }
                            text h.match { at: 25, 21; anchor: left center; width: ai_w - 80; lines: 1; size: 10; family: "SF Pro Text"; color: ink_white; opacity: 50%; show: h.matched }
                            text "voice" { at: ai_w - 22, 22; anchor: right center; size: 9; family: "SF Pro Text"; color: ink_white; opacity: 42%; show: h.voice }
                            text h.when { at: ai_w - 22, if(h.voice, 10, 14); anchor: right center; size: 10.5; family: "SF Pro Text:tnum"; color: ink_white; opacity: 55% }
                        }
                        on press ai_hrow { emit assistant_pick(h.index) }
                    }
                }
            }
            text if(ai_searching, "No chats match", "No chats yet") { at: ai_ox + ai_w / 2, 120; anchor: center; size: 12; family: "SF Pro Text"; color: ink_white; opacity: 55%; show: ai_history.count == 0 }
        }

        // Memory: what Tohru remembers, each with a forget button, and forget everything.
        group {
            show: not ai_picker and ai_view == 2
            text ai_memory_note { at: ai_ox + 16, 50; anchor: left center; width: ai_w - 32; lines: 0; size: 11; family: "SF Pro Text"; color: ink_white; opacity: 60% }
            column ai_mem {
                at: ai_ox + 6, 70
                view: ai_w - 12, ai_h - 126
                gap: 0
                for m in ai_memories {
                    group { size: ai_w - 12, 40
                        box { from: 0, 0; size: ai_w - 12, 38; corner: 7; color: ink_white; opacity: max(ai_mforget.hover * 4%, 0%) }
                        text m.text { at: 10, 19; anchor: left center; width: ai_w - 60; lines: 0; size: 12; family: "SF Pro Text"; color: ink_white; opacity: 88% }
                        zone box ai_mforget { from: ai_w - 42, 8; size: 24, 22; corner: 7; cursor: pointer; active: ai_view == 2; label: "Forget {m.text}" }
                        box { from: ai_w - 42, 8; size: 24, 22; corner: 7; color: ink_white; opacity: max(ai_mforget.hover * 10%, ai_mforget.pressed * 16%) }
                        text "×" { at: ai_w - 30, 19; anchor: center; size: 15; family: "SF Pro Text"; color: ink_white; opacity: 70% }
                        on press ai_mforget { emit assistant_memory_forget(m.index) }
                    }
                }
            }
            text if(ai_memory_on, "Nothing remembered yet", "Memory is off") { at: ai_ox + ai_w / 2, 140; anchor: center; size: 12; family: "SF Pro Text"; color: ink_white; opacity: 55%; show: ai_memories.count == 0 }
            zone box ai_forget_all { from: ai_ox + 10, ai_h - 40; size: ai_w - 20, 28; corner: 8; cursor: pointer; active: ai_view == 2 and ai_memories.count > 0; label: "Forget everything" }
            group {
                show: ai_memories.count > 0
                box { from: ai_ox + 10, ai_h - 40; size: ai_w - 20, 28; corner: 8; color: if(ai_forget_armed, ink_red, ink_white); opacity: if(ai_forget_armed, 30%, 7%) + max(ai_forget_all.hover * 6%, ai_forget_all.pressed * 12%) }
                text if(ai_forget_armed, "Press again to forget everything", "Forget everything") { at: ai_ox + ai_w / 2, ai_h - 26; anchor: center; size: 12; weight: 500; family: "SF Pro Text"; color: ink_white; opacity: 88% }
            }
            on press ai_forget_all { emit assistant_memory_clear }
        }
        on change ai_open while ai_open and ai_view == 0 and not ai_picker { focus ai_prompt }
        on change ai_view while ai_open and ai_view == 1 { focus ai_search }
        on change ai_view while ai_open and ai_view == 0 { focus ai_prompt }
    }
    on key Down while ai_open and (ai_view == 1 or ai_picker) { emit assistant_move(1) }
    on key Up while ai_open and (ai_view == 1 or ai_picker) { emit assistant_move(-1) }
    on key Return while ai_open and (ai_view == 1 or ai_picker) { emit assistant_activate }
    on key Escape { ai_open = false }
    on blur { ai_open = false }
}
