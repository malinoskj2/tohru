part CapturePresentation {
    component FrozenOutput(picture: image, ox: number, oy: number, w: number, h: number) {
        image picture { at: 0, 0; size: w, h }
        box { from: 0, 0; size: w, h; color: #000000; opacity: 65% }
        let left = clamp(capture_left - ox, 0, w)
        let top = clamp(capture_top - oy, 0, h)
        let right = clamp(capture_right - ox, 0, w)
        let bottom = clamp(capture_bottom - oy, 0, h)
        group {
            show: capture_dragging and capture_width > 0 and capture_height > 0 and right > left and bottom > top
            group {
                clip box { from: left, top; size: max(0, right - left), max(0, bottom - top) }
                image picture { at: 0, 0; size: w, h }
            }
            box { from: left - 2, top - 2; size: max(0, right - left) + 4, max(0, bottom - top) + 4; stroke: 2; color: #cba6f7 }
        }
        measure dimensions
        let badge_w = dimensions.width + 12
        let badge_h = dimensions.height + 8
        group {
            move: clamp(capture_current_x - ox + 12, 0, max(0, w - badge_w)), clamp(capture_current_y - oy + 14, 0, max(0, h - badge_h))
            show: capture_dragging and capture_width > 0 and capture_height > 0 and capture_current_x >= ox and capture_current_x < ox + w and capture_current_y >= oy and capture_current_y < oy + h
            box { from: 0, 0; size: badge_w, badge_h; corner: 3; color: #1e1e2e; opacity: 94% }
            box { from: 0, 0; size: badge_w, badge_h; corner: 3; stroke: 1; color: #cba6f7 }
            text "{capture_width}x{capture_height}" { at: 6, 4; anchor: left top; size: 14; weight: 700; color: #cba6f7; measure: dimensions }
        }
        zone box area { from: 0, 0; size: w, h; cursor: crosshair; active: capture_open }
        on press area {
            capture_start_x = ox + pointer.x
            capture_start_y = oy + pointer.y
            capture_current_x = ox + pointer.x
            capture_current_y = oy + pointer.y
            capture_dragging = true
        }
        on drag area { capture_current_x = ox + pointer.x; capture_current_y = oy + pointer.y }
        on release area { capture_current_x = ox + pointer.x; capture_current_y = oy + pointer.y; emit capture_finish }
        // Consume right click without the framework's prototype quit shortcut.
        on press right area { capture_dragging = capture_dragging }
    }
}
