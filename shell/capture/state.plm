part CaptureState {
    fact capture_open = false
    fact capture_dragging = false
    fact capture_start_x = 0
    fact capture_start_y = 0
    fact capture_current_x = 0
    fact capture_current_y = 0
    let capture_left = floor(min(capture_start_x, capture_current_x))
    let capture_top = floor(min(capture_start_y, capture_current_y))
    let capture_right = ceil(max(capture_start_x, capture_current_x))
    let capture_bottom = ceil(max(capture_start_y, capture_current_y))
    let capture_width = capture_right - capture_left
    let capture_height = capture_bottom - capture_top
    text capture_error = ""
    text capture_status = "{}"
    event capture_open_request ->
    event capture_finish ->
    event capture_cancel ->
    event capture_output_changed ->
    text capture_output_0 = ""
    text capture_frame_0 = ""
    fact capture_x_0 = 0
    fact capture_y_0 = 0
    image capture_image_0 = from capture_frame_0, 0, 0
