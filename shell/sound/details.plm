part SoundDetails {
 // Other outputs, three to a page under the default one. Each fades and rises in after the one above.
 for output in sound_outputs {
  let o_other = output.index - if(sound_default_row >= 0 and output.index > sound_default_row, 1, 0)
  let o_row = o_other - sound_out_page * 3 + 1
  let o_k = clamp(pick(o_row - 1, sound_lag.40, sound_lag.80, sound_lag.120), 0, 1)
  let o_y = 34 + 26 * o_row + (1 - o_k) * 8
  group {
   show: not output.default and o_row >= 1 and o_row <= 3 and o_k > 0.001
   opacity: smooth(0.3, 1, o_k)
   zone box o_hit { from: sound_ox + 8, o_y; size: sound_w - 16, 22; corner: 7; cursor: pointer; active: sound_unfolded; label: "Use {output.name}" }
   box { from: sound_ox + 8, o_y; size: sound_w - 16, 22; corner: 7; color: sound_ink; opacity: max(o_hit.hover * 10%, o_hit.pressed * 16%) }
   text output.name { at: sound_ox + 38, o_y + 10.3; anchor: left center; width: sound_w - 54; lines: 1; size: 13; weight: 500; family: "SF Pro Text:tnum"; color: sound_ink; opacity: 92% }
   on press o_hit { sound_keyed = false; emit audio_output_select(output.id) }
  }
 }
 let sound_out_k = clamp(sound_lag.120, 0, 1)
 let sound_out_pages = max(1, ceil(sound_out_others / 3))
 let sound_out_pager_y = 34 + 26 * sound_out_rows + (1 - sound_out_k) * 8
 group {
  show: sound_out_pager == 1 and sound_out_k > 0.001
  opacity: smooth(0.3, 1, sound_out_k)
  text "{sound_out_page + 1} of {sound_out_pages}" { at: sound_ox + 38, sound_out_pager_y + 10.3; anchor: left center; size: 11; weight: 500; family: "SF Pro Text:tnum"; color: sound_ink; opacity: 60% }
  zone box sound_out_prev { from: sound_ox + sound_w - 64, sound_out_pager_y; size: 24, 22; corner: 7; cursor: pointer; active: sound_unfolded and sound_out_page > 0; label: "Previous outputs" }
  zone box sound_out_next { from: sound_ox + sound_w - 38, sound_out_pager_y; size: 24, 22; corner: 7; cursor: pointer; active: sound_unfolded and sound_out_page + 1 < sound_out_pages; label: "More outputs" }
  box { from: sound_ox + sound_w - 64, sound_out_pager_y; size: 24, 22; corner: 7; color: sound_ink; opacity: max(sound_out_prev.hover * 10%, sound_out_prev.pressed * 16%) }
  box { from: sound_ox + sound_w - 38, sound_out_pager_y; size: 24, 22; corner: 7; color: sound_ink; opacity: max(sound_out_next.hover * 10%, sound_out_next.pressed * 16%) }
  text "‹" { at: sound_ox + sound_w - 52, sound_out_pager_y + 10; anchor: center; size: 16; family: "SF Pro Text"; color: sound_ink; opacity: if(sound_out_page > 0, 92%, 38%) }
  text "›" { at: sound_ox + sound_w - 26, sound_out_pager_y + 10; anchor: center; size: 16; family: "SF Pro Text"; color: sound_ink; opacity: if(sound_out_page + 1 < sound_out_pages, 92%, 38%) }
 }
 on press sound_out_prev { sound_out_page = max(0, sound_out_page - 1) }
 on press sound_out_next { sound_out_page = min(sound_out_pages - 1, sound_out_page + 1) }

 // The microphone: its mini under the water, then a row with a slider.
 let mic_m = sound_lag.30
 let mic_c = clamp(mic_m, 0, 1)
 let mic_v = if(sound_input_dragging, sound_input_requested, clamp(audio.input, 0, 1))
 let mic_sy = 160 + (sound_mic_y - 160) * mic_m
 let mic_tx = sound_ox + 13 + 27 * mic_m
 let mic_ty = 179 + (sound_mic_y + 10 - 179) * mic_m
 let mic_tw = 14 + 180 * mic_m
 let mic_fh = 2 + 2 * mic_c
 let mic_bs = 0.3 + 0.7 * smooth(0.4, 1, mic_c)
 group {
  show: sound_input_ready
  opacity: if(audio.input_muted, 38%, 100%)
  zone box mic_hit { from: sound_ox + 8, mic_sy; size: 24, 22; corner: 7; cursor: pointer; active: sound_unfolded; label: "Mute microphone" }
  box { from: sound_ox + 8, mic_sy; size: 24, 22; corner: 7; color: sound_ink; opacity: mic_c * max(mic_hit.hover * 10%, mic_hit.pressed * 16%) }
  image sound_mic_glyph { at: sound_ox + 13, mic_sy + 4 - 1.5 * (1 - mic_c); size: 14, 14; tint: sound_ink; opacity: 92%; show: not audio.input_muted }
  image sound_mic_off_glyph { at: sound_ox + 13, mic_sy + 4 - 1.5 * (1 - mic_c); size: 14, 14; tint: sound_ink; opacity: 92%; show: audio.input_muted }
  box { from: mic_tx, mic_ty; size: mic_tw, 2; corner: 1; color: sound_ink; opacity: 22% }
  box { from: mic_tx, mic_ty + 1 - mic_fh / 2; size: mic_tw * mic_v, mic_fh; corner: mic_fh / 2; color: sound_ink; opacity: 92% + 8% * mic_c; show: mic_tw * mic_v > 0.5 }
  box { from: mic_tx + clamp(mic_tw * mic_v, 8 * mic_bs, mic_tw - 8 * mic_bs) - 8 * mic_bs, mic_ty + 1 - 4 * mic_bs; size: 16 * mic_bs, 8 * mic_bs; corner: 4 * mic_bs; color: sound_ink; opacity: smooth(0.55, 1, mic_c) }
  text "{round(mic_v * 100)}" { at: sound_ox + 266.5, sound_mic_y + (1 - mic_c) * 6 + 10.3; anchor: right center; size: 13; weight: 500; family: "SF Pro Text:tnum"; color: sound_ink; opacity: 92% * smooth(0.35, 1, mic_c) }
  zone box mic_track { from: sound_ox + 40, sound_mic_y; size: 194, 22; cursor: pointer; active: sound_unfolded; label: "Microphone volume"; role: slider; value: "{round(mic_v * 100)} %" }
 }
 on press mic_hit { sound_keyed = false; emit audio_input_mute }
 on press mic_track { sound_keyed = false; sound_input_dragging = true; sound_input_requested = clamp((local.x - sound_ox - 40) / 194, 0, 1); emit audio_input_set(clamp((local.x - sound_ox - 40) / 194, 0, 1)) }
 on drag mic_track { emit sound_input_drag(clamp((local.x - sound_ox - 40) / 194, 0, 1)) }
 on release mic_track { emit sound_input_release }

 // Apps: up to three minis from the right of the tank; four rows to a page.
 for app in sound_apps {
  let a_p = app.index - sound_app_page * 4
  let a_mini = sound_app_page == 0 and app.index < 3
  let a_lag = pick(clamp(a_p, 0, 3), sound_lag.60, sound_lag.90, sound_lag.120, sound_lag.150)
  let a_k = clamp(a_lag, 0, 1)
  let a_m = if(a_mini, a_lag, 1)
  let a_c = if(a_mini, a_k, 1)
  let a_row = sound_app_y + 26 * a_p + if(a_mini, 0, (1 - a_k) * 8)
  let a_tank = 228 - 26 * (sound_minis - 1 - app.index)
  let a_v = if(sound_app_drag == app.index, sound_app_requested, clamp(app.volume, 0, 1))
  let a_sx = sound_ox + a_tank + (8 - a_tank) * a_m
  let a_sy = 160 + (a_row - 160) * a_m
  let a_tx = sound_ox + a_tank + 5 + (111 - a_tank) * a_m
  let a_ty = 179 + (a_row + 10 - 179) * a_m
  let a_tw = 14 + 104 * a_m
  let a_fh = 2 + 2 * a_c
  let a_bs = 0.3 + 0.7 * smooth(0.4, 1, a_c)
  group {
   show: a_p >= 0 and a_p < 4 and (a_mini or a_k > 0.001)
   opacity: if(app.muted, 38%, 100%) * if(a_mini, 1, smooth(0.3, 1, a_k))
   zone box a_hit { from: a_sx, a_sy; size: 24, 22; corner: 7; cursor: pointer; active: sound_unfolded; label: "Mute {app.name}" }
   box { from: a_sx, a_sy; size: 24, 22; corner: 7; color: sound_ink; opacity: a_c * max(a_hit.hover * 10%, a_hit.pressed * 16%) }
   image app.icon { at: a_sx + 5, a_sy + 4 - 1.5 * (1 - a_c); size: 14, 14 }
   box { from: a_tx, a_ty; size: a_tw, 2; corner: 1; color: sound_ink; opacity: 22% }
   box { from: a_tx, a_ty + 1 - a_fh / 2; size: a_tw * a_v, a_fh; corner: a_fh / 2; color: sound_ink; opacity: 92% + 8% * a_c; show: a_tw * a_v > 0.5 }
   box { from: a_tx + clamp(a_tw * a_v, 8 * a_bs, a_tw - 8 * a_bs) - 8 * a_bs, a_ty + 1 - 4 * a_bs; size: 16 * a_bs, 8 * a_bs; corner: 4 * a_bs; color: sound_ink; opacity: smooth(0.55, 1, a_c) }
   text app.name { at: sound_ox + 38, a_row + (1 - a_c) * 6 + 10.3; anchor: left center; width: 72; lines: 1; size: 13; weight: 500; family: "SF Pro Text:tnum"; color: sound_ink; opacity: 92% * smooth(0.35, 1, a_c) }
   text "{round(a_v * 100)}" { at: sound_ox + 266.5, a_row + (1 - a_c) * 6 + 10.3; anchor: right center; size: 13; weight: 500; family: "SF Pro Text:tnum"; color: sound_ink; opacity: 92% * smooth(0.35, 1, a_c) }
   zone box a_track { from: sound_ox + 116, a_row; size: 118, 22; cursor: pointer; active: sound_unfolded; label: "{app.name} volume"; role: slider; value: "{round(a_v * 100)} %" }
   on press a_hit { sound_keyed = false; emit audio_app_mute(app.id) }
   on press a_track { sound_keyed = false; sound_app_drag = app.index; sound_app_requested = clamp((local.x - sound_ox - 116) / 118, 0, 1); emit audio_app_set(app.index * 2 + clamp((local.x - sound_ox - 116) / 118, 0, 1)) }
   on drag a_track { emit sound_app_drag_to(app.index * 2 + clamp((local.x - sound_ox - 116) / 118, 0, 1)) }
   on release a_track { emit sound_app_release }
  }
 }
 let sound_app_k = clamp(sound_lag.150, 0, 1)
 let sound_app_pages = max(1, ceil(sound_apps.count / 4))
 let sound_app_pager_y = sound_app_y + 26 * sound_app_rows + (1 - sound_app_k) * 8
 group {
  show: sound_app_pager == 1 and sound_app_k > 0.001
  opacity: smooth(0.3, 1, sound_app_k)
  text "{sound_app_page + 1} of {sound_app_pages}" { at: sound_ox + 38, sound_app_pager_y + 10.3; anchor: left center; size: 11; weight: 500; family: "SF Pro Text:tnum"; color: sound_ink; opacity: 60% }
  zone box sound_app_prev { from: sound_ox + sound_w - 64, sound_app_pager_y; size: 24, 22; corner: 7; cursor: pointer; active: sound_unfolded and sound_app_page > 0; label: "Previous apps" }
  zone box sound_app_next { from: sound_ox + sound_w - 38, sound_app_pager_y; size: 24, 22; corner: 7; cursor: pointer; active: sound_unfolded and sound_app_page + 1 < sound_app_pages; label: "More apps" }
  box { from: sound_ox + sound_w - 64, sound_app_pager_y; size: 24, 22; corner: 7; color: sound_ink; opacity: max(sound_app_prev.hover * 10%, sound_app_prev.pressed * 16%) }
  box { from: sound_ox + sound_w - 38, sound_app_pager_y; size: 24, 22; corner: 7; color: sound_ink; opacity: max(sound_app_next.hover * 10%, sound_app_next.pressed * 16%) }
  text "‹" { at: sound_ox + sound_w - 52, sound_app_pager_y + 10; anchor: center; size: 16; family: "SF Pro Text"; color: sound_ink; opacity: if(sound_app_page > 0, 92%, 38%) }
  text "›" { at: sound_ox + sound_w - 26, sound_app_pager_y + 10; anchor: center; size: 16; family: "SF Pro Text"; color: sound_ink; opacity: if(sound_app_page + 1 < sound_app_pages, 92%, 38%) }
 }
 on press sound_app_prev { sound_app_page = max(0, sound_app_page - 1) }
 on press sound_app_next { sound_app_page = min(sound_app_pages - 1, sound_app_page + 1) }
}
