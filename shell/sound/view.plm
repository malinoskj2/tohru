part SoundView {
 let sound_button_x = sound_x + 12
 zone box sound_button { from: sound_x, 4; size: 24, 22; corner: 7; cursor: pointer; label: "Sound" }
 box { from: sound_x, 4; size: 24, 22; corner: 7; color: #ffffff; opacity: max(sound_open * 16%, max(sound_button.hover * 10%, sound_button.pressed * 16%)) }
 image sound_glyph_x { at: round(sound_x + 5), 8; size: 14, 14; tint: #ffffff; opacity: 92%; show: audio.muted or audio.volume < 0.005 }
 image sound_glyph_1 { at: round(sound_x + 5), 8; size: 14, 14; tint: #ffffff; opacity: 92%; show: not audio.muted and audio.volume >= 0.005 and audio.volume < 0.5 }
 image sound_glyph_2 { at: round(sound_x + 5), 8; size: 14, 14; tint: #ffffff; opacity: 92%; show: not audio.muted and audio.volume >= 0.5 }
 on press sound_button { emit sound_toggle }
 on scroll sound_button { emit audio_step(wheel) }
 // Native popup position is in the parent bar's coordinates and slides to fit.

 on key Escape while sound_open { emit panel_close }
 on key Tab while sound_open { emit sound_fold_toggle }
 on key m while sound_open { emit audio_mute }
 on key Left while sound_open and not sound_unfolded { emit audio_step(-1) }
 on key Right while sound_open and not sound_unfolded { emit audio_step(1) }
 on key Down while sound_open and not sound_unfolded { emit audio_step(-1) }
 on key Up while sound_open and not sound_unfolded { emit audio_step(1) }
 on key Return while sound_open and not sound_unfolded { emit audio_mute }
 on key space while sound_open and not sound_unfolded { emit audio_mute }
 on key Left while sound_open and sound_unfolded { emit sound_focus_step(-1) }
 on key Right while sound_open and sound_unfolded { emit sound_focus_step(1) }
 on key Up while sound_open and sound_unfolded { emit sound_focus_move(-1) }
 on key Down while sound_open and sound_unfolded { emit sound_focus_move(1) }
 on key Return while sound_open and sound_unfolded { emit sound_focus_activate }
 on key space while sound_open and sound_unfolded { emit sound_focus_activate }
 on key Prior while sound_open and sound_unfolded { emit sound_page(-1) }
 on key Next while sound_open and sound_unfolded { emit sound_page(1) }
}
