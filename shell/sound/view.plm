part SoundView {
 let sound_button_x = screen.width - 166
 box sound_button { at: sound_button_x, 15.5; size: 28, 27; corner: 13.5; color: #89dceb; opacity: sound_open * 18%; cursor: pointer }
 image sound_speaker { at: sound_button_x - 8, 7.5; size: 16, 16; tint: #cdd6f4; show: not audio.muted }
 image sound_muted { at: sound_button_x - 8, 7.5; size: 16, 16; tint: #cdd6f4; show: audio.muted }
 on press sound_button { emit sound_toggle }
 on scroll sound_button { emit audio_step(wheel) }
 // Native popup position is in the parent bar's coordinates and slides to fit.

 on change audio.volume { emit audio_report }
 on change audio.muted { emit audio_report }
 on change sound_outputs.count { emit audio_report }
 on key Escape while sound_open { emit panel_close }
 on key Tab while sound_open { sound_focus = 1 - sound_focus }
 on key Left while sound_open { emit audio_step(-1) }
 on key Right while sound_open { emit audio_step(1) }
 on key Down while sound_open { emit audio_step(-1) }
 on key Up while sound_open { emit audio_step(1) }
 on key space while sound_open and sound_focus == 0 { emit audio_mute }
 on key Return while sound_open and sound_focus == 0 { emit audio_mute }
}
