part SoundView {
 let sound_button_x = screen.width - 324
 box sound_button { at: sound_button_x, 15.5; size: 28, 27; corner: 13.5; color: #89dceb; opacity: sound_open * 18%; cursor: pointer }
 image sound_speaker { at: sound_button_x - 8, 7.5; size: 16, 16; tint: #cdd6f4; show: not audio.muted }
 image sound_muted { at: sound_button_x - 8, 7.5; size: 16, 16; tint: #cdd6f4; show: audio.muted }
 on press sound_button { emit sound_toggle }
 on scroll sound_button { emit audio_step(wheel) }
 // Native popup position is in the parent bar's coordinates and slides to fit.

 on key Tab while sound_open and sound_details { emit sound_tab_next }
 on key Left while sound_open and sound_details { emit sound_details_step(-1) }
 on key Right while sound_open and sound_details { emit sound_details_step(1) }
 on key Up while sound_open and sound_details and sound_tab != 1 { emit sound_row_move(-1) }
 on key Down while sound_open and sound_details and sound_tab != 1 { emit sound_row_move(1) }
 on key Up while sound_open and sound_details and sound_tab == 1 { emit sound_details_step(1) }
 on key Down while sound_open and sound_details and sound_tab == 1 { emit sound_details_step(-1) }
 on key Prior while sound_open and sound_details { emit sound_list_page(-1) }
 on key Next while sound_open and sound_details { emit sound_list_page(1) }
 on key Return while sound_open and sound_details { emit sound_details_activate }
 on key space while sound_open and sound_details { emit sound_details_activate }
 on key Escape while sound_open { emit panel_close }
 on key Tab while sound_open and not sound_details { sound_focus = 1 - sound_focus }
 on key Left while sound_open and not sound_details { emit audio_step(-1) }
 on key Right while sound_open and not sound_details { emit audio_step(1) }
 on key Down while sound_open and not sound_details { emit audio_step(-1) }
 on key Up while sound_open and not sound_details { emit audio_step(1) }
 on key space while sound_open and not sound_details and sound_focus == 0 { emit audio_mute }
 on key Return while sound_open and not sound_details and sound_focus == 0 { emit audio_mute }
}
