part NetworkState {
    // Root measured button center; negative uses the native screen-relative default.
    prop net_button_x = -1 ~0ms
    fact net_open = false
    fact net_unfolded = false
    // The unfolded view: 0 Wi-Fi, 1 Ethernet. The compact tile the keyboard is on, and whether it is shown.
    fact net_view = 0
    fact net_focus = 0
    fact net_keyed = false
    // The Wi-Fi power switch's stop: the reported power, or the one just asked for until it is reported.
    fact net_power_stop = 0
    fact net_page = 0
    fact net_selected = -1
    fact net_joining = false
    fact net_target_active = false
    fact net_target_known = false
    fact net_has_request = false
    text net_request = ""
    text net_target = ""
    text net_password = ""
    model net_rows max 64 { ssid: text; strength: number; secure: bool; known: bool; active: bool }
    service network as net { online: bool; kind: none | wired | wifi; name: text; strength: number; wifi: bool; error: text; networks: net_rows }
    event network_toggle ->
    event network_open ->
    event network_close ->
    event network_open_view ->
    event network_view ->
    event network_fold ->
    event network_focus_move ->
    event network_select ->
    event network_join ->
    event network_cancel ->
    event network_scan ->
    event network_power ->
    event network_power_press ->
    event network_power_drag ->
    event network_power_release ->
    event network_observed ->
    event network_disconnect ->
    event network_disconnect_active ->
    event network_forget ->
    event network_forget_row ->
    event network_move ->
    event network_activate ->
    event network_page ->

    image net_wifi_full = file "../service-assets/wifi-filled.svg", 14, 14
    image net_wifi_high = file "../service-assets/wifi-high-filled.svg", 14, 14
    image net_wifi_low = file "../service-assets/wifi-low-filled.svg", 14, 14
    image net_wifi_zero = file "../service-assets/wifi-zero-filled.svg", 14, 14
    image net_wifi_off = file "../service-assets/wifi-off-filled.svg", 14, 14
    image net_ethernet = file "../service-assets/ethernet-port-filled.svg", 14, 14
    image net_scan_icon = file "scan.svg", 14, 14
    image net_lock_icon = file "lock.svg", 11, 11

    // 0 is the two compact tiles, 1 the unfolded view. Same spring as sound_fold.
    prop net_fold = 0 ~spring(196, 21.84)
    on change net_unfolded { net_fold: if(net_unfolded, 1, 0) }
    let net_fc = clamp(net_fold, 0, 1)
    // 0 is the Wi-Fi view, 1 Ethernet: the segment's thumb, the views' crossfade and the height follow it.
    prop net_view_k = 0 ~spring(196, 21.84)
    on change net_view { net_view_k: net_view }
    let net_vk = clamp(net_view_k, 0, 1)

    let net_wired = net.online and net.kind == wired
    let net_wifi_connected = net.online and net.kind == wifi
    on change net.wifi { emit network_observed }

    on change net_open {
        net_fold: if(net_unfolded, 1, 0) ~0ms
        net_view_k: net_view ~0ms
    }

    // Wi-Fi view height: header (48) + up to 7 rows (28 each) + optional pager (26) + footer (38).
    let net_pages = max(1, ceil(net_rows.count / 7))
    let net_page_rows = max(0, min(7, net_rows.count - net_page * 7))
    let net_pager_shown = if(net_rows.count > 7 and not net_joining, 1, 0)
    let net_list_end = 52 + max(1, net_page_rows) * 28
    let net_wifi_h = if(net_joining, 224, net_list_end + net_pager_shown * 26 + 38)
    // Ethernet view height: header and the connection card (62), with a taller footer for a request.
    let net_eth_h = if(net_has_request, 152, 136)
    let net_open_h = mix(net_wifi_h, net_eth_h, net_vk)
    // Compact: the two 64 px tiles with 10 px around them.
    let net_compact_h = 84
    let net_w = 272 + 16 * net_fold
    let net_h = net_compact_h + (net_open_h - net_compact_h) * net_fold
}
