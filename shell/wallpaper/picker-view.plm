part WallpaperPickerView {
        group {
            show: wallpaper_picker_open
            text "Wallpaper" { at: 0, 0; size: 20; weight: 600; color: #cdd6f4 }
            input wallpaper_picker_folder { at: 0, 42; width: 450; size: 12; color: #cdd6f4; placeholder: "Absolute wallpaper folder"; label: "Wallpaper folder" }
            box wallpaper_folder_load { from: 460, 24; size: 80, 32; corner: 7; color: #313244; cursor: pointer }
            text "Load" { at: 500, 40; anchor: center; size: 12; color: #cdd6f4 }
            box wallpaper_output_previous { from: 0, 64; size: 28, 28; corner: 6; color: #313244; cursor: pointer }
            box wallpaper_output_next { from: 512, 64; size: 28, 28; corner: 6; color: #313244; cursor: pointer }
            text "‹" { at: 14, 78; anchor: center; size: 22; color: #cdd6f4 }
            text "›" { at: 526, 78; anchor: center; size: 22; color: #cdd6f4 }
            text wallpaper_picker_output { at: 38, 78; anchor: left center; width: 462; lines: 1; size: 13; color: #cdd6f4 }
            text wallpaper_picker_current { at: 0, 106; anchor: left center; width: 540; lines: 1; size: 10; color: #a6adc8 }
            input wallpaper_picker_search { at: 0, 138; width: 540; size: 12; color: #cdd6f4; placeholder: "Filter files"; label: "Filter wallpapers" }
            column wallpaper_file_list { at: 0, 154; gap: 3
                for file in wallpaper_picker_files {
                    group {
                        size: 540, 30
                        box hit { from: 0, 0; size: 540, 30; corner: 6; color: #313244; cursor: pointer }
                        box { from: 0, 0; size: 540, 30; corner: 6; stroke: if(file.row_id == wallpaper_picker_selected, 1, 0); color: #b4befe }
                        text file.name { at: 10, 15; anchor: left center; width: 420; lines: 1; size: 12; color: #cdd6f4 }
                        text file.kind { at: 454, 15; anchor: left center; size: 10; color: #a6adc8 }
                        text "✓" { at: 520, 15; anchor: center; size: 13; color: #a6e3a1; show: file.current }
                        on press hit { emit wallpaper_picker_choose(file.row_id) }
                    }
                }
            }
            text wallpaper_picker_count { at: 0, 432; anchor: left center; size: 11; color: #a6adc8 }
            box wallpaper_page_previous { from: 340, 418; size: 96, 28; corner: 6; color: #313244; cursor: pointer; active: wallpaper_picker_previous }
            box wallpaper_page_next { from: 444, 418; size: 96, 28; corner: 6; color: #313244; cursor: pointer; active: wallpaper_picker_next }
            text "Previous" { at: 388, 432; anchor: center; size: 11; color: #cdd6f4 }
            text "Next" { at: 492, 432; anchor: center; size: 11; color: #cdd6f4 }
            box wallpaper_shuffle_one { from: 0, 456; size: 170, 30; corner: 6; color: #313244; cursor: pointer }
            box wallpaper_shuffle_all { from: 180, 456; size: 170, 30; corner: 6; color: #313244; cursor: pointer }
            box wallpaper_remove { from: 360, 456; size: 180, 30; corner: 6; color: #313244; cursor: pointer }
            text "Randomize output" { at: 85, 471; anchor: center; size: 11; color: #cdd6f4 }
            text "Randomize saved" { at: 265, 471; anchor: center; size: 11; color: #cdd6f4 }
            text "Clear assignment" { at: 450, 471; anchor: center; size: 11; color: #cdd6f4 }
            text wallpaper_picker_error { at: 0, 500; anchor: left top; width: 540; lines: 2; size: 11; color: #f38ba8 }
            on press wallpaper_folder_load { emit wallpaper_picker_folder_submit }
            on submit wallpaper_picker_folder { emit wallpaper_picker_folder_submit }
            on press wallpaper_output_previous { emit wallpaper_picker_output(-1) }
            on press wallpaper_output_next { emit wallpaper_picker_output(1) }
            on press wallpaper_page_previous { emit wallpaper_picker_page(-1) }
            on press wallpaper_page_next { emit wallpaper_picker_page(1) }
            on press wallpaper_shuffle_one { emit wallpaper_picker_randomize }
            on press wallpaper_shuffle_all { wallpaper_randomize_outputs = ""; emit wallpaper_randomize }
            on press wallpaper_remove { emit wallpaper_picker_clear }
            on submit wallpaper_picker_search { emit wallpaper_picker_accept }
        }
    on key Escape while wallpaper_picker_open and wallpaper_picker_keyboard { wallpaper_picker_open = false; emit wallpaper_picker_close }
    on key Down while wallpaper_picker_open and wallpaper_picker_keyboard { emit wallpaper_picker_move(1) }
    on key Up while wallpaper_picker_open and wallpaper_picker_keyboard { emit wallpaper_picker_move(-1) }
}
