language 0.4
scene TohruPolkit {
    surface { size: 480, 292; anchor: center; keyboard: exclusive while auth.pending }
    permissions { services: "polkit", "polkit.*" }
    service polkit as auth {
        ready: bool
        pending: bool
        asking: bool
        message: text
        action: text
        icon: text
        user: text
        prompt: text
        secret: bool
        info: text
        error: none | wrong
    }
    text answer = ""
    text status = ""
    fact answering = false
    event cancel_request ->
    box { from: 0, 0; size: 480, 292; corner: 26; color: #201a21; glass: 100%; show: auth.pending }
    text "Authentication Required" { at: 24, 28; anchor: left center; size: 17; color: #f5f5f5; show: auth.pending }
    text auth.message { at: 24, 52; width: 432; lines: 3; size: 13; color: #f5f5f5; show: auth.pending }
    text "{auth.prompt} {auth.user}" { at: 24, 121; anchor: left center; size: 13; color: #d4c8d4; show: auth.pending }
    box { at: 240, 158; size: 432, 38; corner: 19; color: #100c12; show: auth.asking }
    input answer { at: 38, 146; width: 404; size: 15; color: #f5f5f5; secret: true; show: auth.asking; agent: no }
    text "Password not accepted" { at: 24, 192; anchor: left center; size: 12; color: #ffc0bf; show: auth.error == wrong }
    text auth.info { at: 24, 208; anchor: left center; size: 12; color: #d4c8d4; show: auth.pending }
    text status { at: 24, 224; anchor: left center; size: 12; color: #ffc0bf; show: auth.pending }
    box cancel_button { at: 240, 258; size: 112, 28; corner: 9; color: #514851; cursor: pointer; show: auth.pending }
    text "Cancel" { at: 240, 258; anchor: center; size: 13; color: #f5f5f5; show: auth.pending }
    box accept_button { at: 382, 258; size: 140, 28; corner: 9; color: #bb6f9a; cursor: pointer; show: auth.asking; agent: no }
    text "Authenticate" { at: 382, 258; anchor: center; size: 13; color: #ffffff; show: auth.asking }
    on press cancel_button { emit cancel_request }
    on press accept_button { emit answer_request }
    event answer_request ->
}
