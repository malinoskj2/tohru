part RootServiceControls {
    image root_ethernet = file "service-assets/ethernet-port-filled.svg", 14, 14
    image root_wifi = file "service-assets/wifi-filled.svg", 14, 14
    image root_wifi_high = file "service-assets/wifi-high-filled.svg", 14, 14
    image root_wifi_low = file "service-assets/wifi-low-filled.svg", 14, 14
    image root_wifi_zero = file "service-assets/wifi-zero-filled.svg", 14, 14
    image root_wifi_off = file "service-assets/wifi-off-filled.svg", 14, 14
    image root_bluetooth = file "service-assets/bluetooth.svg", 14, 14
    image root_info = file "service-assets/info-filled.svg", 14, 14
    image root_play = file "service-assets/play-filled.svg", 14, 14
    let bar_ink = #ffffff
    let root_net_x = clock_x - 26
    let sound_x = root_net_x - 26
    let bell_x = sound_x - 26
    let root_left = 112 + if(bar_mooncoil, 29, 0) + if(ws_available, ws_width, 0) + 14
    let root_about_slot = if(bar_info_button, 3, 2)
    let root_extra = clamp(floor((bell_x - 2 - root_left) / 26), 0, 1 + if(bar_info_button, 1, 0) + if(bar_about_button, 1, 0))
    let root_bt_x = bell_x - 26
    let root_info_x = bell_x - 52
    let root_about_x = bell_x - root_about_slot * 26
    let root_tray_x = bell_x - root_extra * 26
    let media_text_w = min(160, bar_media_measure.width)
    let media_w = media_text_w + 30
    let media_x = root_tray_x - 2 - media_w
    let root_title_limit = min(360, max(0, 2 * min(screen.width / 2 - root_left, root_tray_x - 14 - screen.width / 2)))
    let root_title_width = min(root_title_limit, bar_title_measure.width + if(bar_has_icon and root_title_limit >= 21, 20, 0))
    let media_room = root_tray_x - 2 - max(root_left, screen.width / 2 + root_title_width / 2 + 14)
    let media_shown = bar_playing and media_room >= media_w
    follow bar_title_cap = root_title_limit
    follow net_button_x = root_net_x + 12
    follow bt_button_x = root_bt_x + 12

    box { from: media_x, 4; size: media_w, 22; corner: 7; color: bar_ink; opacity: 10%; show: media_shown }
    image root_play { at: round(media_x + 5), 8; size: 14, 14; tint: bar_ink; opacity: 92%; show: media_shown }
    text bar_media { at: media_x + 25, 15.5; anchor: left center; width: 160; lines: 1; tight: true; measure: bar_media_measure; size: 13; family: "SF Pro Text"; color: bar_ink; opacity: 92%; show: media_shown }

    zone box root_network { from: root_net_x, 4; size: 24, 22; corner: 7; cursor: pointer; label: "Network" }
    box { from: root_net_x, 4; size: 24, 22; corner: 7; color: bar_ink; opacity: max(root_network.hover * 10%, root_network.pressed * 16%) }
    image root_ethernet { at: round(root_net_x + 5), 8; size: 14, 14; tint: bar_ink; opacity: if(net.online, 92%, 38%); show: net.kind == wired }
    image root_wifi { at: round(root_net_x + 5), 8; size: 14, 14; tint: bar_ink; opacity: 92%; show: net.kind != wired and net.wifi and net.online and net.strength >= 60 }
    image root_wifi_high { at: round(root_net_x + 5), 8; size: 14, 14; tint: bar_ink; opacity: 92%; show: net.kind != wired and net.wifi and net.online and net.strength >= 35 and net.strength < 60 }
    image root_wifi_low { at: round(root_net_x + 5), 8; size: 14, 14; tint: bar_ink; opacity: 92%; show: net.kind != wired and net.wifi and net.online and net.strength >= 15 and net.strength < 35 }
    image root_wifi_zero { at: round(root_net_x + 5), 8; size: 14, 14; tint: bar_ink; opacity: if(net.online, 92%, 38%); show: net.kind != wired and net.wifi and (not net.online or net.strength < 15) }
    image root_wifi_off { at: round(root_net_x + 5), 8; size: 14, 14; tint: bar_ink; opacity: 38%; show: net.kind != wired and not net.wifi }
    on press root_network { emit network_toggle }

    zone box root_bluetooth_hit { from: root_bt_x, 4; size: 24, 22; corner: 7; active: root_extra >= 1; cursor: pointer; label: "Bluetooth" }
    box { from: root_bt_x, 4; size: 24, 22; corner: 7; color: bar_ink; opacity: max(root_bluetooth_hit.hover * 10%, root_bluetooth_hit.pressed * 16%); show: root_extra >= 1 }
    image root_bluetooth { at: round(root_bt_x + 5), 8; size: 14, 14; tint: bar_ink; opacity: if(bt.powered, 92%, 38%); show: root_extra >= 1 }
    on press root_bluetooth_hit { emit bluetooth_toggle }

    zone box root_information { from: root_info_x, 4; size: 24, 22; corner: 7; active: bar_info_button and root_extra >= 2; cursor: pointer; label: "System information" }
    box { from: root_info_x, 4; size: 24, 22; corner: 7; color: bar_ink; opacity: max(root_information.hover * 10%, root_information.pressed * 16%); show: bar_info_button and root_extra >= 2 }
    image root_info { at: round(root_info_x + 5), 8; size: 14, 14; tint: bar_ink; opacity: 92%; show: bar_info_button and root_extra >= 2 }
    on press root_information { emit info_toggle }

    zone box root_about { from: root_about_x, 4; size: 24, 22; corner: 7; active: bar_about_button and root_extra >= root_about_slot; cursor: pointer; label: "About Tohru" }
    box { from: root_about_x, 4; size: 24, 22; corner: 7; color: bar_ink; opacity: max(root_about.hover * 10%, root_about.pressed * 16%); show: bar_about_button and root_extra >= root_about_slot }
    image bar_mark { at: round(root_about_x + 4.5), 8; size: 15, 15; tint: bar_ink; opacity: 92%; show: bar_about_button and root_extra >= root_about_slot }
    on press root_about { emit about_toggle }
}
