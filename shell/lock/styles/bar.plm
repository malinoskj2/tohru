part LockBar {
 // The bar as it was, drawn by the lock: the real one is under the lock surface and cannot show.
 let lb_slot = clamp(ws_active, 1, max(1, ws_count))
 let lb_f = clamp((lb_slot - 1) * 16 / 64, 0, 1)
 group {
  show: style >= 1 and not is_greeter
  opacity: pick(style, 0, 0.92, 1, 1, 1, 1, 1, 1, 1, 1, 0.95)
  body {
   gradient: 0, 0 to 0, 31, #140a1e, #140a1e
   opacity: 36%
   box { from: 100, 0; size: 1720, 31; corner: 10 }
   box { from: 100, 0; size: 1720, 21 }
  }
  shader lock_bar_fill { at: 100, -10; size: 1720, 41; corner: 10; values: 0.18, 0.06, 9, 0.14 * 0.36; colors: #140a1e, #140a1e }
  path {
   stroke: 0.55; color: #ffffff; opacity: 27.65%
   move 92.5, -0.5
   curve 98.157, 1.843 via 95.814, -0.5
   curve 100.5, 7.5 via 100.5, 4.186
   line 100.5, 21
   curve 103.283, 27.717 via 100.5, 24.935
   curve 110, 30.5 via 106.065, 30.5
   line 1810, 30.5
   curve 1816.717, 27.717 via 1813.935, 30.5
   curve 1819.5, 21 via 1819.5, 24.935
   line 1819.5, 7.5
   curve 1821.843, 1.843 via 1819.5, 4.186
   curve 1827.5, -0.5 via 1824.186, -0.5
  }
  shader lock_ribbon { at: 100, -6; size: max(5, ws_count) * 16 + 24, 42; values: (lb_slot - 1) * 16 + 8, 0, 2, (lb_slot - 1) * 16 + 8, 0, 0, (lb_slot - 1) * 16 + 8, 1; colors: if(lb_f < 0.25, mix(st0, st1, lb_f * 4), if(lb_f < 0.5, mix(st1, st2, lb_f * 4 - 1), if(lb_f < 0.75, mix(st2, st3, lb_f * 4 - 2), mix(st3, st4, lb_f * 4 - 3)))), #ffffff }
  text "{date_bar}   {clock_hm}" { at: 1803, 15.5; anchor: right center; size: 13; weight: 500; family: "SF Pro Text:tnum"; color: #ffffff; opacity: 92% }
  image lock_i_wifi { at: 1689, 8; size: 14, 14; tint: #ffffff; opacity: 92% }
  image lock_i_volume { at: 1663, 8; size: 14, 14; tint: #ffffff; opacity: 92% }
  image lock_i_bell { at: 1637, 8; size: 14, 14; tint: #ffffff; opacity: 92% }
  image lock_i_bluetooth { at: 1611, 8; size: 14, 14; tint: #ffffff; opacity: 92% }
 }
}
