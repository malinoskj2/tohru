part LockUnfoldingGlassCapsule {
 // Folded it is a clock pill; a key unfolds it into the field, what is playing and the power rows.
 let uc_f = wake * clamp(1 - unlock * 1.55, 0, 1)
 let uc_w = 340 + 40 * uc_f
 let uc_h = 128 + 168 * uc_f
 let uc_x = 960 - uc_w / 2 + shake * 0.27
 let uc_y = 470 - uc_h / 2 - unlock * 36
 let uc_rows = clamp((uc_f - 0.25) / 0.6, 0, 1)
 let uc_bw = (uc_w - 44) / 2
 group {
  show: style == 5
  opacity: 1 - pow(unlock, 1.6)
  body {
   color: #000000
   opacity: 1%
   shadow: 0, 6, 24, if(pk > 0.5, 11%, 28%)
   box { from: uc_x, uc_y; size: uc_w, uc_h; corner: 15 }
  }
  shader lock_glass { at: uc_x, uc_y; size: uc_w, uc_h; values: 0.55 + 0.25 * uc_f, 0.92, 0.9, err * 0.55, pk, 15, 0, 0 }
  box { from: uc_x + 0.5, uc_y + 0.5; size: uc_w - 1, uc_h - 1; corner: 14.5; stroke: if(wrong, 1, 0.9); color: if(wrong, err_c, ink); opacity: if(wrong, 0.55 * err + 0.12, if(pk > 0.5, 12%, 18%)) }
  group {
   pivot: uc_x + 22, uc_y + 52 - 10 * uc_f
   scale: (72 - 30 * uc_f) / 72
   text clock_hm { at: uc_x + 22, uc_y + 52 - 10 * uc_f; anchor: left center; size: 72; weight: 200; family: "SF Pro Display:tnum"; color: ink; opacity: 94%; letter_move: -2 * letter, 0 }
  }
  text date_short { at: uc_x + uc_w - 22, uc_y + 34 - 4 * uc_f; anchor: right center; size: 13; weight: 500; family: "SF Pro Text"; color: ink; opacity: 86% }
  text user { at: uc_x + uc_w - 42, uc_y + 54 - 4 * uc_f; anchor: right center; size: 12; family: "SF Pro Text"; color: ink; opacity: 56% }
  image lock_i_down { at: uc_x + uc_w - 36, uc_y + 47 - 4 * uc_f; size: 14, 14; tint: ink; opacity: 58%; show: uc_f <= 0.5 }
  image lock_i_up { at: uc_x + uc_w - 36, uc_y + 47 - 4 * uc_f; size: 14, 14; tint: ink; opacity: 58%; show: uc_f > 0.5 }
  text "Type or click to unfold" { at: uc_x + 22, uc_y + uc_h - 22; anchor: left center; size: 12; family: "SF Pro Text"; color: ink; opacity: 46% * clamp(1 - uc_f * 5, 0, 1); show: uc_f < 0.2 }
  zone box lock_unfold { from: uc_x, uc_y; size: uc_w, 80; active: style == 5 and uc_f < 0.5 and not unlocking; cursor: pointer; label: "Unfold" }
  group {
   show: uc_rows > 0.001
   opacity: uc_rows
   clip box { from: uc_x, uc_y; size: uc_w, uc_h; corner: 15 }
   box { from: uc_x + 18, uc_y + 82; size: uc_w - 36, 1; color: ink; opacity: 10% }
   box { from: uc_x + 18, uc_y + 98; size: uc_w - 36, 38; corner: 10; color: ink; opacity: 8% }
   box { from: uc_x + 18.5, uc_y + 98.5; size: uc_w - 37, 37; corner: 9.5; stroke: 1; color: if(wrong, err_c, ink); opacity: if(wrong, 78%, 16%) }
   LockDots(uc_x + 44, uc_y + 117, 3.8, 14, 1, 0.92, 1)
   text "Password" { at: uc_x + 36, uc_y + 117; anchor: left center; size: 13; family: "SF Pro Text"; color: ink; opacity: 40%; show: typed == 0 and not checking }
   box { from: uc_x + uc_w - 48, uc_y + 104; size: 24, 26; corner: 7; color: ink; opacity: 10% }
   image lock_i_arrow { at: uc_x + uc_w - 43, uc_y + 110; size: 14, 14; tint: ink; opacity: 85% }
   text "NOW PLAYING" { at: uc_x + 20, uc_y + 154; anchor: left center; size: 11; weight: 500; family: "SF Pro Text"; color: ink; opacity: 48% }
   image lock_i_play { at: uc_x + 20, uc_y + 169; size: 13, 13; tint: ink; opacity: 82%; show: media_known }
   text media_title { at: uc_x + 40, uc_y + 176; anchor: left center; width: uc_w - 180; lines: 1; size: 13; weight: 500; family: "SF Pro Text"; color: ink; opacity: 90%; show: media_known }
   text "Nothing playing" { at: uc_x + 20, uc_y + 176; anchor: left center; size: 13; family: "SF Pro Text"; color: ink; opacity: 50%; show: not media_known }
   shader lock_ribbon { at: uc_x + uc_w - 124, uc_y + 155; size: 112, 42; values: 44, 0, 2, 44, 0, 0, 44, 1; colors: mix(st2, st3, 0.48), #ffffff }
   box { from: uc_x + 18, uc_y + 232; size: uc_bw, 36; corner: 9; color: ink; opacity: 7% }
   image lock_i_moon { at: uc_x + 32, uc_y + 243; size: 14, 14; tint: ink; opacity: 78% }
   text "Sleep" { at: uc_x + 54, uc_y + 250.5; anchor: left center; size: 13; weight: 500; family: "SF Pro Text"; color: ink; opacity: 86% }
   box { from: uc_x + 26 + uc_bw, uc_y + 232; size: uc_bw, 36; corner: 9; color: if(restart_armed, err_c, ink); opacity: if(restart_armed, 22%, 7%) }
   image lock_i_restart { at: uc_x + 40 + uc_bw, uc_y + 243; size: 14, 14; tint: ink; opacity: 78% }
   text "Restart…" { at: uc_x + 62 + uc_bw, uc_y + 250.5; anchor: left center; size: 13; weight: 500; family: "SF Pro Text"; color: ink; opacity: 86%; show: not restart_armed }
   text "Click to restart" { at: uc_x + 62 + uc_bw, uc_y + 250.5; anchor: left center; size: 13; weight: 500; family: "SF Pro Text"; color: ink; opacity: 92%; show: restart_armed }
  }
  zone box lock_sleep { from: uc_x + 18, uc_y + 232; size: uc_bw, 36; active: style == 5 and uc_rows > 0.9 and not unlocking; cursor: pointer; label: "Sleep" }
  zone box lock_restart { from: uc_x + 26 + uc_bw, uc_y + 232; size: uc_bw, 36; active: style == 5 and uc_rows > 0.9 and not unlocking; cursor: pointer; label: "Restart" }
  on press lock_unfold { awake = true }
  on press lock_sleep { emit lock_sleep }
  on press lock_restart { emit lock_restart }
  group {
   show: wrong
   opacity: err
   body {
    color: #000000
    opacity: 1%
    shadow: 0, 6, 24, if(pk > 0.5, 11%, 28%)
    box { from: uc_x, uc_y + uc_h + 8; size: uc_w, 48; corner: 15 }
   }
   shader lock_glass { at: uc_x, uc_y + uc_h + 8; size: uc_w, 48; values: 0.4, 0.92, 0.9, 0.85, pk, 15, 0, 0 }
   box { from: uc_x + 0.5, uc_y + uc_h + 8.5; size: uc_w - 1, 47; corner: 14.5; stroke: 1; color: err_c; opacity: 59% }
   text "Authentication failed" { at: uc_x + 18, uc_y + uc_h + 26; anchor: left center; size: 12; weight: 600; family: "SF Pro Text"; color: err_c; opacity: 96% }
   text "Incorrect password for {user}" { at: uc_x + 18, uc_y + uc_h + 42; anchor: left center; size: 11; family: "SF Pro Text"; color: ink; opacity: 78%; show: lock_auth != 4 }
   text status { at: uc_x + 18, uc_y + uc_h + 42; anchor: left center; size: 11; family: "SF Pro Text"; color: ink; opacity: 78%; show: lock_auth == 4 }
  }
 }
}
