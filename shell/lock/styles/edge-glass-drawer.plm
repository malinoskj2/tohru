part LockEdgeGlassDrawer {
 // The wallpaper first; a key slides a glass blade in from the right edge with the field on it.
 let ed_open = wake * clamp(1 - unlock * 1.25, 0, 1)
 let ed_x = 1920 - 384 * ed_open + shake * 0.4
 let ed_goal = if(unlocking, 290, if(wrong, 28, if(typed == 0, 14, min(300, 30 + typed * 22))))
 prop ed_bead = 14 ~spring(160, 13.9)
 follow ed_bead = ed_goal
 prop ed_amp = 0 ~spring(220, 23.7)
 follow ed_amp = min(2.4, abs(vel(ed_bead)) * 0.03) + kick * 0.1
 prop ed_t = 0 ~0ms
 spin ed_t by 1
 let ed_f = clamp(ed_bead / 316, 0, 1)
 group {
  show: style == 6
  group {
   opacity: clamp(1 - unlock * 1.1, 0, 1)
   move: 0, unlock * 24
   group {
    show: pk < 0.5
    blur: 80
    ellipse { at: 240, 920; radius: 230; color: #0e0a16; opacity: 44% }
   }
   text clock_hm { at: 104, 906; anchor: left center; size: 118; weight: 200; family: "SF Pro Display:tnum"; color: ink; opacity: 95%; letter_move: -3.5 * letter, 0 }
   text date_long { at: 108, 976; anchor: left center; size: 16; weight: 500; family: "SF Pro Text"; color: ink; opacity: 72% }
  }
  group {
   show: ed_open < 0.02
   box { from: 1913, 512; size: 3, 56; corner: 1.5; color: ink; opacity: 35% }
   text "Type to slide unlock drawer" { at: 1898, 544; anchor: right center; size: 12; family: "SF Pro Text"; color: ink; opacity: 52% }
  }
  group {
   show: ed_open > 0.01
   body {
    color: #000000
    opacity: 1%
    shadow: -6, 0, 24, if(pk > 0.5, 11%, 28%)
    box { from: ed_x, 0; size: 414, 1080 }
   }
   shader lock_glass { at: ed_x, 0; size: 414, 1080; values: 0.72, 0.92, 0.9, err * 0.65, pk, 0, 0, 0 }
   box { from: ed_x + 0.5, -2; size: 1, 1084; color: if(wrong, err_c, ink); opacity: if(wrong, 82%, if(pk > 0.5, 14%, 20%)) }
   group {
    opacity: min(1, ed_open * 1.25)
    UserAvatar(ed_x + 54, 444, 40)
    text user { at: if(has_avatar, ed_x + 86, ed_x + 34), 434; anchor: left center; size: 18; weight: 600; family: "SF Pro Display"; color: ink; opacity: 94% }
    text "{host} · {output_name} · {cta_session}" { at: if(has_avatar, ed_x + 86, ed_x + 34), 458; anchor: left center; size: 12.5; family: "SF Pro Text"; color: ink; opacity: 56%; show: not is_greeter }
    text "{host} · {session_name}" { at: if(has_avatar, ed_x + 86, ed_x + 34), 458; anchor: left center; size: 12.5; family: "SF Pro Text"; color: ink; opacity: 56%; show: is_greeter }
    box { from: ed_x + 34, 492; size: 316, 44; corner: 12; color: ink; opacity: 8% }
    box { from: ed_x + 34.5, 492.5; size: 315, 43; corner: 11.5; stroke: 1; color: if(wrong, err_c, ink); opacity: if(wrong, 85%, 18%) }
    LockDots(ed_x + 58, 514, 4, 14, 1, 0.92, 1)
    text "Password" { at: ed_x + 52, 514; anchor: left center; size: 13; family: "SF Pro Text"; color: ink; opacity: 40%; show: typed == 0 and not checking }
    shader lock_ribbon { at: ed_x + 22, 530; size: 340, 42; values: ed_bead, vel(ed_bead), min(7.99, 2 + min(3, abs(vel(ed_bead)) * 0.02)) + 8 * round(min(1, abs(vel(ed_bead)) / 50) * 255), ed_bead + if(vel(ed_bead) >= 0, 12, -12), ed_amp, ed_amp * 0.35, ed_bead - 8, if(vel(ed_bead) >= 0, 1, -1) * (1 + min(3, ed_t)); colors: if(wrong, err_c, if(ed_f < 0.25, mix(st0, st1, ed_f * 4), if(ed_f < 0.5, mix(st1, st2, ed_f * 4 - 1), if(ed_f < 0.75, mix(st2, st3, ed_f * 4 - 2), mix(st3, st4, ed_f * 4 - 3))))), #ffffff }
    text status { at: ed_x + 34, 578; anchor: left center; size: 12; weight: 500; family: "SF Pro Text"; color: err_c; opacity: 95%; show: wrong }
    text cta_ok { at: ed_x + 34, 578; anchor: left center; size: 12; weight: 500; family: "SF Pro Text"; color: ink; opacity: 82%; show: unlocking }
    text "Checking…" { at: ed_x + 34, 578; anchor: left center; size: 12; weight: 500; family: "SF Pro Text"; color: ink; opacity: 60%; show: checking and not unlocking }
    text "{cta_submit}  ·  Esc to hide" { at: ed_x + 34, 578; anchor: left center; size: 12; weight: 500; family: "SF Pro Text"; color: ink; opacity: 50%; show: not wrong and not unlocking and not checking }
    box { from: ed_x + 34, 646; size: 316, 1; color: ink; opacity: 9% }
    image lock_i_play { at: ed_x + 34, 666; size: 13, 13; tint: ink; opacity: 72%; show: not is_greeter and media_known }
    text media_title { at: ed_x + 54, 673; anchor: left center; width: 296; lines: 1; size: 12.5; weight: 500; family: "SF Pro Text"; color: ink; opacity: 78%; show: not is_greeter and media_known }
    text "Nothing playing" { at: ed_x + 34, 673; anchor: left center; size: 12.5; family: "SF Pro Text"; color: ink; opacity: 50%; show: not is_greeter and not media_known }
    text "DESKTOP SESSION" { at: ed_x + 34, 664; anchor: left center; size: 10.5; weight: 500; family: "SF Pro Text"; color: ink; opacity: 48%; show: is_greeter }
    text session_name { at: ed_x + 34, 684; anchor: left center; width: 316; lines: 1; size: 13; weight: 500; family: "SF Pro Text"; color: ink; opacity: 84%; show: is_greeter }
   }
  }
 }
}
