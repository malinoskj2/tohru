scene TohruLock {
 surface { size: 1, 1; anchor: top_left; level: background; keyboard: none }
 permissions { run: "uname -n", "systemctl suspend", "systemctl reboot"; services: "clock", "capture", "workspaces", "media", "env" }
 include "state.plm"
 include "styles/common.plm"
 surface locked {
  kind: lock
  size: 1920, 1080
  open: engaged
  include "backdrop.plm"
  include "styles/plain.plm"
  include "styles/still-glass.plm"
  include "styles/ribbon-key.plm"
  include "styles/flooded-monolith.plm"
  include "styles/drifting-frost-veil.plm"
  include "styles/unfolding-glass-capsule.plm"
  include "styles/edge-glass-drawer.plm"
  include "styles/horizon-meniscus.plm"
  include "styles/refractive-typographic-lens.plm"
  include "styles/corner-anchor.plm"
  include "styles/bar-drop-curtain.plm"
  include "styles/bar.plm"
  include "field.plm"
 }
}
