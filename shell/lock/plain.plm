scene TohruLockPlain {
 surface { size: 1, 1; anchor: top_left; level: background; keyboard: none }
 permissions { services: "clock", "env" }
 include "state.plm"
 surface locked {
  kind: lock
  size: 1920, 1080
  open: engaged
  include "backdrop.plm"
  include "styles/plain.plm"
  include "field.plm"
 }
}
