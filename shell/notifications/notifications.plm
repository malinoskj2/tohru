language 0.4
scene TohruNotifications {
    surface { size: 420, 380; anchor: top_right; margin: 42, 12, 0, 0; level: overlay; keyboard: none; screens: each }
    permissions { services: "notifications", "sound", "files", "files.write", "say:tohru" }
    fact last_id = 0
    fact power_level = 0
    fact unread = false
    fact dnd = false
    event notices_seen ->
    event notices_dnd ->
    event notices_report ->
    event power_warning_clear ->
    event power_warning_low ->
    event power_warning_critical ->
    event power_warning_empty ->
    model banners max 4 { title: text; body: text }
    column stack { at: 12, 8; gap: 8
        for notice in banners { Banner(notice) }
    }
    component Banner(notice: record) {
        size: 396, 80
        box { from: 0, 0; size: 396, 80; color: #171219; opacity: 94% }
        text notice.title { at: 12, 9; width: 372; lines: 1; size: 13; weight: 600; color: #ffffff }
        text notice.body { at: 12, 31; width: 372; lines: 3; size: 12; color: #ffffff }
    }
}
