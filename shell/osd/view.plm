part VolumeOsdView {
    // Native spring/velocity approximation of the retained Jelly entrance.
    surface volume_osd {
        size: 100, 260; anchor: right; margin: 20; level: overlay; reserve: -1
        screens: all; keyboard: none
        prop osd_seen = 0 ~spring(175, 8.5)
        follow osd_seen = if(osd_open, 1, 0)
        prop osd_fill = 0 ~spring(170, 13.04)
        follow osd_fill = osd_level
        group {
            move: (1 - osd_seen) * 70, 0
            pivot: 80, 130
            scale: 0.85 + 0.15 * osd_seen + clamp(vel(osd_seen) * 0.008, -0.08, 0.08), 1 - clamp(vel(osd_seen) * 0.006, -0.08, 0.08)
            opacity: clamp(osd_seen, 0, 1)
            show: osd_open or osd_seen != 0 or vel(osd_seen) != 0
            body { color: #181825; glass: 72%; frost: 45%; refraction: 110%; ripple: 65%; rim: 4%; shadow: 0, 4, 10, 25%
                box { from: 28, 30; size: 44, 200; corner: 22; color: #181825; opacity: 84% }
            }
            // Rounded native liquid fill remains within the glass vessel.
            box { from: 31, 227 - clamp(osd_fill, 0, 1) * 194; size: 38, clamp(osd_fill, 0, 1) * 194; corner: min(19, clamp(osd_fill, 0, 1) * 97); color: #89dceb; opacity: 80% }
            text osd_label { at: 50, 57; anchor: center; size: 12; weight: 600; color: #cdd6f4 }
            image sound_speaker { at: 42, 194; size: 16, 16; tint: #cdd6f4; show: not osd_last_muted }
            image sound_muted { at: 42, 194; size: 16, 16; tint: #cdd6f4; show: osd_last_muted }
            zone box osd_vessel { from: 28, 30; size: 44, 200; active: osd_open }
            on enter osd_vessel { emit osd_enter }
            on leave osd_vessel { emit osd_leave }
        }
    }
}
