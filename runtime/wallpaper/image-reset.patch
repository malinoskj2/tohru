     #[test]
+    fn cold_live_identity_never_inherits_another_outputs_picture() {
+        let (send, _jobs) = channel();
+        let mut texts = Texts::new(send);
+        let size = (64, 36);
+        texts.sources = vec![(ImageSource::Live(crate::scene::TextId(0)), size)];
+        let slot = AtlasSlot { page: 0, x: 0, y: 0, width: 64, height: 36 };
+        texts.live.insert(("/old.png".into(), size), Some(slot));
+        assert!(texts.image(0, &["/old.png".into()]).is_some());
+        // Simulates coalesced detach/new path/attach: image sees only the final text.
+        assert!(texts.image(0, &["/cold-new.png".into()]).is_none());
+        assert!(!texts.last_live.contains_key(&0));
+        texts.live.insert(("/cold-new.png".into(), size), None);
+        assert!(texts.image(0, &["/cold-new.png".into()]).is_none());
+        assert!(texts.image(0, &["/old.png?2".into()]).is_some());
+        assert!(texts.image(0, &[String::new()]).is_none());
+        assert!(!texts.last_live.contains_key(&0));
+    }
