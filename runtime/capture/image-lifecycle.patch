+    /// Forget the immutable capture identity, even if its surface is closed.
+    /// No tombstone survives: native frozen-token validity rejects late work.
+    pub fn release_capture(&mut self, name: &str) {
+        if !name.starts_with("capture:") { return; }
+        let pages: HashSet<u32> = self.live.iter().filter(|((key, _), _)| key == name).filter_map(|(_, slot)| slot.map(|slot| slot.page))
+            .chain(self.last_live.values().filter(|((key, _), _)| key == name).map(|(_, slot)| slot.page)).collect();
+        self.live.retain(|(key, _), _| key != name);
+        self.last_live.retain(|_, ((key, _), _)| key != name);
+        self.live_version.retain(|(key, _), _| key != name);
+        self.live_requested.retain(|(key, _)| key != name);
+        self.unseen.retain(|(key, _), _| key != name);
+        self.working.live.retain(|(key, _)| key != name);
+        self.pending_pictures.retain(|(page, ..)| !pages.contains(page));
         self.sweep_pictures();
     }
 
