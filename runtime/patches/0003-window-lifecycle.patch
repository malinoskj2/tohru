+#[derive(Clone)]
+struct ConditionalWindow {
+    _window: Window,
+    life: Arc<crate::tohru_window::Retirement>,
+}
+
+fn conditional_commit(window: Option<&ConditionalWindow>, action: impl FnOnce()) {
+    match window {
+        Some(window) => window.life.if_current(action),
+        None => action(),
+    }
+}
+
+struct ConditionalWorker(Option<ConditionalWindow>);
+
+impl ConditionalWorker {
+    fn start(window: ConditionalWindow) -> Option<Self> {
+        if !window.life.start_worker() { return None; }
+        Some(Self(Some(window)))
+    }
+}
+
+impl Drop for ConditionalWorker {
+    fn drop(&mut self) {
+        let Some(window) = self.0.take() else { return };
+        let life = window.life.clone();
+        // Release this worker's native owner BEFORE notifying the event loop.
+        drop(window);
+        if life.finish_worker() {
+            if let Some(native) = MOVABLE_LAYERS.get() {
+                native.connection.display().sync(&native.qh, WindowRefresh);
+                let _ = native.connection.flush();
+            }
+        }
+    }
+}
