+// A role may outlive its swapchain retirement request. On process teardown,
+// unacknowledged handles are intentionally retained rather than destroyed under
+// a renderer that may still reference them; OS process exit releases them.
+#[derive(Default)]
+struct RetiredWindows(Vec<Placed>);
+
+impl Drop for RetiredWindows {
+    fn drop(&mut self) {
+        for window in self.0.drain(..) {
+            std::mem::forget(window);
+        }
+    }
+}
+
+static RETIRING_WINDOWS: std::sync::LazyLock<Mutex<std::collections::HashSet<u32>>> = std::sync::LazyLock::new(Mutex::default);
 
