+pub fn window_open(which: usize, open: bool) {
+    let Some(native) = MOVABLE_LAYERS.get() else { return };
+    native.said.lock().unwrap().entry(which).or_default().window_open = Some(open);
+    native.connection.display().sync(&native.qh, WindowRefresh);
+    let _ = native.connection.flush();
+}
+
+struct WindowRefresh;
+impl Dispatch2<wayland_client::protocol::wl_callback::WlCallback, State> for WindowRefresh {
+    fn event(&self, state: &mut State, _: &wayland_client::protocol::wl_callback::WlCallback, event: wayland_client::protocol::wl_callback::Event, _: &Connection, qh: &QueueHandle<State>) {
+        if let wayland_client::protocol::wl_callback::Event::Done { .. } = event {
+            state.refresh_windows(qh);
+        }
+    }
+}
+
+struct WindowReleased(u32);
+impl Dispatch2<wayland_client::protocol::wl_callback::WlCallback, State> for WindowReleased {
+    fn event(&self, state: &mut State, _: &wayland_client::protocol::wl_callback::WlCallback, event: wayland_client::protocol::wl_callback::Event, _: &Connection, qh: &QueueHandle<State>) {
+        if let wayland_client::protocol::wl_callback::Event::Done { .. } = event {
+            state.retired_windows.retain(|placed| placed.id != self.0);
+            state.refresh_windows(qh);
+        }
+    }
 }

