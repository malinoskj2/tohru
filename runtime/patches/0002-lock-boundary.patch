+impl Dispatch2<wayland_client::protocol::wl_callback::WlCallback, State> for RetiredLock {
+    fn event(&self, state: &mut State, _: &wayland_client::protocol::wl_callback::WlCallback, event: wayland_client::protocol::wl_callback::Event, _: &Connection, _: &QueueHandle<State>) {
