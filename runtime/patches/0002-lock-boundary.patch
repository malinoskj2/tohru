+    // WITHOUT engaged held: driver teardown may wait while Wayland callbacks
+    // need engaged. No nested dispatch or callback is required by the closure.
+    drop(pending);
+    release_faces(owner);
+    let Ok(mut engaged) = c.engaged.lock() else { return false };
+    let Some(e) = engaged.as_ref() else { return false };
+    if !e.cycle.accepts_release(&release) || !e.lock.is_locked() {
+        // Only terminal Finished can revoke while reserved; no new cycle can
+        // acquire while engaged remains occupied. Finished needs no unlock.
+        if !e.cycle.active() {
