+
+pub(crate) fn authenticated_unlock(permit: crate::tohru_lock::Permit, release_faces: impl FnOnce(usize)) -> bool {
+    let Some(c) = LOCKS.get() else { return false };
+    let (owner, release) = {
+        let Ok(engaged) = c.engaged.lock() else { return false };
+        let Some(e) = engaged.as_ref() else { return false };
+        if !e.lock.is_locked() { return false; }
+        let Some(release) = e.cycle.reserve(permit) else { return false };
+        (e.which, release)
+    };
+    // Reservation excludes acquisition/authentication. Drop GPU resources
+    // WITHOUT engaged held: driver teardown may wait while Wayland callbacks
+    // need engaged. No nested dispatch or callback is required by the closure.
+    release_faces(owner);
+    let Ok(mut engaged) = c.engaged.lock() else { return false };
+    let Some(e) = engaged.as_ref() else { return false };
+    if !e.cycle.accepts_release(&release) || !e.lock.is_locked() {
+        // Only terminal Finished can revoke while reserved; no new cycle can
+        // acquire while engaged remains occupied. Finished needs no unlock.
+        if !e.cycle.active() {
+            drop(engaged.take());
+            return true;
+        }
+        return false;
+    }
+    let Some(e) = engaged.take() else { return false };
+    e.cycle.finish();
+    e.lock.unlock();
+    drop(e);
+    retire_lock(c);
+    println!("lock   · authenticated release");
+    true
 }
 
