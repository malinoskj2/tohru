+/// Whether `OnlyShowIn` and `NotShowIn` let an entry show on the desktops `XDG_CURRENT_DESKTOP`
+/// names, the first that either list names deciding. With no desktop known, only `OnlyShowIn`
+/// keeps an entry out.
+fn for_desktop(only: &str, not: &str, desktops: &str) -> bool {
+    let named = |list: &str, desktop: &str| list.split(';').any(|d| d.trim() == desktop);
+    for desktop in desktops.split(':').filter(|d| !d.is_empty()) {
+        if named(only, desktop) {
+            return true;
+        }
+        if named(not, desktop) {
+            return false;
+        }
+    }
+    only.split(';').all(|d| d.trim().is_empty())
+}
+
+/// Whether the program `TryExec` names can be run: a path that is an executable file, or a name
+/// found as one in `path`. An entry without `TryExec` always can.
+fn installed_program(program: &str, path: &std::ffi::OsStr) -> bool {
+    use std::os::unix::fs::PermissionsExt;
+    let runs = |p: &std::path::Path| std::fs::metadata(p).is_ok_and(|m| m.is_file() && m.permissions().mode() & 0o111 != 0);
+    let program = program.trim();
+    if program.is_empty() {
+        return true;
+    }
+    if program.starts_with('/') {
+        return runs(std::path::Path::new(program));
+    }
+    std::env::split_paths(path).filter(|d| !d.as_os_str().is_empty()).any(|d| runs(&d.join(program)))
+}
+
+/// Whether the image loader will find `Icon=`: a file by its path, or a name in the icon themes.
+fn found_icon(name: &str) -> bool {
+    let path = std::path::Path::new(name);
+    !name.is_empty() && if path.is_absolute() { path.is_file() } else { crate::platform::icon(name).is_some() }
+}
