+    #[test]
+    fn an_entry_shows_only_on_the_desktops_it_allows() {
+        assert!(for_desktop("", "", ""));
+        assert!(for_desktop("", "KDE;", "Hyprland"));
+        assert!(!for_desktop("", "Hyprland;", "Hyprland"));
+        assert!(!for_desktop("GNOME;KDE;", "", "Hyprland"));
+        assert!(for_desktop("GNOME;Hyprland;", "", "Hyprland"));
+        assert!(!for_desktop("GNOME;", "", ""));
+        assert!(!for_desktop("Hyprland;", "GNOME;", "GNOME:Hyprland"));
+        assert!(for_desktop("Hyprland;", "GNOME;", "Hyprland:GNOME"));
+    }
+
+    #[test]
+    fn an_entry_whose_try_exec_is_missing_is_no_app() {
+        use std::os::unix::fs::PermissionsExt;
+        let dir = std::env::temp_dir().join(format!("pleamar-tryexec-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        std::fs::write(dir.join("present"), "x").unwrap();
+        std::fs::set_permissions(dir.join("present"), std::fs::Permissions::from_mode(0o755)).unwrap();
+        std::fs::write(dir.join("plain"), "x").unwrap();
+        std::fs::set_permissions(dir.join("plain"), std::fs::Permissions::from_mode(0o644)).unwrap();
+        let path = std::env::join_paths(["/nonexistent".into(), dir.clone()]).unwrap();
+        assert!(installed_program("", &path));
+        assert!(installed_program("present", &path));
+        assert!(installed_program(&dir.join("present").display().to_string(), &path));
+        assert!(!installed_program("missing", &path));
+        assert!(!installed_program("plain", &path));
+        assert!(!installed_program("/nonexistent/present", &path));
+        assert!(!installed_program(&dir.display().to_string(), &path));
+        std::fs::remove_dir_all(&dir).unwrap();
+    }
