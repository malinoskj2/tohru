+
+fn set_volume_on(c: &Connection, v: f64) -> Result<(), String> {
+    let (name, p, _) = active_player(c).ok_or("there is no player open")?;
+    let who = name.trim_start_matches(PREFIX);
+    if volume(&p) < 0.0 { return Err(format!("{who} has no volume of its own")) }
+    p.set_property("Volume", v.clamp(0.0, 1.0)).map_err(|e| format!("{who} does not let its volume be set: {e}"))?;
+    // A player that does not signal the change is read again now.
+    wake();
+    Ok(())
+}
