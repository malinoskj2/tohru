+/// How much of what is behind a box is bright: the box cut in a 16 × 16 grid, each cell the mean
+/// of 4 × 4 points in it, and the cells whose Rec. 709 luma is over 55 % counted. Only the count
+/// (four bytes) comes back from the card.
+struct Bright {
+    pipeline: wgpu::ComputePipeline,
+    layout: wgpu::BindGroupLayout,
+    area: wgpu::Buffer,
+    count: wgpu::Buffer,
+}
+
+const BRIGHT_CELLS: u32 = 16 * 16;
+
+const BRIGHT_SHADER: &str = r#"
+@group(0) @binding(0) var behind: texture_2d<f32>;
+// x, y, width, height, in the background's pixels.
+@group(0) @binding(1) var<uniform> area: vec4<u32>;
+@group(0) @binding(2) var<storage, read_write> n: array<atomic<u32>, 1>;
+@compute @workgroup_size(16, 16) fn main(@builtin(global_invocation_id) g: vec3<u32>) {
+    let origin = vec2<f32>(f32(area.x), f32(area.y));
+    let cell = vec2<f32>(f32(area.z), f32(area.w)) / 16.0;
+    var sum = vec3<f32>(0.0);
+    for (var j = 0u; j < 4u; j++) {
+        for (var i = 0u; i < 4u; i++) {
+            let at = origin + (vec2<f32>(g.xy) + (vec2<f32>(f32(i), f32(j)) + 0.5) / 4.0) * cell;
+            sum += textureLoad(behind, vec2<i32>(at), 0).rgb;
+        }
+    }
+    if dot(sum / 16.0, vec3<f32>(0.2126, 0.7152, 0.0722)) > 0.55 {
+        atomicAdd(&n[0], 1u);
+    }
+}
+"#;
+
+impl Bright {
+    fn new(d: &wgpu::Device) -> Bright {
+        let layout = d.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+            label: Some("how bright it is behind"),
+            entries: &[
+                wgpu::BindGroupLayoutEntry { binding: 0, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Texture { sample_type: wgpu::TextureSampleType::Float { filterable: false }, view_dimension: wgpu::TextureViewDimension::D2, multisampled: false }, count: None },
+                wgpu::BindGroupLayoutEntry { binding: 1, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Uniform, has_dynamic_offset: false, min_binding_size: wgpu::BufferSize::new(16) }, count: None },
+                wgpu::BindGroupLayoutEntry { binding: 2, visibility: wgpu::ShaderStages::COMPUTE, ty: wgpu::BindingType::Buffer { ty: wgpu::BufferBindingType::Storage { read_only: false }, has_dynamic_offset: false, min_binding_size: wgpu::BufferSize::new(4) }, count: None },
+            ],
+        });
+        let pl = d.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor { label: Some("how bright it is behind"), bind_group_layouts: &[Some(&layout)], immediate_size: 0 });
+        let shader = d.create_shader_module(wgpu::ShaderModuleDescriptor { label: Some("how bright it is behind"), source: wgpu::ShaderSource::Wgsl(BRIGHT_SHADER.into()) });
+        let pipeline = d.create_compute_pipeline(&wgpu::ComputePipelineDescriptor { label: Some("how bright it is behind"), layout: Some(&pl), module: &shader, entry_point: Some("main"), compilation_options: Default::default(), cache: None });
+        let area = d.create_buffer(&wgpu::BufferDescriptor { label: Some("where it is told how bright"), size: 16, usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST, mapped_at_creation: false });
+        let count = d.create_buffer(&wgpu::BufferDescriptor { label: Some("bright cells"), size: 4, usage: wgpu::BufferUsages::STORAGE | wgpu::BufferUsages::COPY_SRC | wgpu::BufferUsages::COPY_DST, mapped_at_creation: false });
+        Bright { pipeline, layout, area, count }
+    }
+
+    /// Counts in `enc`, and gives the buffer the count is copied to, to map once it is submitted.
+    fn count(&self, g: &crate::gpu::Gpu, enc: &mut wgpu::CommandEncoder, background: &wgpu::TextureView, area: [u32; 4]) -> wgpu::Buffer {
+        let dev = &g.device;
+        g.queue.write_buffer(&self.area, 0, bytemuck::cast_slice(&area));
+        let group = dev.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: None,
+            layout: &self.layout,
+            entries: &[
+                wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(background) },
+                wgpu::BindGroupEntry { binding: 1, resource: self.area.as_entire_binding() },
+                wgpu::BindGroupEntry { binding: 2, resource: self.count.as_entire_binding() },
+            ],
+        });
+        enc.clear_buffer(&self.count, 0, None);
+        {
+            let mut pass = enc.begin_compute_pass(&wgpu::ComputePassDescriptor { label: Some("how bright it is behind"), timestamp_writes: None });
+            pass.set_pipeline(&self.pipeline);
+            pass.set_bind_group(0, &group, &[]);
+            pass.dispatch_workgroups(1, 1, 1);
+        }
+        let read = dev.create_buffer(&wgpu::BufferDescriptor { label: Some("bright cells, to read"), size: 4, usage: wgpu::BufferUsages::MAP_READ | wgpu::BufferUsages::COPY_DST, mapped_at_creation: false });
+        enc.copy_buffer_to_buffer(&self.count, 0, &read, 0, 4);
+        read
+    }
+}
