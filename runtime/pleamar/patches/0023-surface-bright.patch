+/// The fact a sheet writes how bright it is behind its glass into: its popup's, or its own surface's.
+fn bright_of(scene: &crate::scene::Scene, view: &crate::gpu::View) -> Option<crate::scene::FactId> {
+    match view.popup {
+        Some(k) => scene.popups.get(k).and_then(|p| p.bright),
+        None => scene.surfaces.get(view.surface).and_then(|s| s.bright),
+    }
+}
