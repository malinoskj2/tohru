@@ -493,4 +526,44 @@ mod tests {
         assert_eq!(m.feed(0.3, t + Duration::from_millis(7)), Some(0.3));
         assert_eq!(m.feed(0.0, t + Duration::from_millis(40)), Some(0.0));
     }
+
+    #[test]
+    fn tohru_audio_device_id_rejects_invalid_numbers() {
+        assert_eq!(device_id(0.0), Ok(0));
+        assert_eq!(device_id(42.0), Ok(42));
+        assert_eq!(device_id(u32::MAX as f64), Ok(u32::MAX));
+        assert!(device_id(-1.0).is_err());
+        assert!(device_id(1.5).is_err());
+        assert!(device_id(f64::NAN).is_err());
+        assert!(device_id(f64::INFINITY).is_err());
+        assert!(device_id((u32::MAX as f64) + 1.0).is_err());
+    }
+
+    #[test]
+    fn tohru_audio_default_input_ignores_monitors_and_sink_id_collisions() {
+        let mut sink = SinkInfo::default();
+        sink.index = 0;
+        sink.name = CString::new("alsa_output.main").unwrap();
+
+        let mut monitor = SourceInfo::default();
+        monitor.index = 0;
+        monitor.name = CString::new("alsa_output.main.monitor").unwrap();
+        monitor.monitor_of_sink_index = Some(0);
+
+        let mut mic = SourceInfo::default();
+        mic.index = 1;
+        mic.name = CString::new("alsa_input.mic").unwrap();
+        mic.monitor_of_sink_index = None;
+
+        let mut colliding_mic = SourceInfo::default();
+        colliding_mic.index = 0;
+        colliding_mic.name = CString::new("alsa_input.headset").unwrap();
+        colliding_mic.monitor_of_sink_index = None;
+
+        assert_eq!(find_output(&[sink.clone()], 0).unwrap().as_c_str(), CString::new("alsa_output.main").unwrap().as_c_str());
+        assert!(find_output(&[sink], 1).is_err());
+        assert!(find_input(&[monitor.clone(), mic.clone()], 0).is_err());
+        assert_eq!(find_input(&[monitor, mic], 1).unwrap().as_c_str(), CString::new("alsa_input.mic").unwrap().as_c_str());
+        assert_eq!(find_input(&[colliding_mic], 0).unwrap().as_c_str(), CString::new("alsa_input.headset").unwrap().as_c_str());
+    }
 }
