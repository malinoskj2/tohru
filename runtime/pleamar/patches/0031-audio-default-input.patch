     p.ack(if sink { Command::SetSinkMute(params) } else { Command::SetSourceMute(params) })
 }
 
+fn device_id(raw: f64) -> R<u32> {
+    if !raw.is_finite() || raw < 0.0 || raw > u32::MAX as f64 || raw.fract() != 0.0 {
+        return Err(format!("there is no device {raw}"));
+    }
+    Ok(raw as u32)
+}
+
+fn find_output<'a>(sinks: &'a [SinkInfo], id: u32) -> R<&'a CString> {
+    sinks
+        .iter()
+        .find(|s| s.index == id)
+        .map(|s| &s.name)
+        .ok_or_else(|| format!("there is no output {id}"))
+}
+
+fn find_input<'a>(sources: &'a [SourceInfo], id: u32) -> R<&'a CString> {
+    sources
+        .iter()
+        .filter(|s| s.monitor_of_sink_index.is_none())
+        .find(|s| s.index == id)
+        .map(|s| &s.name)
+        .ok_or_else(|| format!("there is no input {id}"))
+}
