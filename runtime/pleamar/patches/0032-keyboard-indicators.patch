+        let Some(rest) = trimmed.strip_prefix("name[group") else { continue };
+        let Some((idx_str, after)) = rest.split_once(']') else { continue };
+        let Ok(idx) = idx_str.trim().parse::<usize>() else { continue };
+        let Some((_, rhs)) = after.split_once('=') else { continue };
