+    let service = CString::new(service).map_err(|_| "a PAM service name cannot carry a zero byte")?;
+    let confdir = confdir.map(|d| CString::new(d.as_os_str().as_encoded_bytes()).map_err(|_| "a PAM directory cannot carry a zero byte")).transpose()?;
