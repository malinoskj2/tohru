+/// Where libpam keeps its modules: `security/` beside the libpam this process loaded.
+#[cfg(test)]
+pub fn module_dir() -> Option<std::path::PathBuf> {
+    let maps = std::fs::read_to_string("/proc/self/maps").ok()?;
+    let lib = maps.lines().filter_map(|l| l.split_whitespace().nth(5)).find(|p| p.contains("/libpam.so"))?;
+    let dir = std::path::Path::new(lib).parent()?.join("security");
+    dir.join("pam_exec.so").exists().then_some(dir)
+}
