+/// The PAM service: Tohru's locker's own, else pleamar's, else hyprlock's (the
+/// locker it stands in for, so a desktop set up for it already has one), else `login`'s.
+fn service() -> &'static str {
+    ["tohru-lock", "pleamar", "hyprlock"]
+        .into_iter()
+        .find(|s| std::path::Path::new("/etc/pam.d").join(s).exists())
+        .unwrap_or("login")
+}
+
 /// `true` if that is the password of whoever holds the session.
 pub fn verify(password: &str) -> Result<bool, String> {
+    #[cfg(feature = "tohru-test-pam")]
+    if let Some(dir) = std::env::var_os("TOHRU_TEST_PAM_CONFDIR") {
+        eprintln!("lock   · TEST BUILD: checking against the private PAM service in {}", dir.to_string_lossy());
+        return verify_with("tohru-test", Some(std::path::Path::new(&dir)), password);
+    }
+    verify_with(service(), None, password)
+}
+
+/// The same against a named service, read from `confdir` instead of /etc/pam.d
