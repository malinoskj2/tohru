+
+impl Notification {
+    fn left(&self, now: Instant) -> Duration {
+        self.held.or_else(|| self.expires.map(|c| c.saturating_duration_since(now))).unwrap_or_default()
+    }
+
+    /// Holding stops the clock where it is; letting go starts it again from there.
+    fn hold(&mut self, yes: bool, now: Instant) {
+        match (yes, self.expires, self.held) {
+            (true, Some(c), None) => {
+                self.held = Some(c.saturating_duration_since(now));
+                self.expires = None;
+            }
+            (false, None, Some(left)) => {
+                self.expires = Some(now + left);
+                self.held = None;
+            }
+            _ => {}
+        }
+    }
