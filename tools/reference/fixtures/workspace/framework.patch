+            let elapsed = epoch.get_or_insert(now).elapsed().as_secs_f64()*1000.0;
+            if mode == "replay" || mode == "active" {
+                let mut replay = replay.lock().map_err(|_| mlua::Error::runtime("replay mutex poisoned"))?;
+                replay.advance_ms(elapsed);
+                let values = lua.create_sequence_from(replay.track.shader_values())?;
+                return Ok((values, mode == "active" || elapsed < 12000.0, elapsed));
+            }
+            let mut t = track.lock().map_err(|_| mlua::Error::runtime("track mutex poisoned"))?;
+            t.advance(now);
+            t.sync(5, Some(target), now);
+            let values = lua.create_sequence_from(t.shader_values())?;
+            Ok((values, t.animating(), elapsed))
+        })?)?;
