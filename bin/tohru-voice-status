#!/usr/bin/env python3
"""Verify an owned worker and acknowledge current voice interest in one tool call."""
import argparse
import json
import os
import re
import selectors
import shutil
import subprocess
import sys
import time


class StatusError(Exception):
    pass


def identity(value, pattern, name):
    if not isinstance(value, str) or not re.fullmatch(pattern, value):
        raise StatusError(f"Invalid {name}")
    return value


def voice_request(history):
    entries = history.get("entries")
    if not isinstance(entries, list):
        raise StatusError("Orca did not return conversation history")
    owners = [entry for entry in entries if isinstance(entry, dict)
              and entry.get("role") == "user"
              and isinstance(entry.get("interaction"), dict)
              and entry["interaction"].get("kind") == "owner"]
    if not owners:
        raise StatusError("No actual owner turn in the conversation window")
    owner = owners[-1]
    if not isinstance(owner.get("text"), str) or not owner["text"].startswith("[tohru-desktop:voice]\n"):
        raise StatusError("The latest owner turn is not desktop voice")
    return identity(owner["interaction"].get("requestId"), r"orca:[A-Za-z0-9_:%.-]{1,507}", "owner request")


class Orca:
    def __init__(self):
        configured = os.environ.get("ORCA_CLI_COMMAND")
        self.executable = shutil.which(configured or "orca-ide")
        if not self.executable:
            raise StatusError("The configured Orca CLI is unavailable")
        self.deadline = time.monotonic() + 15

    def call(self, arguments):
        remaining = self.deadline - time.monotonic()
        if remaining <= 0:
            raise StatusError("Status operation timed out; do not retry speech automatically")
        try:
            process = subprocess.Popen([self.executable, *arguments, "--json"],
                stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError as error:
            raise StatusError("Could not start the configured Orca CLI") from error
        selector = selectors.DefaultSelector()
        selector.register(process.stdout, selectors.EVENT_READ)
        output = bytearray()
        limit = 2 * 1024 * 1024
        try:
            while True:
                remaining = self.deadline - time.monotonic()
                if remaining <= 0 or not selector.select(timeout=remaining):
                    raise StatusError("Orca call timed out; do not retry speech automatically")
                block = os.read(process.stdout.fileno(), min(65536, limit + 1 - len(output)))
                if not block:
                    break
                output.extend(block)
                if len(output) > limit:
                    raise StatusError("Orca output exceeded its byte limit; no automatic retry")
            try:
                code = process.wait(timeout=max(0, self.deadline - time.monotonic()))
            except subprocess.TimeoutExpired as error:
                raise StatusError("Orca call timed out; do not retry speech automatically") from error
            if code:
                raise StatusError("Orca rejected the operation; no automatic retry")
        finally:
            selector.close()
            process.stdout.close()
            if process.poll() is None:
                process.kill()
            try:
                process.wait(timeout=2)
            except subprocess.TimeoutExpired as error:
                raise StatusError("Orca child could not be reaped; do not retry automatically") from error
        try:
            envelope = json.loads(output)
        except (ValueError, UnicodeError) as error:
            raise StatusError("Invalid Orca response") from error
        if not isinstance(envelope, dict) or envelope.get("ok") is not True or not isinstance(envelope.get("result"), dict):
            raise StatusError("Orca did not confirm the operation; no automatic retry")
        return envelope["result"]


def acknowledge(client, session, dispatch, run):
    # Snapshot before status lookup. An intervening owner turn must not acquire
    # this acknowledgement: native admission rechecks the explicit request.
    request = voice_request(client.call(["agent", "read", "orca_session_id:" + session,
                                        "--limit", "100", "--ids"]))
    status = client.call(["orchestration", "worker-show", "--dispatch", dispatch])
    if status.get("dispatchId") != dispatch or status.get("runId") != run:
        raise StatusError("Worker identity does not match the requested dispatch and run")
    if status.get("state") != "ready" or status.get("stage") != "input_accepted" or status.get("liveness") != "live" or status.get("activity") != "working":
        raise StatusError("Worker is not confirmed ready and active; no running-status speech")
    # The server, not this read, validates coordinating-bot ownership, current
    # request/revision, terminal races and replay; the desktop owns visibility.
    receipt = client.call(["bot", "voice-task", "--task", "dispatch:" + dispatch,
                           "--request", request, "--sequence", "1", "--kind", "ack",
                           "--text", "The task's worker is active. No completion is recorded yet."])
    if receipt.get("request") != request or receipt.get("delivery") not in ("pending", "dispatched", "replay"):
        raise StatusError("Unrecognized speech receipt; do not retry automatically")
    return {"dispatchId": dispatch, "taskId": status.get("taskId"), "runId": run,
            "state": status["state"], "stage": status["stage"], **receipt}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dispatch", required=True, help="Exact owned worker dispatch from its accepted receipt")
    parser.add_argument("--run", required=True, help="Exact run from the same receipt")
    args = parser.parse_args()
    try:
        dispatch = identity(args.dispatch, r"ctx_[a-z0-9]{1,120}", "dispatch")
        run = identity(args.run, r"run_[a-z0-9]{1,120}", "run")
        session = identity(os.environ.get("ORCA_AGENT_SESSION_ID"),
            r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", "injected caller")
        if os.environ.get("ORCA_PAIRING_CODE") or os.environ.get("ORCA_ENVIRONMENT", "local") not in ("", "local"):
            raise StatusError("Voice status requires the existing local coordinating bot")
        result = acknowledge(Orca(), session, dispatch, run)
    except StatusError as error:
        print(json.dumps({"ok": False, "error": str(error)}))
        return 1
    print(json.dumps({"ok": True, "result": result}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
