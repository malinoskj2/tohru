#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
scene=${TOHRU_NOTIFICATIONS_SCENE:-$root/shell/notifications/notifications.plm}
[[ -z ${TOHRU_SHELL_DIR:-} ]] || scene=$TOHRU_SHELL_DIR/notifications/notifications.plm
exec "${TOHRU_RUNTIME_OVERRIDE:-${TOHRU_RUNTIME:-pleamar}}" --scene "$scene" --no-hud --stall 0 --answer-as tohru-notifications "$@"
