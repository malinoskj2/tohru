#!/usr/bin/env python3
import argparse
import fcntl
import json
import math
import os
import queue
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import wave
from io import BytesIO
from pathlib import Path

SAMPLE_RATE = 16_000
WINDOW = 512
WINDOW_MS = WINDOW * 1000 / SAMPLE_RATE
# Thresholds and timings from n33tc0de-voices (521f324, docs/voice-turn-detection-2026-11-10.md), in 32 ms windows.
SPEECH_START = 0.5
SPEECH_START_WINDOWS = 2
SPEECH_CONTINUE = 0.35
PREROLL_MS = 128
TAIL_MS = 160
PAUSE_MS = 200
INCOMPLETE_HOLD_MS = 1000
SILENCE_FALLBACK_MS = 800
MAX_UTTERANCE_MS = 30_000
BARGE_MS = 200
BARGE_FLOOR = 0.025
# Without echo cancellation the microphone hears the dragon too: barge-in must beat its playback by
# this factor, and speech is ignored for a moment after it stops.
ECHO_MARGIN = 1.6
ECHO_TAIL_S = 0.4
TURN_COMPLETE = 0.5
TURN_WINDOW = SAMPLE_RATE * 8
CONVERSATION_SECONDS = 60
WAKE_DECIDE_MS = 1600
MOUTH_FPS = 30
SPOKEN_CHARS = 600

KWS_SCORE = 2.0
KWS_THRESHOLD = 0.05
WAKE_FORMS = {"tohru", "toru", "taro", "tarou", "taru", "tauru", "teru", "tooru", "tohro", "toro", "toroo", "torou", "torru", "torue", "toeru"}
WAKE_SPLIT_FIRST = {"to", "too", "two", "toe", "tow", "toh"}
WAKE_SPLIT_SECOND = {"ru", "rue", "roo", "rew", "ro", "row", "who"}


def emit(event, **fields):
    fields["event"] = event
    try:
        sys.stdout.write(json.dumps(fields, ensure_ascii=False) + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, ValueError):
        os._exit(0)


def log(message):
    print(f"tohru-voice: {message}", file=sys.stderr, flush=True)


def words(text):
    return re.findall(r"[a-z0-9']+", text.lower())


def wake_split(transcript):
    """Returns the request after a leading wake word, "" for the wake word alone, or None without one."""
    tokens = words(transcript)
    if not tokens:
        return None
    used = 0
    if tokens[0] in WAKE_FORMS:
        used = 1
    elif len(tokens) >= 2 and tokens[0] in WAKE_SPLIT_FIRST and tokens[1] in WAKE_SPLIT_SECOND:
        used = 2
    else:
        return None
    rest = tokens[used:]
    return sentence(" ".join(rest))


def wake_possible(transcript):
    """Whether a partial transcript can still turn out to start with the wake word."""
    tokens = words(transcript)
    if not tokens:
        return True
    first = tokens[0]
    if len(tokens) == 1:
        return any(form.startswith(first) for form in WAKE_FORMS) or first in WAKE_SPLIT_FIRST
    return wake_split(transcript) is not None


def sentence(text):
    text = " ".join(text.split()).lower()
    text = re.sub(r"\bi\b", "I", text)
    text = re.sub(r"\bi'(m|ll|d|ve)\b", lambda m: "I'" + m.group(1), text)
    return text[:1].upper() + text[1:]


def speakable(text):
    text = re.sub(r"```.*?```", " (code in the popup) ", text, flags=re.S)
    text = re.sub(r"`([^`]*)`", r"\1", text)
    text = re.sub(r"!?\[([^\]]*)\]\([^)]*\)", r"\1", text)
    text = re.sub(r"[*_#>]+", "", text)
    text = re.sub(r"^\s*[-•]\s+", "", text, flags=re.M)
    text = " ".join(text.split())
    if len(text) <= SPOKEN_CHARS:
        return text
    cut = text[:SPOKEN_CHARS]
    end = max(cut.rfind(". "), cut.rfind("! "), cut.rfind("? "))
    cut = cut[: end + 1] if end > SPOKEN_CHARS // 3 else cut.rsplit(" ", 1)[0] + "…"
    return cut + " The rest is in the chat."


TRANSDUCER_FILES = "tokens.txt, encoder*.onnx, decoder*.onnx, joiner*.onnx"


def transducer_missing(folder):
    if not folder.is_dir():
        return None
    names = [p.name for p in folder.iterdir()]
    missing = [] if (folder / "tokens.txt").is_file() else ["tokens.txt"]
    for part in ("encoder", "decoder", "joiner"):
        if not any(n.startswith(part) and n.endswith(".onnx") for n in names):
            missing.append(f"{part}*.onnx")
    return missing


def onnx_problem(setting, configured, what):
    if not configured:
        return f"{setting} is not set ({what})"
    path = Path(configured).expanduser()
    if not path.is_file() or path.suffix != ".onnx":
        return f"{setting}: no .onnx file at {path} ({what})"
    return None


def folder_problem(setting, configured, what):
    if not configured:
        return f"{setting} is not set ({what}: {TRANSDUCER_FILES})"
    folder = Path(configured).expanduser()
    missing = transducer_missing(folder)
    if missing is None:
        return f"{setting}: {folder} is not a folder ({what}: {TRANSDUCER_FILES})"
    if missing:
        return f"{setting}: {folder} has no {', '.join(missing)} ({what})"
    return None


def check_models(vad, asr, turn, wake, kws):
    """Validates the configured model paths without loading anything: (errors that stop voice, warnings)."""
    errors = [problem for problem in (
        onnx_problem("assistant.vad_model", vad, "the Silero VAD .onnx file"),
        folder_problem("assistant.asr_model", asr, "the sherpa-onnx streaming Zipformer folder"),
        folder_problem("assistant.kws_model", kws, "the sherpa-onnx keyword-spotter folder") if wake == "kws" else None,
    ) if problem]
    warnings = []
    if turn:
        problem = onnx_problem("assistant.turn_model", turn, "the Smart Turn v3.2 .onnx file")
        if problem:
            warnings.append(f"{problem}; turns end on silence only")
    return errors, warnings


class Silero:
    def __init__(self, path, np, ort):
        self.np = np
        options = ort.SessionOptions()
        options.intra_op_num_threads = 1
        options.inter_op_num_threads = 1
        options.add_session_config_entry("session.intra_op.allow_spinning", "0")
        self.session = ort.InferenceSession(str(path), sess_options=options, providers=["CPUExecutionProvider"])
        self.rate = np.array(SAMPLE_RATE, dtype=np.int64)
        self.reset()

    def reset(self):
        self.state = self.np.zeros((2, 1, 128), dtype=self.np.float32)
        self.context = self.np.zeros(64, dtype=self.np.float32)

    def __call__(self, window):
        x = self.np.concatenate([self.context, window])[None, :]
        output, self.state = self.session.run(None, {"input": x, "state": self.state, "sr": self.rate})
        self.context = window[-64:]
        return float(output.reshape(-1)[0])


class SmartTurn:
    """Pipecat Smart Turn v3.2 with WhisperFeatureExtractor(chunk_length=8)'s NumPy transform."""

    def __init__(self, path, np, ort, threads=2):
        self.np = np
        options = ort.SessionOptions()
        options.execution_mode = ort.ExecutionMode.ORT_SEQUENTIAL
        options.graph_optimization_level = ort.GraphOptimizationLevel.ORT_ENABLE_ALL
        options.intra_op_num_threads = threads
        options.inter_op_num_threads = 1
        options.add_session_config_entry("session.intra_op.allow_spinning", "0")
        self.session = ort.InferenceSession(str(path), sess_options=options, providers=["CPUExecutionProvider"])
        self.window = 0.5 - 0.5 * np.cos(2 * np.pi * np.arange(400) / 400)
        self.filters = mel_filters(np)

    def features(self, audio):
        np = self.np
        audio = audio.astype(np.float64)
        audio = (audio - audio.mean()) / np.sqrt(audio.var() + 1e-7)
        padded = np.pad(audio, 200, mode="reflect")
        frames = np.lib.stride_tricks.sliding_window_view(padded, 400)[::160]
        spectrum = np.abs(np.fft.rfft(frames * self.window, axis=1)) ** 2
        mel = self.filters.T @ spectrum.T
        log_spec = np.log10(np.maximum(mel, 1e-10))[:, :-1]
        log_spec = np.maximum(log_spec, log_spec.max() - 8.0)
        return ((log_spec + 4.0) / 4.0)[None].astype(np.float32)

    def probability(self, audio):
        if len(audio) < TURN_WINDOW:
            audio = self.np.concatenate([self.np.zeros(TURN_WINDOW - len(audio), dtype=self.np.float32), audio])
        audio = audio[-TURN_WINDOW:]
        output = self.session.run(None, {"input_features": self.features(audio)})[0]
        return float(min(1.0, max(0.0, output.reshape(-1)[0])))


def mel_filters(np, bins=201, mels=80, rate=SAMPLE_RATE):
    def to_mel(f):
        f = np.asarray(f, dtype=np.float64)
        return np.where(f >= 1000, 15.0 + np.log(np.maximum(f, 1e-10) / 1000) * 27.0 / np.log(6.4), 3.0 * f / 200.0)

    def to_hz(m):
        m = np.asarray(m, dtype=np.float64)
        return np.where(m >= 15, 1000 * np.exp(np.log(6.4) / 27.0 * (m - 15)), 200.0 * m / 3.0)

    fft = np.linspace(0, rate // 2, bins)
    points = to_hz(np.linspace(to_mel(0.0), to_mel(rate / 2), mels + 2))
    diff = np.diff(points)
    slopes = points[None, :] - fft[:, None]
    down = -slopes[:, :-2] / diff[:-1]
    up = slopes[:, 2:] / diff[1:]
    filters = np.maximum(0, np.minimum(down, up))
    return filters * (2.0 / (points[2:] - points[:-2]))[None, :]


def transducer(folder):
    missing = transducer_missing(folder)
    if missing is None:
        raise FileNotFoundError(f"{folder} is not a folder")
    if missing:
        raise FileNotFoundError(f"no {', '.join(missing)} in {folder}")
    files = {p.name: p for p in folder.iterdir()}

    def find(prefix):
        names = sorted(n for n in files if n.startswith(prefix) and n.endswith(".onnx"))
        int8 = [n for n in names if ".int8." in n]
        choice = (int8 or names or [None])[0]
        if choice is None:
            raise FileNotFoundError(f"no {prefix}*.onnx in {folder}")
        return str(files[choice])

    return {"tokens": str(folder / "tokens.txt"), "encoder": find("encoder"), "decoder": find("decoder"), "joiner": find("joiner")}


class Recognizer:
    def __init__(self, folder, sherpa):
        self.recognizer = sherpa.OnlineRecognizer.from_transducer(
            **transducer(folder), num_threads=2, sample_rate=SAMPLE_RATE, feature_dim=80, decoding_method="greedy_search")
        self.stream = None

    def start(self):
        self.stream = self.recognizer.create_stream()
        self.stream.accept_waveform(SAMPLE_RATE, [0.0] * int(SAMPLE_RATE * 0.3))

    def feed(self, samples):
        if self.stream is None:
            self.start()
        self.stream.accept_waveform(SAMPLE_RATE, samples)
        while self.recognizer.is_ready(self.stream):
            self.recognizer.decode_stream(self.stream)

    def partial(self):
        return self.text() if self.stream is not None else ""

    def text(self):
        result = self.recognizer.get_result(self.stream)
        return result if isinstance(result, str) else getattr(result, "text", "")

    def finish(self):
        if self.stream is None:
            return ""
        self.stream.accept_waveform(SAMPLE_RATE, [0.0] * int(SAMPLE_RATE * 0.3))
        self.stream.input_finished()
        while self.recognizer.is_ready(self.stream):
            self.recognizer.decode_stream(self.stream)
        text = self.text()
        self.stream = None
        return text

    def drop(self):
        self.stream = None


class Spotter:
    """A small keyword spotter that hears the wake word for a fraction of the ASR's cost; the ASR then confirms it."""

    def __init__(self, folder, sherpa):
        self.spotter = sherpa.KeywordSpotter(
            **transducer(folder), keywords_file=str(SHIPPED_VOICES / "wake-keywords.txt"), num_threads=1, sample_rate=SAMPLE_RATE,
            feature_dim=80, max_active_paths=4, keywords_score=KWS_SCORE, keywords_threshold=KWS_THRESHOLD,
            num_trailing_blanks=1)
        self.stream = None

    def start(self):
        self.stream = self.spotter.create_stream()

    def feed(self, samples):
        self.stream.accept_waveform(SAMPLE_RATE, samples)
        while self.spotter.is_ready(self.stream):
            self.spotter.decode_stream(self.stream)
            if self.spotter.get_result(self.stream):
                return True
        return False

    def flush(self):
        return self.feed([0.0] * int(SAMPLE_RATE * 0.3))

    def drop(self):
        self.stream = None


def sentences(text, limit=220):
    """Splits an answer at sentence ends so the first one can play while the rest are made."""
    parts, current = [], ""
    for piece in re.split(r"(?<=[.!?…])\s+", text.strip()):
        while len(piece) > limit:
            cut = piece.rfind(" ", 0, limit)
            cut = cut if cut > 0 else limit
            parts.append(piece[:cut])
            piece = piece[cut:].lstrip()
        if current and (not parts or len(current) + len(piece) + 1 > limit):
            parts.append(current)
            current = piece
        else:
            current = f"{current} {piece}".strip()
    if current:
        parts.append(current)
    return [p for p in parts if p.strip()]


# The dragon's mouths, in the order of shell/assistant/dragon/mouths.webp.
REST, MBP, AA, EH, EE, OH, OO, FV = range(8)
VISEMES = {}
for letters, viseme in (("mbpɱ", MBP), ("fv", FV), ("aɑæʌɐaIW", AA), ("eɛəɜɚᵻᵊɘAkgŋhxɡ", EH),
                        ("iɪjytdnlszθðɾɫʔ", EE), ("oɔɒOY", OH), ("uʊwɹrʃʒʤʧɥ", OO)):
    for letter in letters:
        VISEMES[letter] = viseme
VOWELS = set("aɑæʌɐeɛəɜɚᵻᵊɘiɪyoɔɒuʊAIOWY")
VISEME_LEAD_S = 0.04
VISEME_MIN_S = 2 / MOUTH_FPS


def visemes(phonemes):
    """(mouth, weight) for each sound in an IPA or misaki phoneme string; a word gap is a short rest."""
    out = []
    for letter in phonemes:
        if letter in "ːˑ" and out:
            out[-1] = (out[-1][0], out[-1][1] + 0.5)
        elif letter in VISEMES:
            weight = 1.0 if letter in VOWELS else 0.8 if VISEMES[letter] == MBP else 0.6
            out.append((VISEMES[letter], weight))
        elif letter in ",.;:!?—…" and out:
            out.append((REST, 1.2))
        elif letter.isspace() and out and out[-1][0] != REST:
            out.append((REST, 0.15))
    while out and out[-1][0] == REST:
        out.pop()
    return out


def viseme_timeline(sounds, durations, length):
    """Spans (start, end, mouth) in seconds over `length`: by the model's own durations when it gave them, else by weight.
    Spans shorter than two mouth frames join a neighbour, except a closed mouth, which is always seen."""
    if not sounds or length <= 0:
        return []
    shares = durations if durations and len(durations) == len(sounds) and sum(durations) > 0 else [w for _, w in sounds]
    scale = length / sum(shares)
    spans, at = [], 0.0
    for (mouth, _), share in zip(sounds, shares):
        span = share * scale
        if spans and spans[-1][2] == mouth:
            spans[-1][1] = at + span
        else:
            spans.append([at, at + span, mouth])
        at += span
    merged = []
    for span in spans:
        short = span[1] - span[0] < VISEME_MIN_S and span[2] != MBP
        if merged and (short or merged[-1][1] - merged[-1][0] < VISEME_MIN_S and merged[-1][2] != MBP):
            keep = merged[-1] if merged[-1][1] - merged[-1][0] >= span[1] - span[0] else span
            merged[-1] = [merged[-1][0], span[1], keep[2]]
        else:
            merged.append(span)
        if len(merged) > 1 and merged[-2][2] == merged[-1][2]:
            merged[-2:] = [[merged[-2][0], merged[-1][1], merged[-1][2]]]
    return [tuple(s) for s in merged]


def viseme_at(timeline, t):
    for start, end, mouth in timeline:
        if start <= t < end:
            return mouth
    return REST


def voiced(np, audio, rate, floor=0.01):
    """Where speech starts and ends in a clip, ignoring the synthesiser's lead-in and tail silence."""
    step = max(1, rate // 100)
    loud = [i for i in range(0, len(audio), step) if float(np.sqrt(np.mean(audio[i:i + step] ** 2))) > floor]
    if not loud:
        return 0.0, len(audio) / rate
    return loud[0] / rate, min(len(audio), loud[-1] + step) / rate


class Espeak:
    """The fallback voice: espeak-ng, no model, a few ms of CPU per sentence."""

    name = "espeak-ng"

    def __init__(self, settings):
        self.voice = settings.get("voice", "en-us+f3")
        self.speed = int(settings.get("speed", 100))
        self.pitch = int(settings.get("pitch", 3))

    def load(self):
        pass

    def unload(self):
        pass

    def stream(self, text, np):
        wpm = round(175 * self.speed / 100)
        pitch = max(0, min(99, 50 + 4 * self.pitch))
        for part in sentences(text):
            result = subprocess.run(["espeak-ng", "--stdout", "-v", self.voice, "-s", str(wpm), "-p", str(pitch), part],
                                    capture_output=True, timeout=30)
            if result.returncode != 0 or not result.stdout:
                raise RuntimeError(result.stderr.decode(errors="replace").strip() or "espeak-ng failed")
            with wave.open(BytesIO(result.stdout)) as w:
                rate = w.getframerate()
                frames = w.readframes(w.getnframes())
            audio = np.frombuffer(frames, dtype=np.int16).astype(np.float32) / 32768
            yield audio, rate, part, self.timeline(part, np, audio, rate, wpm, pitch)

    def timeline(self, part, np, audio, rate, wpm, pitch):
        try:
            ipa = subprocess.run(["espeak-ng", "-q", "--ipa", "-v", self.voice, "-s", str(wpm), "-p", str(pitch), part],
                                 capture_output=True, timeout=10, text=True).stdout
        except (OSError, subprocess.SubprocessError):
            return []
        start, end = voiced(np, audio, rate)
        return [(a + start, b + start, m) for a, b, m in viseme_timeline(visemes(ipa), None, end - start)]


KOKORO_RATE = 24_000


def kokoro_files(settings):
    if not settings.get("model"):
        raise FileNotFoundError("assistant.tts_model is not set (the Kokoro folder holding model.onnx, tokenizer.json and voices/)")
    folder = Path(settings["model"]).expanduser()
    model = next((folder / name for name in ("model.onnx", "kokoro-v1.0.onnx", "model_fp32.onnx") if (folder / name).is_file()), None)
    vocab = folder / "tokenizer.json"
    if model is None or not vocab.is_file():
        raise FileNotFoundError(f"assistant.tts_model: {folder} has no model.onnx and tokenizer.json")
    pack = str(settings.get("voicepack") or "tide")
    if pack.startswith("/"):
        pack_path = Path(pack)
    elif pack == "tide":
        pack_path = SHIPPED_VOICES / "tohru-tide.bin"
    else:
        pack_path = folder / "voices" / f"{pack}.bin"
    if not re.match(r"^(/.*|[A-Za-z0-9_.-]+)$", pack) or ".." in pack or not pack_path.is_file():
        raise FileNotFoundError(f"no voicepack {pack} ({pack_path})")
    return model, vocab, pack_path


class Kokoro:
    """Kokoro-82M in a child process, so unloading frees every byte; misaki for phonemes."""

    name = "kokoro"

    def __init__(self, settings):
        self.files = kokoro_files(settings)
        self.speed = max(0.5, min(2.0, int(settings.get("speed", 100)) / 100))
        self.worker = None
        self.lock = threading.Lock()

    def load(self):
        with self.lock:
            if self.worker is None or self.worker.poll() is not None:
                model, vocab, pack = self.files
                self.worker = subprocess.Popen(
                    [sys.executable, os.path.realpath(__file__), "--tts-worker", str(model), str(vocab), str(pack)],
                    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
                header = self.worker.stdout.readline()
                if not header.startswith(b'{"ready"'):
                    self.worker.kill()
                    self.worker = None
                    raise RuntimeError("the Kokoro worker failed to start")
            return self.worker

    def unload(self):
        with self.lock:
            worker, self.worker = self.worker, None
        if worker and worker.poll() is None:
            worker.terminate()
            try:
                worker.wait(3)
            except subprocess.TimeoutExpired:
                worker.kill()

    def loaded(self):
        return self.worker is not None and self.worker.poll() is None

    def stream(self, text, np):
        worker = self.load()
        for part in sentences(text):
            worker.stdin.write((json.dumps({"text": part, "speed": self.speed}) + "\n").encode())
            worker.stdin.flush()
            header = json.loads(worker.stdout.readline() or b'{"error": "the Kokoro worker exited"}')
            if "error" in header:
                raise RuntimeError(header["error"])
            size = int(header["samples"]) * 4
            data = b""
            while len(data) < size:
                chunk = worker.stdout.read(size - len(data))
                if not chunk:
                    raise RuntimeError("the Kokoro worker exited")
                data += chunk
            audio = np.frombuffer(data, dtype="<f4")
            yield audio, KOKORO_RATE, part, kokoro_timeline(np, audio, header.get("phonemes", ""), header.get("durations"))


def kokoro_timeline(np, audio, phonemes, durations):
    """Kokoro's own durations, one per token with the pad either side, place each mouth; without them the
    misaki phonemes are spread over the voiced part of the clip."""
    length = len(audio) / KOKORO_RATE
    if durations and len(durations) == len(phonemes) + 2:
        sounds, shares = [(REST, 0.0)], [durations[0]]
        for letter, share in zip(phonemes, durations[1:-1]):
            mouth = sounds[-1][0] if letter in "ːˑ" else VISEMES.get(letter, REST)
            sounds.append((mouth, 1.0))
            shares.append(share)
        sounds.append((REST, 0.0))
        shares.append(durations[-1])
        return viseme_timeline(sounds, shares, length)
    start, end = voiced(np, audio, KOKORO_RATE)
    return [(a + start, b + start, m) for a, b, m in viseme_timeline(visemes(phonemes), None, end - start)]


def tts_worker(model, vocab_path, pack_path):
    """Kokoro synthesis on stdin/stdout: a JSON line in, a JSON header and raw float32 samples out."""
    import types
    # misaki imports torch and transformers only for a neural fallback that is never used here.
    sys.modules.setdefault("torch", types.ModuleType("torch"))
    shim = types.ModuleType("transformers")
    shim.BartForConditionalGeneration = None
    sys.modules.setdefault("transformers", shim)
    import numpy as np
    import onnxruntime as ort
    from misaki import en, espeak
    g2p = en.G2P(trf=False, british=False, fallback=espeak.EspeakFallback(british=False))
    vocab = json.loads(Path(vocab_path).read_text(encoding="utf-8"))["model"]["vocab"]
    pack = np.fromfile(pack_path, dtype="<f4")
    if pack.size % 256 or pack.size // 256 < 2:
        raise SystemExit("voicepack must be rows of 256 float32 values")
    pack = pack.reshape(-1, 256)
    options = ort.SessionOptions()
    options.intra_op_num_threads = 4
    options.inter_op_num_threads = 1
    session = ort.InferenceSession(str(model), options, providers=["CPUExecutionProvider"])
    out = sys.stdout.buffer
    out.write(b'{"ready": true}\n')
    out.flush()
    for line in sys.stdin.buffer:
        try:
            request = json.loads(line)
            phonemes, _ = g2p(str(request["text"]))
            kept = [c for c in phonemes if c in vocab][: min(510, len(pack) - 1)]
            ids = [vocab[c] for c in kept]
            durations = None
            if ids:
                outputs = session.run(None, {"input_ids": np.array([[0, *ids, 0]], dtype=np.int64),
                                             "style": pack[len(ids)][None, :].astype(np.float32),
                                             "speed": np.array([float(request.get("speed", 1.0))], dtype=np.float32)})
                audio = outputs[0][0]
                # Exports that also return the predicted durations give the mouth exact timing.
                if len(outputs) > 1 and np.asarray(outputs[1]).size == len(ids) + 2:
                    durations = [float(d) for d in np.asarray(outputs[1]).reshape(-1)]
            else:
                audio = np.zeros(0, dtype=np.float32)
            audio = np.asarray(audio, dtype="<f4")
            header = {"samples": int(audio.size), "phonemes": "".join(kept)}
            if durations:
                header["durations"] = durations
            out.write((json.dumps(header) + "\n").encode())
            out.write(audio.tobytes())
        except Exception as error:
            out.write((json.dumps({"error": str(error)[:300]}) + "\n").encode())
        out.flush()
    return 0


ENGINES = {"kokoro": Kokoro, "espeak-ng": Espeak}
SHIPPED_VOICES = next((p for p in (Path(__file__).resolve().parent.parent / "shell/assistant/voice",
                                   Path(__file__).resolve().parent.parent / "share/tohru/shell/assistant/voice") if p.is_dir()),
                      Path(__file__).resolve().parent.parent / "shell/assistant/voice")
DRAGON_ART = SHIPPED_VOICES.parent / "dragon"


def make_engine(settings, warn=None):
    """The configured engine; Kokoro falls back to espeak-ng (with an error) when its files are missing."""
    engine = ENGINES.get(settings.get("engine", "kokoro"), Kokoro)
    try:
        return engine(settings)
    except (OSError, ValueError) as error:
        if engine is Espeak:
            raise
        (warn or (lambda message: emit("error", message=message)))(f"speech: {error}; using espeak-ng")
        return Espeak(settings)


class Speaker:
    """Plays one answer at a time and reports the mouth envelope; hush() stops it at once."""

    def __init__(self, np, voice):
        self.np = np
        self.voice = voice
        self.engine = Espeak({})
        self.jobs = queue.Queue()
        self.stop = threading.Event()
        self.speaking = False
        self.level = 0.0
        self.recent = []
        self.quiet_after = 0.0
        self.player = None
        threading.Thread(target=self.loop, daemon=True).start()

    def echo_level(self):
        """The loudest playback in the last moments: what the microphone may still be hearing of it."""
        now = time.monotonic()
        return max((v for t, v in self.recent if now - t < ECHO_TAIL_S), default=0.0)

    def deaf(self):
        return time.monotonic() < self.quiet_after

    def say(self, text, conversation):
        self.hush()
        self.stop.clear()
        self.jobs.put((text, conversation))

    def hush(self):
        self.stop.set()
        player = self.player
        if player and player.poll() is None:
            player.kill()

    def loop(self):
        while True:
            text, conversation = self.jobs.get()
            if self.stop.is_set():
                continue
            try:
                self.play(text, conversation)
            except Exception as error:
                emit("error", message=f"speech failed: {error}")
            finally:
                self.speaking = False
                self.level = 0.0
                self.quiet_after = time.monotonic() + ECHO_TAIL_S
                emit("speaking", on=False, conversation=conversation)
                self.voice.spoke()

    def play(self, text, conversation):
        np = self.np
        played = 0.0
        started = None
        rate = None
        for audio, chunk_rate, part, timeline in self.engine.stream(text, np):
            if self.stop.is_set():
                break
            if self.player is None or rate != chunk_rate:
                self.close_player()
                rate = chunk_rate
                self.player = subprocess.Popen(
                    ["pacat", "--playback", "--raw", "--format=s16le", f"--rate={rate}", "--channels=1",
                     "--client-name=tohru-voice", "--stream-name=Dragon", "--latency-msec=60"],
                    stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                started, played = time.monotonic(), 0.0
            if not self.speaking:
                self.speaking = True
                emit("speaking", on=True, conversation=conversation)
            emit("sentence", text=part)
            step = rate // MOUTH_FPS
            pcm = (np.clip(audio, -1, 1) * 32767).astype(np.int16).tobytes()
            if time.monotonic() > started + played:
                started, played = time.monotonic(), 0.0
            for index in range(0, len(audio), step):
                if self.stop.is_set():
                    break
                chunk = audio[index:index + step]
                rms = float(np.sqrt(np.mean(chunk * chunk))) if len(chunk) else 0.0
                self.level = rms
                now = time.monotonic()
                self.recent = [(t, v) for t, v in self.recent if now - t < ECHO_TAIL_S] + [(now, rms)]
                try:
                    self.player.stdin.write(pcm[index * 2:(index + step) * 2])
                    self.player.stdin.flush()
                except (BrokenPipeError, ValueError):
                    self.stop.set()
                    break
                mouth = 0.0 if rms < 1e-4 else max(0.0, min(1.0, (20 * math.log10(rms) + 42) / 30))
                if timeline:
                    shape = viseme_at(timeline, index / rate + VISEME_LEAD_S) if mouth > 0.05 else REST
                    emit("mouth", level=round(mouth, 2), viseme=shape)
                else:
                    emit("mouth", level=round(mouth, 2))
                played += len(chunk) / rate
                delay = started + played - time.monotonic()
                if delay > 0:
                    time.sleep(delay)
        self.close_player()
        emit("mouth", level=0)

    def close_player(self):
        player, self.player = self.player, None
        if player is None:
            return
        try:
            player.stdin.close()
        except (BrokenPipeError, ValueError):
            pass
        if self.stop.is_set():
            player.kill()
        player.wait()


class Monitor:
    """Pauses listening while the session is locked."""

    def __init__(self, voice):
        self.voice = voice
        self.locked = False
        runtime = os.environ.get("XDG_RUNTIME_DIR", "")
        self.lock_file = os.environ.get("TOHRU_VOICE_LOCK_FILE") or (os.path.join(runtime, "tohru-lock.lock") if runtime else "")
        threading.Thread(target=self.watch_locks, daemon=True).start()

    def is_locked(self):
        if not self.lock_file or not os.path.exists(self.lock_file):
            return False
        try:
            fd = os.open(self.lock_file, os.O_RDONLY)
        except OSError:
            return False
        try:
            fcntl.flock(fd, fcntl.LOCK_SH | fcntl.LOCK_NB)
            fcntl.flock(fd, fcntl.LOCK_UN)
            return False
        except BlockingIOError:
            return True
        finally:
            os.close(fd)

    def watch_locks(self):
        while True:
            locked = self.is_locked()
            if locked != self.locked:
                self.locked = locked
                self.voice.paused_changed()
            time.sleep(2)


class Voice:
    def __init__(self, np, ort, sherpa, vad, asr, turn=None, kws=None):
        self.np = np
        self.warning = ""
        self.silero = Silero(vad, np, ort)
        self.recognizer = Recognizer(asr, sherpa)
        self.turn = SmartTurn(turn, np, ort) if turn else None
        self.spotter = Spotter(kws, sherpa) if kws else None
        self.speaker = Speaker(np, self)
        self.lock = threading.Lock()
        self.capture = None
        self.paused_reason = None
        self.conversation_until = 0.0
        self.thinking = False
        self.load_on_conversation = False
        self.reset_utterance()
        self.monitor = Monitor(self)

    def reset_utterance(self):
        if getattr(self, "hearing", False):
            emit("hearing", on=False)
        self.hearing = False
        self.in_speech = False
        self.start_run = 0
        self.quiet_ms = 0.0
        self.speech_ms = 0.0
        self.utterance = []
        self.rejected = False
        self.turn_checked = False
        self.turn_complete = None
        self.barge_ms = 0.0
        self.preroll = []
        self.spotting = False
        self.recognizer.drop()
        if self.spotter is not None:
            self.spotter.drop()

    def conversation(self, on):
        emit("conversation", on=on)
        if self.load_on_conversation:
            engine = self.speaker.engine
            threading.Thread(target=engine.load if on else engine.unload, daemon=True).start()

    def set_engine(self, settings, warn=None):
        old = self.speaker.engine
        self.load_on_conversation = bool(settings.get("load_on_conversation"))
        engine = make_engine(settings, warn)
        self.speaker.hush()
        self.speaker.engine = engine
        old.unload()
        if not self.load_on_conversation or self.in_conversation():
            threading.Thread(target=self.load_engine, args=(engine,), daemon=True).start()

    def load_engine(self, engine):
        try:
            engine.load()
        except Exception as error:
            emit("error", message=f"speech: {error}")

    def in_conversation(self):
        return time.monotonic() < self.conversation_until

    def extend_conversation(self):
        self.conversation_until = time.monotonic() + CONVERSATION_SECONDS

    def spoke(self):
        if self.conversation_until:
            self.extend_conversation()

    def paused_changed(self):
        reason = "locked" if self.monitor.locked else None
        if reason == self.paused_reason:
            return
        self.paused_reason = reason
        if reason:
            self.speaker.hush()
            self.stop_capture()
            emit("paused", reason=reason)
        else:
            emit("paused", reason="")

    def source(self):
        configured = os.environ.get("TOHRU_VOICE_SOURCE")
        if configured:
            return configured
        try:
            names = subprocess.run(["pactl", "list", "short", "sources"], capture_output=True, text=True, timeout=5).stdout
        except (OSError, subprocess.TimeoutExpired):
            return None
        for line in names.splitlines():
            parts = line.split("\t")
            if len(parts) > 1 and "echo-cancel" in parts[1] and not parts[1].endswith(".monitor"):
                return parts[1]
        return None

    def start_capture(self):
        argv = ["parec", "--raw", "--format=s16le", f"--rate={SAMPLE_RATE}", "--channels=1", "--latency-msec=32",
                "--client-name=tohru-voice", "--stream-name=Wake word"]
        source = self.source()
        if source:
            argv.append(f"--device={source}")
        self.capture = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, bufsize=0)
        emit("listening", on=True, source=source or "default")

    def stop_capture(self):
        capture = self.capture
        self.capture = None
        if capture and capture.poll() is None:
            capture.terminate()
            try:
                capture.wait(2)
            except subprocess.TimeoutExpired:
                capture.kill()
        if capture:
            emit("listening", on=False)
        self.silero.reset()
        self.reset_utterance()

    def run(self):
        emit("ready", turn=self.turn is not None, warning=self.warning, dragon=str(DRAGON_ART))
        need = WINDOW * 2
        while True:
            if self.paused_reason:
                time.sleep(0.25)
                continue
            if self.capture is None:
                self.start_capture()
            data = b""
            capture = self.capture
            while capture and len(data) < need:
                chunk = capture.stdout.read(need - len(data))
                if not chunk:
                    break
                data += chunk
            if len(data) < need:
                if self.capture is capture and not self.paused_reason:
                    self.stop_capture()
                    emit("error", message="the microphone stream ended")
                    time.sleep(2)
                continue
            window = self.np.frombuffer(data, dtype=self.np.int16).astype(self.np.float32) / 32768
            with self.lock:
                self.step(window)

    def step(self, window):
        np = self.np
        probability = self.silero(window)
        rms = float(np.sqrt(np.mean(window * window)))
        if self.speaker.speaking:
            self.listen_for_barge(window, probability, rms)
            return
        if self.speaker.deaf() and not self.in_speech:
            self.start_run = 0
            return
        if not self.in_speech:
            self.preroll.append(window)
            self.preroll = self.preroll[-max(1, round(PREROLL_MS / WINDOW_MS)):]
            self.start_run = self.start_run + 1 if probability >= SPEECH_START else 0
            if self.start_run >= SPEECH_START_WINDOWS:
                self.begin(self.preroll)
            if self.conversation_until and not self.in_conversation() and not self.thinking:
                self.conversation_until = 0.0
                self.conversation(False)
            return
        self.hear(window, probability >= SPEECH_CONTINUE)

    def begin(self, preroll):
        self.in_speech = True
        self.quiet_ms = 0.0
        self.speech_ms = 0.0
        self.turn_checked = False
        self.turn_complete = None
        self.rejected = False
        self.utterance = list(preroll)
        self.preroll = []
        self.spotting = self.spotter is not None and not self.in_conversation()
        if self.in_conversation():
            self.hearing = True
            emit("hearing", on=True)
        if self.spotting:
            self.spotter.start()
            for w in preroll:
                self.spotter.feed(w)
            return
        self.recognizer.start()
        for w in preroll:
            self.recognizer.feed(w)

    def hear(self, window, speech):
        self.utterance.append(window)
        self.speech_ms += WINDOW_MS
        if speech:
            self.quiet_ms = 0.0
            self.turn_checked = False
            self.turn_complete = None
        else:
            self.quiet_ms += WINDOW_MS
        if self.spotting:
            self.spot(window, speech)
        elif not self.rejected and (speech or self.quiet_ms <= TAIL_MS):
            self.recognizer.feed(window)
        if not self.rejected and not self.spotting and not self.in_conversation() and self.speech_ms >= 320:
            partial = self.recognizer.partial()
            if not wake_possible(partial) or (self.speech_ms >= WAKE_DECIDE_MS and wake_split(partial) is None):
                self.rejected = True
                self.recognizer.drop()
        if self.quiet_ms >= PAUSE_MS and not self.turn_checked:
            self.turn_checked = True
            if self.turn is not None and not self.rejected:
                audio = np_concat(self.np, self.utterance)
                self.turn_complete = self.turn.probability(audio) > TURN_COMPLETE
        hold = SILENCE_FALLBACK_MS if self.turn_complete is None else (PAUSE_MS if self.turn_complete else INCOMPLETE_HOLD_MS)
        if self.rejected and self.quiet_ms >= PAUSE_MS:
            self.reset_utterance()
            return
        if self.quiet_ms >= hold or self.speech_ms >= MAX_UTTERANCE_MS:
            self.end_turn()

    def spot(self, window, speech):
        heard = (speech or self.quiet_ms <= TAIL_MS) and self.spotter.feed(window)
        if not heard and (self.speech_ms >= WAKE_DECIDE_MS or self.quiet_ms >= PAUSE_MS):
            heard = self.spotter.flush()
            if not heard:
                self.rejected = True
        if heard or self.rejected:
            self.spotting = False
            self.spotter.drop()
        if heard:
            self.recognizer.start()
            for w in self.utterance:
                self.recognizer.feed(w)

    def end_turn(self):
        transcript = "" if self.rejected else self.recognizer.finish()
        self.reset_utterance()
        self.deliver(transcript)

    def deliver(self, transcript):
        if not transcript.strip():
            return
        if self.in_conversation():
            request = wake_split(transcript)
            request = sentence(transcript) if request is None else request
            self.extend_conversation()
            if request:
                self.thinking = True
                emit("turn", text=request)
            return
        request = wake_split(transcript)
        if request is None:
            return
        self.extend_conversation()
        self.conversation(True)
        if request:
            self.thinking = True
            emit("turn", text=request)
        else:
            emit("wake")

    def listen_for_barge(self, window, probability, rms):
        floor = max(BARGE_FLOOR, ECHO_MARGIN * self.speaker.echo_level())
        if probability >= SPEECH_START and rms > floor:
            self.barge_ms += WINDOW_MS
        elif probability < SPEECH_CONTINUE or rms < floor / 2:
            self.barge_ms = 0.0
        self.preroll.append(window)
        self.preroll = self.preroll[-max(1, round(BARGE_MS / WINDOW_MS) + 2):]
        if self.barge_ms >= BARGE_MS:
            self.speaker.hush()
            self.barge_ms = 0.0
            emit("barge")
            self.extend_conversation()
            self.begin(self.preroll)

    def command(self, message):
        cmd = message.get("cmd")
        if cmd == "say":
            text = speakable(str(message.get("text", "")))
            self.thinking = False
            if text and not self.paused_reason:
                self.speaker.say(text, message.get("conversation"))
            else:
                self.spoke()
        elif cmd == "hush":
            self.speaker.hush()
        elif cmd == "thinking":
            self.thinking = bool(message.get("on"))
            if not self.thinking:
                self.spoke()
        elif cmd == "tts":
            try:
                self.set_engine(message)
            except Exception as error:
                emit("error", message=f"speech settings: {error}")
        elif cmd == "end":
            self.conversation_until = 0.0
            self.conversation(False)


def np_concat(np, windows):
    return np.concatenate(windows) if windows else np.zeros(0, dtype=np.float32)


def read_commands(voice):
    for line in sys.stdin:
        try:
            message = json.loads(line)
        except ValueError:
            continue
        if isinstance(message, dict):
            with voice.lock:
                voice.command(message)
    os._exit(0)


def main():
    os.environ.setdefault("OPENBLAS_NUM_THREADS", "1")
    os.environ.setdefault("OMP_NUM_THREADS", "1")
    signal.signal(signal.SIGTERM, lambda *_: os._exit(0))
    signal.signal(signal.SIGINT, lambda *_: os._exit(0))
    if len(sys.argv) == 5 and sys.argv[1] == "--tts-worker":
        return tts_worker(*sys.argv[2:])
    parser = argparse.ArgumentParser(prog="tohru-voice")
    parser.add_argument("--vad-model", default="")
    parser.add_argument("--asr-model", default="")
    parser.add_argument("--turn-model", default="")
    parser.add_argument("--tts-engine", default="kokoro")
    parser.add_argument("--tts-model", default="")
    parser.add_argument("--tts-voicepack", default="tide")
    parser.add_argument("--tts-voice", default="en-us+f3")
    parser.add_argument("--tts-speed", type=int, default=100)
    parser.add_argument("--tts-pitch", type=int, default=3)
    parser.add_argument("--tts-load-on-conversation", action="store_true")
    parser.add_argument("--wake", choices=("kws", "asr"), default="asr")
    parser.add_argument("--kws-model", default="")
    args = parser.parse_args()
    errors, warnings = check_models(args.vad_model, args.asr_model, args.turn_model, args.wake, args.kws_model)
    if errors:
        emit("error", message=f"Voice is off until its models are set. {'; '.join(errors)}")
        return 3
    for tool in ("parec", "pacat", "pactl", "espeak-ng"):
        if not shutil.which(tool):
            emit("error", message=f"{tool} is not installed")
            return 3
    import numpy as np
    import onnxruntime as ort
    import sherpa_onnx as sherpa
    ort.set_default_logger_severity(3)
    turn = Path(args.turn_model).expanduser() if args.turn_model and not warnings else None
    voice = Voice(np, ort, sherpa, Path(args.vad_model).expanduser(), Path(args.asr_model).expanduser(), turn,
                  Path(args.kws_model).expanduser() if args.wake == "kws" else None)
    try:
        voice.set_engine({"engine": args.tts_engine, "model": args.tts_model, "voicepack": args.tts_voicepack,
                          "voice": args.tts_voice, "speed": args.tts_speed, "pitch": args.tts_pitch,
                          "load_on_conversation": args.tts_load_on_conversation}, warnings.append)
    except Exception as error:
        warnings.append(f"speech settings: {error}")
    voice.warning = "; ".join(warnings)
    threading.Thread(target=read_commands, args=(voice,), daemon=True).start()
    voice.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
