#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
export TOHRU_SHELL=1
# The wallpaper popup runs tohru-wallpaper from beside this script.
export PATH="$root/bin:$PATH"
scene=${TOHRU_SCENE:-$root/shell/bar.plm}
[[ -z ${TOHRU_SHELL_DIR:-} ]] || scene=$TOHRU_SHELL_DIR/bar.plm
exec "${TOHRU_RUNTIME_OVERRIDE:-${TOHRU_RUNTIME:-pleamar}}" --scene "$scene" --no-hud --stall 0 --answer-as tohru "$@"
