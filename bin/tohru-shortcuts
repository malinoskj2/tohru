#!/usr/bin/env python3
"""Disabled/compositor mode does not import a portal client or activate anything."""
import asyncio
import sys
from tohru_portability import config


def main():
    values,_=config()
    if sys.argv[1:]==['--check-dependencies']:
        import importlib.util
        import json
        print(json.dumps({'dbus_fast':importlib.util.find_spec('dbus_fast') is not None}))
        return 0
    if len(sys.argv)!=1:raise ValueError('usage: tohru-shortcuts [--check-dependencies]')
    if values['shortcuts.mode']!='portal':
        print('tohru-shortcuts: portal ownership disabled (mode '+values['shortcuts.mode']+')')
        return 0
    try:
        from tohru_shortcuts import serve
    except ImportError:
        print('tohru-shortcuts: install optional dbus-fast; see docs/standalone.md',file=sys.stderr)
        return 2
    asyncio.run(serve(values))
    return 0


if __name__=='__main__':
    try:sys.exit(main())
    except (OSError,ValueError,RuntimeError,asyncio.TimeoutError) as error:
        print(f'tohru-shortcuts: {error}',file=sys.stderr);sys.exit(1)
