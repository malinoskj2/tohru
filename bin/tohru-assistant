#!/usr/bin/env python3
import argparse
import json
import math
import os
import re
import shutil
import signal
import sqlite3
import subprocess
import sys
import tempfile
import threading
import time
import tomllib
import uuid
from pathlib import Path

HOME = Path.home()


def xdg(name, fallback):
    value = os.environ.get(name)
    return Path(value) if value and os.path.isabs(value) else HOME / fallback


DATA = Path(os.environ.get("TOHRU_ASSISTANT_DATA") or xdg("XDG_DATA_HOME", ".local/share") / "tohru")
SCRATCH = Path(os.environ.get("TOHRU_ASSISTANT_SCRATCH") or xdg("XDG_STATE_HOME", ".local/state") / "tohru/assistant/scratch")
CONVERSATION_ID = re.compile(r"^[0-9a-f]{32}$")
PROBE_SECONDS = 6
TITLE_CHARS = 48


def read_json(path):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def quiet(command, timeout=PROBE_SECONDS):
    try:
        return subprocess.run(command, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              timeout=timeout, cwd=str(HOME), start_new_session=True)
    except (OSError, subprocess.TimeoutExpired):
        return None


def file_has_content(path):
    try:
        return Path(path).stat().st_size > 2
    except OSError:
        return False


def claude_signed_in():
    result = quiet(["claude", "auth", "status"])
    if result is not None and result.stdout.strip().startswith("{"):
        try:
            return bool(json.loads(result.stdout).get("loggedIn"))
        except ValueError:
            pass
    return file_has_content(HOME / ".claude/.credentials.json") or bool(os.environ.get("ANTHROPIC_API_KEY"))


def codex_signed_in():
    result = quiet(["codex", "login", "status"])
    if result is not None:
        return result.returncode == 0
    return file_has_content(HOME / ".codex/auth.json")


def gemini_signed_in():
    return file_has_content(HOME / ".gemini/oauth_creds.json") or bool(os.environ.get("GEMINI_API_KEY"))


def agy_signed_in():
    return file_has_content(HOME / ".gemini/antigravity-cli/antigravity-oauth-token")


def opencode_signed_in():
    auth = read_json(xdg("XDG_DATA_HOME", ".local/share") / "opencode/auth.json")
    return isinstance(auth, dict) and len(auth) > 0


def opencode_configured_model():
    config = read_json(xdg("XDG_CONFIG_HOME", ".config") / "opencode/opencode.json") or {}
    model = config.get("model") if isinstance(config, dict) else None
    return model if isinstance(model, str) else ""


# Used when assistant.models.<provider>.model or .effort is empty. OpenCode routes to whichever
# providers the user configured, so no model ID is valid everywhere; it keeps its own default.
DEFAULT_MODELS = {
    "claude": ("claude-opus-5-5", "medium"),
    "codex": ("gpt-6.2-sol", "medium"),
    "gemini": ("gemini-4-neon", "high"),
    "agy": ("gemini-4-neon", "high"),
    "opencode": ("", ""),
}
EFFORTS = ("minimal", "low", "medium", "high", "xhigh", "max")
# Each CLI's own names for the levels it has.
EFFORT_NAMES = {
    "claude": {"minimal": "low", "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max"},
    "codex": {"minimal": "minimal", "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "xhigh"},
    "gemini": {"minimal": "MINIMAL", "low": "LOW", "medium": "MEDIUM", "high": "HIGH", "xhigh": "HIGH", "max": "HIGH"},
    "agy": {"minimal": "low", "low": "low", "medium": "medium", "high": "high", "xhigh": "xhigh", "max": "max"},
    "opencode": {level: level for level in EFFORTS},
}
MODEL_TEXT = re.compile(r"^[A-Za-z0-9._:/@#+-]{0,128}$")


def resolve_model(ident, model="", effort=""):
    """The model and effort a provider runs with: the configured ones, else Tohru's default for it."""
    default_model, default_effort = DEFAULT_MODELS.get(ident, ("", ""))
    model = model if model and MODEL_TEXT.match(model) else default_model
    effort = effort if effort in EFFORTS else default_effort
    return model, effort


def pretty_model(model):
    model = re.sub(r"\[.*\]$", "", model)
    match = re.match(r"^claude-(opus|sonnet|haiku|fable)-(\d+)-(\d+)", model)
    if match:
        return f"{match.group(1).capitalize()} {match.group(2)}.{match.group(3)}"
    match = re.match(r"^gemini-(\d+(?:\.\d+)?)-([a-z]+)$", model)
    if match:
        return f"Gemini {match.group(1)} {match.group(2).capitalize()}"
    return model.split("/", 1)[-1]


def model_label(ident, model, effort):
    if ident == "opencode" and not model:
        model = opencode_configured_model()
    name = pretty_model(model) if model else ""
    return f"{name} · {effort}" if name and effort else name


class Provider:
    def __init__(self, slot, ident, name, signed_in, login):
        self.slot = slot
        self.id = ident
        self.name = name
        self.signed_in = signed_in
        self.login = login

    def installed(self):
        return shutil.which(self.id) is not None


PROVIDERS = [
    Provider(0, "claude", "Claude", claude_signed_in, ["claude", "auth", "login"]),
    Provider(1, "codex", "Codex", codex_signed_in, ["codex", "login"]),
    Provider(2, "gemini", "Gemini", gemini_signed_in, ["gemini"]),
    Provider(3, "agy", "Antigravity", agy_signed_in, ["agy"]),
    Provider(4, "opencode", "OpenCode", opencode_signed_in, ["opencode", "auth", "login"]),
]
BY_ID = {p.id: p for p in PROVIDERS}


def discover(models=None):
    """The installed CLIs; models maps a provider to its configured {"model", "effort"}."""
    models = models if isinstance(models, dict) else {}
    found = [p for p in PROVIDERS if p.installed()]
    results = {}

    def probe(provider):
        try:
            results[provider.id] = bool(provider.signed_in())
        except Exception:
            results[provider.id] = False

    threads = [threading.Thread(target=probe, args=(p,), daemon=True) for p in found]
    for t in threads:
        t.start()
    for t in threads:
        t.join(PROBE_SECONDS + 1)
    out = []
    for p in found:
        chosen = models.get(p.id) if isinstance(models.get(p.id), dict) else {}
        model, effort = resolve_model(p.id, str(chosen.get("model") or ""), str(chosen.get("effort") or ""))
        out.append({"id": p.id, "name": p.name, "slot": p.slot, "signed_in": results.get(p.id, False),
                    "model": model_label(p.id, model, effort), "model_id": model, "effort": effort})
    return out


def terminal_command(argv):
    configured = os.environ.get("TOHRU_TERMINAL")
    if configured:
        return configured.split() + argv
    if shutil.which("xdg-terminal-exec"):
        return ["xdg-terminal-exec"] + argv
    terminal = os.environ.get("TERMINAL")
    if terminal and shutil.which(terminal.split()[0]):
        return terminal.split() + ["-e"] + argv
    for name in ("foot", "kitty", "alacritty", "wezterm", "ghostty", "konsole", "gnome-terminal", "xterm"):
        if shutil.which(name):
            if name == "wezterm":
                return [name, "start", "--"] + argv
            if name == "gnome-terminal":
                return [name, "--wait", "--"] + argv
            return [name, "-e"] + argv
    return None


def signin(ident):
    provider = BY_ID.get(ident)
    if provider is None or not provider.installed():
        raise SystemExit(f"tohru-assistant: {ident} is not installed")
    command = terminal_command(provider.login)
    if command is None:
        raise SystemExit("tohru-assistant: no terminal found; set TOHRU_TERMINAL")
    subprocess.run(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   cwd=str(HOME))
    emit(next((p for p in discover() if p["id"] == ident), {"id": ident, "signed_in": False}))


def emit(value):
    sys.stdout.write(json.dumps(value, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def private_dir(path):
    path.mkdir(parents=True, exist_ok=True, mode=0o700)
    return path


MIGRATIONS = [
    """
    CREATE TABLE conversations (
        id TEXT PRIMARY KEY,
        title TEXT NOT NULL,
        provider TEXT NOT NULL,
        created INTEGER NOT NULL,
        updated INTEGER NOT NULL,
        voice INTEGER NOT NULL DEFAULT 0,
        sessions TEXT NOT NULL DEFAULT '{}',
        forgotten INTEGER NOT NULL DEFAULT 0,
        remembered INTEGER NOT NULL DEFAULT 0
    );
    CREATE TABLE turns (
        rowid INTEGER PRIMARY KEY,
        id TEXT NOT NULL UNIQUE,
        conversation_id TEXT NOT NULL REFERENCES conversations(id) ON DELETE CASCADE,
        seq INTEGER NOT NULL,
        role TEXT NOT NULL CHECK (role IN ('user', 'assistant')),
        text TEXT NOT NULL,
        time INTEGER NOT NULL,
        provider TEXT NOT NULL DEFAULT '',
        voice INTEGER NOT NULL DEFAULT 0,
        stopped INTEGER NOT NULL DEFAULT 0,
        error TEXT NOT NULL DEFAULT '',
        UNIQUE (conversation_id, seq)
    );
    CREATE VIRTUAL TABLE turns_fts USING fts5(text, content='turns', content_rowid='rowid');
    CREATE TRIGGER turns_ai AFTER INSERT ON turns BEGIN
        INSERT INTO turns_fts(rowid, text) VALUES (new.rowid, new.text);
    END;
    CREATE TRIGGER turns_ad AFTER DELETE ON turns BEGIN
        INSERT INTO turns_fts(turns_fts, rowid, text) VALUES ('delete', old.rowid, old.text);
    END;
    CREATE TRIGGER turns_au AFTER UPDATE ON turns BEGIN
        INSERT INTO turns_fts(turns_fts, rowid, text) VALUES ('delete', old.rowid, old.text);
        INSERT INTO turns_fts(rowid, text) VALUES (new.rowid, new.text);
    END;
    CREATE TABLE memories (
        rowid INTEGER PRIMARY KEY,
        id TEXT NOT NULL UNIQUE,
        kind TEXT NOT NULL CHECK (kind IN ('fact', 'preference')),
        text TEXT NOT NULL,
        source_conversation TEXT NOT NULL DEFAULT '',
        created INTEGER NOT NULL,
        updated INTEGER NOT NULL,
        confidence REAL NOT NULL CHECK (confidence >= 0 AND confidence <= 1)
    );
    CREATE VIRTUAL TABLE memories_fts USING fts5(text, content='memories', content_rowid='rowid');
    CREATE TRIGGER memories_ai AFTER INSERT ON memories BEGIN
        INSERT INTO memories_fts(rowid, text) VALUES (new.rowid, new.text);
    END;
    CREATE TRIGGER memories_ad AFTER DELETE ON memories BEGIN
        INSERT INTO memories_fts(memories_fts, rowid, text) VALUES ('delete', old.rowid, old.text);
    END;
    CREATE TRIGGER memories_au AFTER UPDATE ON memories BEGIN
        INSERT INTO memories_fts(memories_fts, rowid, text) VALUES ('delete', old.rowid, old.text);
        INSERT INTO memories_fts(rowid, text) VALUES (new.rowid, new.text);
    END;
    CREATE TABLE summaries (
        conversation_id TEXT PRIMARY KEY,
        text TEXT NOT NULL,
        created INTEGER NOT NULL,
        updated INTEGER NOT NULL
    );
    CREATE TABLE relationship (
        key TEXT PRIMARY KEY,
        value TEXT NOT NULL,
        updated INTEGER NOT NULL
    );
    """,
]
SCHEMA = len(MIGRATIONS)


def database_path():
    return DATA / "assistant.sqlite"


def connect(path=None):
    path = Path(path or database_path())
    private_dir(path.parent)
    if not path.exists():
        os.close(os.open(path, os.O_CREAT | os.O_WRONLY, 0o600))
    db = sqlite3.connect(path, isolation_level=None, timeout=5)
    db.row_factory = sqlite3.Row
    db.execute("PRAGMA journal_mode=WAL")
    db.execute("PRAGMA foreign_keys=ON")
    db.execute("PRAGMA busy_timeout=5000")
    migrate(db)
    for suffix in ("", "-wal", "-shm"):
        try:
            os.chmod(f"{path}{suffix}", 0o600)
        except OSError:
            pass
    return db


def migrate(db):
    version = db.execute("PRAGMA user_version").fetchone()[0]
    if version > SCHEMA:
        raise SystemExit(f"tohru-assistant: {database_path()} is from a newer Tohru (schema {version})")
    for number in range(version, SCHEMA):
        try:
            db.executescript(f"BEGIN IMMEDIATE;\n{MIGRATIONS[number]}\nPRAGMA user_version={number + 1};\nCOMMIT;")
        except BaseException:
            if db.in_transaction:
                db.execute("ROLLBACK")
            raise


class transaction:
    def __init__(self, db):
        self.db = db

    def __enter__(self):
        self.db.execute("BEGIN IMMEDIATE")
        return self.db

    def __exit__(self, kind, *_):
        self.db.execute("ROLLBACK" if kind else "COMMIT")
        return False


def check_id(cid):
    if not CONVERSATION_ID.match(cid or ""):
        raise SystemExit("tohru-assistant: invalid conversation id")
    return cid


def load(db, cid):
    row = db.execute("SELECT * FROM conversations WHERE id = ?", (check_id(cid),)).fetchone()
    if row is None:
        return None
    conversation = dict(row)
    conversation["voice"] = bool(conversation["voice"])
    conversation["forgotten"] = bool(conversation["forgotten"])
    conversation["sessions"] = json.loads(conversation["sessions"] or "{}")
    conversation["turns"] = [turn_out(t) for t in db.execute(
        "SELECT * FROM turns WHERE conversation_id = ? ORDER BY seq", (cid,))]
    return conversation


def turn_out(row):
    turn = {"id": row["id"], "role": row["role"], "text": row["text"], "time": row["time"]}
    if row["provider"]:
        turn["provider"] = row["provider"]
    for flag in ("voice", "stopped"):
        if row[flag]:
            turn[flag] = True
    if row["error"]:
        turn["error"] = row["error"]
    return turn


def save_conversation(db, conversation):
    db.execute(
        """INSERT INTO conversations (id, title, provider, created, updated, voice, sessions, forgotten, remembered)
           VALUES (:id, :title, :provider, :created, :updated, :voice, :sessions, :forgotten, :remembered)
           ON CONFLICT(id) DO UPDATE SET title = excluded.title, provider = excluded.provider,
             updated = excluded.updated, voice = excluded.voice, sessions = excluded.sessions,
             forgotten = excluded.forgotten""",
        {"id": conversation["id"], "title": conversation["title"], "provider": conversation["provider"],
         "created": conversation["created"], "updated": conversation["updated"],
         "voice": int(bool(conversation.get("voice"))), "sessions": json.dumps(conversation.get("sessions") or {}, sort_keys=True),
         "forgotten": int(bool(conversation.get("forgotten"))), "remembered": int(conversation.get("remembered") or 0)})


def add_turn(db, cid, turn):
    seq = db.execute("SELECT COALESCE(MAX(seq), -1) + 1 FROM turns WHERE conversation_id = ?", (cid,)).fetchone()[0]
    turn.setdefault("id", uuid.uuid4().hex)
    db.execute(
        """INSERT INTO turns (id, conversation_id, seq, role, text, time, provider, voice, stopped, error)
           VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
        (turn["id"], cid, seq, turn["role"], turn["text"], turn["time"], turn.get("provider", ""),
         int(bool(turn.get("voice"))), int(bool(turn.get("stopped"))), turn.get("error", "")))


def title_of(text):
    line = " ".join(text.split())
    if len(line) <= TITLE_CHARS:
        return line
    cut = line[:TITLE_CHARS].rsplit(" ", 1)[0] or line[:TITLE_CHARS]
    return cut + "…"


def day_group(stamp, now):
    then, today = time.localtime(stamp), time.localtime(now)
    days = (time.mktime(today[:3] + (0, 0, 0) + today[6:]) - time.mktime(then[:3] + (0, 0, 0) + then[6:])) / 86400
    days = round(days)
    if days <= 0:
        return "Today", time.strftime("%-I:%M %p", then)
    if days == 1:
        return "Yesterday", time.strftime("%-I:%M %p", then)
    if days < 7:
        return "This week", time.strftime("%a", then)
    return "Earlier", time.strftime("%-d %b", then)


def summary(row, match="", now=None):
    group, when = day_group(row["updated"], now or time.time())
    return {
        "id": row["id"],
        "title": row["title"],
        "provider": row["provider"],
        "slot": BY_ID[row["provider"]].slot if row["provider"] in BY_ID else 0,
        "created": row["created"],
        "updated": row["updated"],
        "voice": bool(row["voice"]),
        "turns": row["turns"],
        "match": match,
        "group": group,
        "when": when,
    }


def snippet(text, at, length):
    start = max(0, at - 24)
    end = min(len(text), at + length + 40)
    piece = " ".join(text[start:end].split())
    return ("…" if start > 0 else "") + piece + ("…" if end < len(text) else "")


def fts_query(text):
    """An FTS5 query that matches any of the words, each quoted so user text is never query syntax."""
    words = [w for w in re.findall(r"\w+", text.casefold()) if len(w) >= 2][:24]
    return " OR ".join('"' + w.replace('"', "") + '"' for w in words)


def search(db, query, limit, provider=None, since=None):
    needle = query.casefold().strip()
    clauses, params = [], []
    if provider:
        clauses.append("c.provider = ?")
        params.append(provider)
    if since is not None:
        clauses.append("c.updated >= ?")
        params.append(since)
    if needle:
        words = re.findall(r"\w+", needle)
        phrase = " ".join('"' + w + '"' for w in words)
        like = "%" + needle.replace("\\", "\\\\").replace("%", "\\%").replace("_", "\\_") + "%"
        clauses.append("""(c.title LIKE ? ESCAPE '\\' OR c.id IN (
            SELECT t.conversation_id FROM turns t WHERE t.text LIKE ? ESCAPE '\\'
            UNION SELECT t.conversation_id FROM turns_fts f JOIN turns t ON t.rowid = f.rowid WHERE turns_fts MATCH ?))""")
        params += [like, like, phrase or '""']
    where = ("WHERE " + " AND ".join(clauses)) if clauses else ""
    rows = db.execute(
        f"""SELECT c.*, (SELECT COUNT(*) FROM turns t WHERE t.conversation_id = c.id) AS turns
            FROM conversations c {where} ORDER BY c.updated DESC, c.id LIMIT ?""", (*params, limit)).fetchall()
    results = []
    for row in rows:
        match = ""
        if needle:
            if needle in row["title"].casefold():
                match = row["title"]
            else:
                for turn in db.execute("SELECT text FROM turns WHERE conversation_id = ? ORDER BY seq", (row["id"],)):
                    at = turn["text"].casefold().find(needle)
                    if at >= 0:
                        match = snippet(turn["text"], at, len(needle))
                        break
                else:
                    first = words[0] if words else needle
                    for turn in db.execute("SELECT text FROM turns WHERE conversation_id = ? ORDER BY seq", (row["id"],)):
                        at = turn["text"].casefold().find(first)
                        if at >= 0:
                            match = snippet(turn["text"], at, len(first))
                            break
        results.append(summary(row, match))
    return results


VOICE_RULE = ("This answer will be spoken aloud. Reply in one to three short sentences of plain speech: "
              "no markdown, lists, code, links or URLs. If the full answer would be long, give the gist "
              "and offer to show the rest in the chat popup.")
TYPED_RULE = "This chat is typed: keep the persona to a light touch and use markdown when it helps."
MEMORY_TOKENS = 600
FORGET = re.compile(r"^\s*(?:(?:please|ok(?:ay)?|hey|tohru)[\s,]+)*forget\s+(?:that|this|what\s+i\s+(?:just\s+)?said|about\s+(?P<about>.+?)|(?P<thing>.+?))\s*[.!]*\s*$", re.I)


def persona_text(enabled=True, override=""):
    if not enabled:
        return ""
    candidates = [Path(override)] if override else []
    candidates += [Path(__file__).resolve().parent.parent / "shell/assistant/persona.md",
                   Path(__file__).resolve().parent.parent / "share/tohru/shell/assistant/persona.md"]
    for path in candidates:
        try:
            text = path.read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if text:
            return text[:8000]
    return ""


def tokens(text):
    return (len(text) + 3) // 4


def relationship(db):
    return {row["key"]: json.loads(row["value"]) for row in db.execute("SELECT key, value FROM relationship")}


def familiarity_word(value):
    if value < 0.1:
        return "you have only just met"
    if value < 0.35:
        return "you are getting to know each other"
    if value < 0.7:
        return "you know each other fairly well"
    return "you are old friends"


def memory_block(db, prompt, budget=MEMORY_TOKENS):
    """What Tohru remembers, cut to the token budget: the relationship, facts that match the prompt, then recent ones, then the last summaries."""
    lines = []
    state = relationship(db)
    if state.get("conversations"):
        parts = [f"You first met on {time.strftime('%-d %B %Y', time.localtime(state.get('first_met', time.time())))}",
                 f"this is conversation {state['conversations'] + 1}", familiarity_word(float(state.get("familiarity", 0)))]
        if state.get("streak", 0) > 1:
            parts.append(f"they have talked to you {state['streak']} days running")
        if state.get("nicknames"):
            parts.append("they call you " + ", ".join(state["nicknames"][:3]))
        lines.append("- " + "; ".join(parts) + ".")
        if state.get("topics"):
            lines.append("- Recurring topics: " + ", ".join(state["topics"][:6]) + ".")
        if state.get("jokes"):
            lines.append("- Inside jokes: " + "; ".join(state["jokes"][:3]) + ".")
    seen = set()
    facts = []
    query = fts_query(prompt)
    if query:
        try:
            facts += db.execute("""SELECT m.* FROM memories_fts f JOIN memories m ON m.rowid = f.rowid
                                   WHERE memories_fts MATCH ? ORDER BY bm25(memories_fts) LIMIT 12""", (query,)).fetchall()
        except sqlite3.OperationalError:
            pass
    facts += db.execute("SELECT * FROM memories ORDER BY updated DESC, confidence DESC LIMIT 24").fetchall()
    summaries = db.execute("SELECT text FROM summaries ORDER BY updated DESC LIMIT 3").fetchall()
    header = "What you remember about the user from earlier chats (use it naturally; never recite it or mention this list):"
    used = tokens(header) + sum(tokens(line) + 1 for line in lines)
    if used > budget:
        lines = []
        used = tokens(header)
    for row in facts:
        if row["id"] in seen:
            continue
        seen.add(row["id"])
        line = f"- {row['text']}"
        if used + tokens(line) + 1 > budget:
            break
        lines.append(line)
        used += tokens(line) + 1
    for row in summaries:
        line = f"- Earlier: {row['text']}"
        if used + tokens(line) + 1 > budget:
            break
        lines.append(line)
        used += tokens(line) + 1
    return header + "\n" + "\n".join(lines) if lines else ""


def instructions(persona, block, voice):
    parts = [p for p in (persona, VOICE_RULE if voice and persona else "", TYPED_RULE if not voice and persona else "", block) if p]
    if voice and not persona:
        parts.insert(0, VOICE_RULE)
    return "\n\n".join(parts)


EXTRACT_PROMPT = """You maintain the long-term memory of a desktop assistant called Tohru. Read the conversation below and reply with ONLY a JSON object, no prose and no code fence, of this exact shape:
{"summary": "one or two plain lines on what the conversation was about",
 "facts": [{"text": "a durable fact about the user, in the third person", "kind": "fact" or "preference", "confidence": 0.0 to 1.0}],
 "nicknames": ["names the user called Tohru, if any"],
 "topics": ["short recurring-topic labels"],
 "jokes": ["inside jokes worth remembering, if any"]}
Only record what the user said about themselves and would plausibly want remembered: no secrets, passwords, keys, health, financial or other sensitive details, nothing about third parties, and nothing the assistant guessed. Use empty lists when there is nothing. At most 8 facts.

Conversation:
"""


def clean_list(value, limit, length):
    if value is None:
        return []
    if not isinstance(value, list) or not all(isinstance(v, str) for v in value):
        raise ValueError("expected a list of strings")
    out = []
    for item in value:
        item = " ".join(item.split())[:length]
        if item and item.casefold() not in (o.casefold() for o in out):
            out.append(item)
    return out[:limit]


def parse_extraction(text):
    """The validated memories from a provider's reply; raises ValueError for anything but the strict shape."""
    text = text.strip()
    fence = re.match(r"^```(?:json)?\s*(.*?)\s*```$", text, re.S)
    if fence:
        text = fence.group(1)
    data = json.loads(text)
    if not isinstance(data, dict) or set(data) - {"summary", "facts", "nicknames", "topics", "jokes"}:
        raise ValueError("unexpected keys")
    summary_text = data.get("summary")
    if not isinstance(summary_text, str) or not summary_text.strip() or len(summary_text) > 400:
        raise ValueError("summary must be one or two short lines")
    facts = data.get("facts", [])
    if not isinstance(facts, list) or len(facts) > 8:
        raise ValueError("facts must be a short list")
    clean = []
    for fact in facts:
        if not isinstance(fact, dict) or set(fact) - {"text", "kind", "confidence"}:
            raise ValueError("bad fact")
        body, kind, confidence = fact.get("text"), fact.get("kind", "fact"), fact.get("confidence", 0.6)
        if not isinstance(body, str) or not body.strip() or len(body) > 240:
            raise ValueError("bad fact text")
        if kind not in ("fact", "preference"):
            raise ValueError("bad fact kind")
        if isinstance(confidence, bool) or not isinstance(confidence, (int, float)) or not 0 <= confidence <= 1:
            raise ValueError("bad confidence")
        clean.append({"text": " ".join(body.split()), "kind": kind, "confidence": float(confidence)})
    return {
        "summary": " ".join(summary_text.split()),
        "facts": clean,
        "nicknames": clean_list(data.get("nicknames"), 5, 40),
        "topics": clean_list(data.get("topics"), 8, 40),
        "jokes": clean_list(data.get("jokes"), 5, 160),
    }


def merge_list(old, new, limit):
    out = list(old or [])
    for item in new:
        if item.casefold() not in (o.casefold() for o in out):
            out.append(item)
    return out[-limit:]


def store_memories(db, conversation, found, now=None):
    now = int(now or time.time())
    cid = conversation["id"]
    with transaction(db):
        for fact in found["facts"]:
            row = db.execute("SELECT id, confidence FROM memories WHERE lower(text) = lower(?)", (fact["text"],)).fetchone()
            if row:
                db.execute("UPDATE memories SET updated = ?, confidence = ?, kind = ?, source_conversation = ? WHERE id = ?",
                           (now, max(row["confidence"], fact["confidence"]), fact["kind"], cid, row["id"]))
            else:
                db.execute("INSERT INTO memories (id, kind, text, source_conversation, created, updated, confidence) VALUES (?, ?, ?, ?, ?, ?, ?)",
                           (uuid.uuid4().hex, fact["kind"], fact["text"], cid, now, now, fact["confidence"]))
        db.execute("""INSERT INTO summaries (conversation_id, text, created, updated) VALUES (?, ?, ?, ?)
                      ON CONFLICT(conversation_id) DO UPDATE SET text = excluded.text, updated = excluded.updated""",
                   (cid, found["summary"], now, now))
        state = relationship(db)
        first_time = cid not in set(state.get("counted", []))
        if first_time:
            count = int(state.get("conversations", 0)) + 1
            today = time.strftime("%Y-%m-%d", time.localtime(conversation["created"]))
            last_day = state.get("last_day")
            yesterday = time.strftime("%Y-%m-%d", time.localtime(conversation["created"] - 86400))
            streak = int(state.get("streak", 0))
            streak = streak if last_day == today else streak + 1 if last_day == yesterday else 1
            state.update({
                "first_met": min(int(state.get("first_met", conversation["created"])), conversation["created"]),
                "conversations": count,
                "familiarity": round(1 - math.exp(-count / 40), 4),
                "streak": streak,
                "last_day": today,
                "counted": (state.get("counted", []) + [cid])[-500:],
            })
        state["last_seen"] = max(int(state.get("last_seen", 0)), conversation["updated"])
        state["nicknames"] = merge_list(state.get("nicknames"), found["nicknames"], 5)
        state["topics"] = merge_list(state.get("topics"), found["topics"], 12)
        state["jokes"] = merge_list(state.get("jokes"), found["jokes"], 8)
        for key, value in state.items():
            db.execute("""INSERT INTO relationship (key, value, updated) VALUES (?, ?, ?)
                          ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated = excluded.updated""",
                       (key, json.dumps(value, sort_keys=True), now))
        db.execute("UPDATE conversations SET remembered = ? WHERE id = ?", (conversation["updated"], cid))


def forget_conversation(db, cid):
    with transaction(db):
        db.execute("DELETE FROM memories WHERE source_conversation = ?", (cid,))
        db.execute("DELETE FROM summaries WHERE conversation_id = ?", (cid,))
        db.execute("UPDATE conversations SET forgotten = 1 WHERE id = ?", (cid,))


STOPWORDS = {"a", "an", "the", "my", "me", "i", "your", "our", "about", "of", "that", "this", "what", "and", "or", "to", "is", "was", "please"}


def forget_about(db, subject):
    words = [w for w in re.findall(r"\w+", subject.casefold()) if len(w) >= 2 and w not in STOPWORDS]
    if not words:
        return 0
    with transaction(db):
        rows = db.execute("SELECT m.id, m.text FROM memories_fts f JOIN memories m ON m.rowid = f.rowid WHERE memories_fts MATCH ?",
                          (" AND ".join('"' + w + '"' for w in words),)).fetchall()
        for row in rows:
            db.execute("DELETE FROM memories WHERE id = ?", (row["id"],))
    return len(rows)


def transcript_prompt(turns, prompt):
    lines = ["Earlier in this conversation (with another assistant):"]
    for turn in turns:
        who = "User" if turn.get("role") == "user" else "Assistant"
        lines.append(f"{who}: {turn.get('text', '')}")
    lines.append("")
    lines.append(prompt)
    return "\n".join(lines)


# Claude and Codex take instructions on every run, so the persona and memories are fresh each turn.
# Gemini, Antigravity and OpenCode have no flag for them; those get them ahead of the first turn only.
SYSTEM_FLAG = {"claude", "codex"}
# Only providers that can fork a resumed session cleanly support speculative drafts without polluting history.
DRAFT_PROVIDERS = {"claude", "codex"}


def interrupted_note(spoken):
    spoken = " ".join((spoken or "").split())[:400]
    if not spoken:
        return ""
    return (f'[You were interrupted while speaking. You had already said: "{spoken}". '
            "Address what the user just said directly; do not repeat what you already said or apologise at length.]")


def gemini_settings(scratch, model, effort):
    """Gemini sets thinking only in settings: a project alias in the scratch folder carries the model and level."""
    folder = private_dir(scratch / ".gemini")
    alias = {"extends": "chat-base-3", "modelConfig": {"model": model}}
    if effort:
        alias["modelConfig"]["generateContentConfig"] = {"thinkingConfig": {"thinkingLevel": EFFORT_NAMES["gemini"][effort]}}
    (folder / "settings.json").write_text(json.dumps({"modelConfigs": {"customAliases": {"tohru-chat": alias}}}), encoding="utf-8")
    return "tohru-chat"


def provider_argv(ident, session, model="", effort="", system="", scratch=None, tools=False):
    names = EFFORT_NAMES.get(ident, {})
    if ident == "claude":
        argv = ["claude", "-p", "--output-format", "stream-json", "--verbose", "--include-partial-messages",
                "--setting-sources", "project"]
        argv += ["--permission-mode", "bypassPermissions"] if tools else ["--tools", "", "--strict-mcp-config"]
        if model:
            argv += ["--model", model]
        if effort:
            argv += ["--effort", names[effort]]
        if system:
            argv += ["--append-system-prompt", system]
        if session.get("ephemeral"):
            argv += ["--no-session-persistence"]
        elif session["resume"]:
            argv += ["--resume", session["id"]]
            if session.get("fork"):
                argv += ["--fork-session"]
        else:
            argv += ["--session-id", session["id"]]
        return argv
    if ident == "codex":
        common = ["--json", "--skip-git-repo-check"]
        common += ["--dangerously-bypass-approvals-and-sandbox"] if tools else ["-c", "mcp_servers={}"]
        if model:
            common += ["-m", model]
        if effort:
            common += ["-c", f'model_reasoning_effort="{names[effort]}"']
        if system:
            common += ["-c", "developer_instructions=" + json.dumps(system)]
        if session.get("ephemeral"):
            common += ["--ephemeral"]
        if session["resume"]:
            verb = "fork" if session.get("fork") else "resume"
            return ["codex", "exec", verb, *common, session["id"], "-"]
        return ["codex", "exec", *common, *([] if tools else ["--sandbox", "read-only"]), "--color", "never", "-"]
    if ident == "gemini":
        argv = ["gemini", "--output-format", "stream-json", "--approval-mode", "yolo" if tools else "default"]
        if model:
            argv += ["-m", gemini_settings(scratch or SCRATCH, model, effort)]
        if session["resume"]:
            argv += ["--resume", session["id"]]
        return argv + ["-p", ""]
    if ident == "agy":
        argv = ["agy", "-p", "--output-format", "stream-json", "--disable-slash-commands"]
        argv += ["--dangerously-skip-permissions"] if tools else ["--mode", "plan"]
        if model:
            argv += ["--model", model]
        if effort:
            argv += ["--effort", names[effort]]
        if session["resume"]:
            argv += ["--conversation", session["id"]]
        return argv
    if ident == "opencode":
        argv = ["opencode", "run", "--format", "json"]
        if model:
            argv += ["--model", f"{model}#{names[effort]}" if effort and "#" not in model else model]
        if session["resume"]:
            argv += ["--session", session["id"]]
        return argv
    raise SystemExit(f"tohru-assistant: unknown provider {ident}")


class StreamParser:
    """Turns one CLI's stdout lines into answer text and its resumable session id."""

    def __init__(self, ident):
        self.ident = ident
        self.text = ""
        self.session = None
        self.error = None
        self.final = None

    def feed(self, line):
        try:
            event = json.loads(line)
        except ValueError:
            return ""
        if not isinstance(event, dict):
            return ""
        handler = getattr(self, "_" + self.ident)
        delta = handler(event) or ""
        self.text += delta
        return delta

    def finish(self):
        if self.final and not self.text.strip():
            self.text = self.final
            return self.final
        if self.final and self.final.startswith(self.text) and len(self.final) > len(self.text):
            rest = self.final[len(self.text):]
            self.text = self.final
            return rest
        return ""

    def _claude(self, event):
        if event.get("session_id"):
            self.session = event["session_id"]
        kind = event.get("type")
        if kind == "stream_event":
            inner = event.get("event") or {}
            if inner.get("type") == "message_start" and self.text and not self.text.endswith("\n"):
                return "\n\n"
            if inner.get("type") == "content_block_delta":
                delta = inner.get("delta") or {}
                if delta.get("type") == "text_delta":
                    return delta.get("text", "")
        elif kind == "result":
            if event.get("is_error") or event.get("subtype") not in (None, "success"):
                self.error = str(event.get("result") or event.get("subtype") or "error")
            elif isinstance(event.get("result"), str):
                self.final = event["result"]
        return ""

    def _codex(self, event):
        kind = event.get("type")
        if kind == "thread.started":
            self.session = event.get("thread_id")
        elif kind == "item.completed":
            item = event.get("item") or {}
            if item.get("type") == "agent_message":
                text = item.get("text", "")
                return ("\n\n" if self.text else "") + text
        elif kind in ("turn.failed", "error"):
            error = event.get("error") or event.get("message") or "error"
            self.error = error.get("message", str(error)) if isinstance(error, dict) else str(error)
        return ""

    def _gemini(self, event):
        kind = event.get("type")
        if kind == "init" and event.get("session_id"):
            self.session = event["session_id"]
        elif kind == "message" and event.get("role") == "assistant":
            return event.get("content", "")
        elif kind == "error":
            self.error = str(event.get("message") or "error")
        return ""

    def _agy(self, event):
        kind = event.get("event")
        if kind == "init":
            self.session = event.get("conversation_id") or self.session
        elif kind == "step_update":
            step = event.get("step_update") or {}
            if step.get("step_type") == "agent_response":
                return step.get("text_delta", "")
        elif kind == "result":
            result = event.get("result") or {}
            if result.get("status") not in (None, "SUCCESS"):
                self.error = str(result.get("error") or result.get("status"))
            elif isinstance(result.get("response"), str):
                self.final = result["response"]
        return ""

    def _opencode(self, event):
        if event.get("sessionID"):
            self.session = event["sessionID"]
        part = event.get("part") or {}
        if event.get("type") == "text" and isinstance(part.get("text"), str):
            return ("\n\n" if self.text else "") + part["text"]
        if event.get("type") == "error":
            error = event.get("error") or {}
            self.error = str(error.get("message") or error.get("name") or "error") if isinstance(error, dict) else str(error)
        return ""


class Run:
    def __init__(self):
        self.child = None
        self.stopped = False

    def stop(self, *_):
        self.stopped = True
        child = self.child
        if child and child.poll() is None:
            try:
                os.killpg(child.pid, signal.SIGINT)
            except OSError:
                pass


def run_provider(provider, argv, stdin_text, on_delta=None, run=None, timeout=None, extra_env=None):
    """Runs one headless CLI turn in the scratch folder; returns (parser, exit code, stderr lines, stopped)."""
    run = run or Run()
    scratch = private_dir(SCRATCH)
    parser = StreamParser(provider.id)
    env = dict(os.environ)
    env["NO_COLOR"] = "1"
    env.update(extra_env or {})
    # Tohru keeps her own memory; Claude Code's would be a second one she never sees in other providers.
    env["CLAUDE_CODE_DISABLE_AUTO_MEMORY"] = "1"
    run.child = subprocess.Popen(argv, cwd=scratch, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                 stderr=subprocess.PIPE, text=True, bufsize=1, start_new_session=True)
    timer = threading.Timer(timeout, run.stop) if timeout else None
    if timer:
        timer.daemon = True
        timer.start()
    errors = []
    drain = threading.Thread(target=lambda: errors.extend(run.child.stderr.readlines()[-20:]), daemon=True)
    drain.start()
    try:
        run.child.stdin.write(stdin_text)
        run.child.stdin.close()
    except OSError:
        pass
    if run.stopped:
        run.stop()
    for line in run.child.stdout:
        delta = parser.feed(line)
        if delta and on_delta:
            on_delta(delta)
    code = run.child.wait()
    if timer:
        timer.cancel()
    drain.join(1)
    rest = "" if run.stopped else parser.finish()
    if rest and on_delta:
        on_delta(rest)
    return parser, code, errors, run.stopped


def place_prompt(provider, argv, text):
    if provider.id == "gemini":
        argv[-1] = text
        return ""
    if provider.id in ("agy", "opencode"):
        argv.append(text)
        return ""
    return text


def flag(value):
    return value != "off"


def forget_reply(db, conversation, request):
    about = (request.group("about") or request.group("thing") or "").strip()
    spoken = re.sub(r"\bmy\b", "your", about, flags=re.I)
    if about and not re.match(r"^(it|everything|all of (it|that))$", about, re.I):
        removed = forget_about(db, about)
        return (f"Done. I've let go of {removed} thing{'s' if removed != 1 else ''} I remembered about {spoken}."
                if removed else f"I don't have anything remembered about {spoken}, so there's nothing to forget.")
    if conversation:
        forget_conversation(db, conversation["id"])
    return "Consider it forgotten. Nothing from this conversation goes into my memory."


def chat(args):
    prompt = sys.stdin.read().strip()
    if not prompt:
        raise SystemExit("tohru-assistant: empty prompt")
    provider = BY_ID.get(args.provider)
    if provider is None or not provider.installed():
        emit({"event": "error", "message": f"{args.provider} is not installed"})
        return 3
    if args.draft and (provider.id not in DRAFT_PROVIDERS or FORGET.match(prompt)):
        emit({"event": "draft_unsupported"})
        return 0
    db = connect()
    now = int(time.time())
    conversation = load(db, args.conversation) if args.conversation else None
    if conversation is None:
        conversation = {"id": check_id(args.conversation) if args.conversation else uuid.uuid4().hex,
                        "title": title_of(prompt), "provider": provider.id, "created": now, "updated": now,
                        "voice": bool(args.voice), "sessions": {}, "turns": [], "forgotten": False}
    earlier = list(conversation["turns"])
    sessions = conversation["sessions"]
    session = {"id": sessions.get(provider.id), "resume": provider.id in sessions}
    if args.draft and session["resume"]:
        session["fork"] = True
    if not session["resume"] and provider.id == "claude":
        session["id"] = str(uuid.uuid4())
    conversation["provider"] = provider.id
    conversation["voice"] = bool(conversation.get("voice") or args.voice)
    conversation["updated"] = now
    if not args.draft:
        with transaction(db):
            save_conversation(db, conversation)
            add_turn(db, conversation["id"], {"role": "user", "text": prompt, "time": now, "voice": bool(args.voice)})
    start_event = {"event": "start", "conversation": conversation["id"], "provider": provider.id, "slot": provider.slot,
                   "title": conversation["title"]}
    if args.draft:
        start_event["draft"] = True
    emit(start_event)

    forget = FORGET.match(prompt)
    if forget:
        answer = forget_reply(db, conversation, forget)
        emit({"event": "delta", "text": answer})
        with transaction(db):
            add_turn(db, conversation["id"], {"role": "assistant", "text": answer, "time": int(time.time()), "provider": "tohru"})
            db.execute("UPDATE conversations SET updated = ? WHERE id = ?", (int(time.time()), conversation["id"]))
        emit({"event": "done", "conversation": conversation["id"]})
        return 0

    persona = persona_text(flag(args.persona), args.persona_file)
    block = memory_block(db, prompt) if flag(args.memory) and not conversation.get("forgotten") else ""
    system = instructions(persona, block, args.voice)
    model, effort = resolve_model(provider.id, args.model, args.effort)
    sent = prompt if session["resume"] or not earlier else transcript_prompt(earlier, prompt)
    note = interrupted_note(args.interrupted)
    if note:
        sent = f"{note}\n\n{sent}"
    if provider.id in SYSTEM_FLAG:
        argv = provider_argv(provider.id, session, model, effort, system, tools=True)
    else:
        argv = provider_argv(provider.id, session, model, effort, tools=True)
        if system and not session["resume"]:
            sent = f"{system}\n\n---\n\n{sent}"

    run = Run()
    signal.signal(signal.SIGINT, run.stop)
    signal.signal(signal.SIGTERM, run.stop)
    stdin_text = place_prompt(provider, argv, sent)
    try:
        parser, code, errors, stopped = run_provider(provider, argv, stdin_text, lambda d: emit({"event": "delta", "text": d}), run,
                                                      extra_env={"TOHRU_CONVERSATION": conversation["id"]})
    except OSError as error:
        emit({"event": "error", "message": str(error)})
        return 3
    next_session = parser.session or (session["id"] if session["id"] and provider.id == "claude" and parser.text else None)
    answer = parser.text.strip()
    failed = not stopped and (parser.error or (code != 0 and not answer))
    if args.draft:
        if stopped:
            emit({"event": "stopped", "conversation": conversation["id"]})
            return 0
        if failed:
            message = parser.error or (errors[-1].strip() if errors else f"{provider.id} exited with {code}")
            emit({"event": "error", "conversation": conversation["id"], "message": message[:500]})
            return 1
        emit({"event": "done", "conversation": conversation["id"], "session": next_session or ""})
        return 0
    if next_session:
        sessions[provider.id] = next_session
    turn = {"role": "assistant", "text": answer, "time": int(time.time()), "provider": provider.id}
    if stopped:
        turn["stopped"] = True
    if failed:
        message = parser.error or (errors[-1].strip() if errors else f"{provider.id} exited with {code}")
        turn["error"] = message[:500]
    conversation["updated"] = int(time.time())
    with transaction(db):
        if answer or stopped or failed:
            add_turn(db, conversation["id"], turn)
        save_conversation(db, conversation)
    if stopped:
        emit({"event": "stopped", "conversation": conversation["id"]})
        return 0
    if failed:
        emit({"event": "error", "conversation": conversation["id"], "message": turn["error"]})
        return 1
    emit({"event": "done", "conversation": conversation["id"]})
    return 0


def commit_draft(args):
    data = json.loads(sys.stdin.read() or "{}")
    prompt = str(data.get("prompt") or "").strip()
    answer = str(data.get("answer") or "").strip()
    if not prompt:
        raise SystemExit("tohru-assistant: empty draft prompt")
    db = connect()
    now = int(time.time())
    conversation = load(db, args.conversation) if args.conversation else None
    if conversation is None:
        conversation = {"id": check_id(args.conversation) if args.conversation else uuid.uuid4().hex,
                        "title": title_of(prompt), "provider": args.provider, "created": now, "updated": now,
                        "voice": bool(args.voice), "sessions": {}, "turns": [], "forgotten": False}
    conversation["provider"] = args.provider
    conversation["voice"] = bool(conversation.get("voice") or args.voice)
    conversation["updated"] = now
    if args.session:
        conversation["sessions"][args.provider] = args.session
    with transaction(db):
        save_conversation(db, conversation)
        add_turn(db, conversation["id"], {"role": "user", "text": prompt, "time": now, "voice": bool(args.voice)})
        if answer:
            add_turn(db, conversation["id"], {"role": "assistant", "text": answer, "time": now, "provider": args.provider})
    emit({"event": "committed", "conversation": conversation["id"]})
    return 0


def rollback(args):
    db = connect()
    cid = check_id(args.conversation)
    conversation = load(db, cid)
    if conversation is None:
        emit({"event": "rolled_back", "conversation": cid, "deleted": True})
        return 0
    row = db.execute("SELECT MAX(seq) AS seq FROM turns WHERE conversation_id = ? AND role = 'user'", (cid,)).fetchone()
    if row is None or row["seq"] is None:
        emit({"event": "rolled_back", "conversation": cid, "deleted": False})
        return 0
    with transaction(db):
        db.execute("DELETE FROM turns WHERE conversation_id = ? AND seq >= ?", (cid, row["seq"]))
        remaining = db.execute("SELECT role, provider, time FROM turns WHERE conversation_id = ? ORDER BY seq", (cid,)).fetchall()
        if not remaining:
            db.execute("DELETE FROM conversations WHERE id = ?", (cid,))
            db.execute("DELETE FROM summaries WHERE conversation_id = ?", (cid,))
            deleted = True
        else:
            active_providers = {r["provider"] for r in remaining if r["role"] == "assistant" and r["provider"]}
            conversation["sessions"] = {k: v for k, v in conversation["sessions"].items() if k in active_providers}
            conversation["updated"] = remaining[-1]["time"]
            save_conversation(db, conversation)
            deleted = False
    emit({"event": "rolled_back", "conversation": cid, "deleted": deleted})
    return 0


def remember(args):
    """After a conversation ends: one headless call to its provider for strict-JSON memories and a summary."""
    if not flag(args.memory):
        return 0
    db = connect()
    conversation = load(db, args.conversation)
    if conversation is None:
        return 1
    if conversation["forgotten"] or conversation["remembered"] >= conversation["updated"]:
        return 0
    turns = [t for t in conversation["turns"] if t.get("text") and not t.get("error") and t.get("provider") != "tohru"]
    if not any(t["role"] == "user" for t in turns) or not any(t["role"] == "assistant" for t in turns):
        return 0
    provider = BY_ID.get(conversation["provider"])
    if provider is None or not provider.installed():
        return 3
    transcript = "\n".join(f"{'User' if t['role'] == 'user' else 'Tohru'}: {t['text']}" for t in turns)[-12000:]
    try:
        chosen = json.loads(args.models).get(provider.id) or {}
    except (ValueError, AttributeError):
        chosen = {}
    chosen = chosen if isinstance(chosen, dict) else {}
    model, effort = resolve_model(provider.id, args.model or str(chosen.get("model") or ""), args.effort or str(chosen.get("effort") or ""))
    session = {"id": str(uuid.uuid4()) if provider.id == "claude" else None, "resume": False, "ephemeral": True}
    argv = provider_argv(provider.id, session, model, effort)
    stdin_text = place_prompt(provider, argv, EXTRACT_PROMPT + transcript)
    try:
        parser, code, _, stopped = run_provider(provider, argv, stdin_text, timeout=180)
    except OSError as error:
        print(f"tohru-assistant: {error}", file=sys.stderr)
        return 3
    if stopped or parser.error:
        print(f"tohru-assistant: memory extraction failed: {parser.error or 'timed out'}", file=sys.stderr)
        return 1
    try:
        found = parse_extraction(parser.text)
    except (ValueError, TypeError) as error:
        print(f"tohru-assistant: rejected memory extraction: {error}", file=sys.stderr)
        return 1
    if load(db, conversation["id"])["forgotten"]:
        return 0
    store_memories(db, conversation, found)
    emit({"event": "remembered", "conversation": conversation["id"], "facts": len(found["facts"])})
    return 0


def memory_command(args):
    db = connect()
    if args.action == "list":
        rows = [dict(r) for r in db.execute("SELECT id, kind, text, source_conversation, created, updated, confidence FROM memories ORDER BY updated DESC, id")]
        if args.json:
            emit({"memories": rows, "relationship": relationship(db),
                  "summaries": [dict(r) for r in db.execute("SELECT * FROM summaries ORDER BY updated DESC")]})
        else:
            for row in rows:
                print(f"{row['id'][:8]}  {row['kind']:<10}  {row['confidence']:.2f}  {row['text']}")
            if not rows:
                print("No memories.")
        return 0
    if args.action == "forget":
        ident = (args.id or "").strip().lower()
        if not re.match(r"^[0-9a-f]{4,32}$", ident):
            raise SystemExit("tohru-assistant: memory forget takes an ID from memory list")
        with transaction(db):
            rows = db.execute("SELECT id FROM memories WHERE id LIKE ?", (ident + "%",)).fetchall()
            if len(rows) > 1:
                raise SystemExit("tohru-assistant: that ID prefix matches more than one memory")
            if rows:
                db.execute("DELETE FROM memories WHERE id = ?", (rows[0]["id"],))
        if not rows:
            print("tohru-assistant: no such memory", file=sys.stderr)
            return 1
        return 0
    if args.action == "clear":
        with transaction(db):
            db.execute("DELETE FROM memories")
            db.execute("DELETE FROM summaries")
            db.execute("DELETE FROM relationship")
            db.execute("UPDATE conversations SET remembered = 0")
        return 0
    return 2


EXPORT_FORMAT = "tohru-assistant-export"
EXPORT_SCHEMA = 1
VERSION = "0.1.0"
SECTIONS = ("history", "memory", "relationship")


def assistant_settings():
    """The assistant.* values from the user and managed config files, managed winning, as Tohru reads them."""
    values = {}
    managed = os.environ.get("TOHRU_MANAGED_CONFIG")
    for path in (xdg("XDG_CONFIG_HOME", ".config") / "tohru/config.toml", Path(managed) if managed else None):
        if path is None:
            continue
        try:
            with open(path, "rb") as f:
                table = tomllib.load(f).get("assistant", {})
        except (OSError, tomllib.TOMLDecodeError):
            continue

        def walk(prefix, node):
            for key, value in node.items():
                if isinstance(value, dict):
                    walk(f"{prefix}{key}.", value)
                elif isinstance(value, (str, bool, int)):
                    values[f"assistant.{prefix}{key}"] = value
        if isinstance(table, dict):
            walk("", table)
    return dict(sorted(values.items()))


def export_state(db):
    conversations = []
    for row in db.execute("SELECT id FROM conversations ORDER BY id"):
        c = load(db, row["id"])
        conversations.append({"id": c["id"], "title": c["title"], "provider": c["provider"], "created": c["created"],
                              "updated": c["updated"], "voice": c["voice"], "forgotten": c["forgotten"],
                              "remembered": c["remembered"], "sessions": c["sessions"], "turns": c["turns"]})
    settings = assistant_settings()
    return {
        "format": EXPORT_FORMAT,
        "schema": EXPORT_SCHEMA,
        "tohru_version": VERSION,
        "exported": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "settings": settings,
        "persona": {"enabled": settings.get("assistant.persona", True), "file": settings.get("assistant.persona_file", ""),
                    "text": persona_text(True, settings.get("assistant.persona_file", ""))},
        "conversations": conversations,
        "memories": [dict(r) for r in db.execute(
            "SELECT id, kind, text, source_conversation, created, updated, confidence FROM memories ORDER BY id")],
        "summaries": [dict(r) for r in db.execute("SELECT conversation_id, text, created, updated FROM summaries ORDER BY conversation_id")],
        "relationship": {r["key"]: {"value": json.loads(r["value"]), "updated": r["updated"]}
                         for r in db.execute("SELECT * FROM relationship ORDER BY key")},
    }


def write_private(path, text):
    path = Path(path)
    fd, tmp = tempfile.mkstemp(dir=path.parent if str(path.parent) else ".", prefix=".tohru-export-")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def export_command(args):
    text = json.dumps(export_state(connect()), ensure_ascii=False, indent=2, sort_keys=False) + "\n"
    if args.file and args.file != "-":
        write_private(args.file, text)
    else:
        sys.stdout.write(text)
    return 0


def require(condition, message):
    if not condition:
        raise ValueError(message)


def is_int(value):
    return isinstance(value, int) and not isinstance(value, bool)


def upgrade_export(data):
    """Brings an older export up to EXPORT_SCHEMA; there is only version 1 so far."""
    require(isinstance(data, dict) and data.get("format") == EXPORT_FORMAT, "not a Tohru assistant export")
    schema = data.get("schema")
    require(is_int(schema) and 1 <= schema, "missing schema version")
    require(schema <= EXPORT_SCHEMA, f"export schema {schema} is newer than this Tohru ({EXPORT_SCHEMA})")
    return data


def validate_export(data):
    data = upgrade_export(data)
    for name in ("conversations", "memories", "summaries"):
        require(isinstance(data.get(name, []), list), f"{name} must be a list")
    require(isinstance(data.get("relationship", {}), dict), "relationship must be an object")
    for c in data.get("conversations", []):
        require(isinstance(c, dict) and isinstance(c.get("id"), str) and CONVERSATION_ID.match(c["id"]), "bad conversation id")
        require(isinstance(c.get("title"), str) and isinstance(c.get("provider"), str), f"conversation {c['id']}: title and provider")
        require(is_int(c.get("created")) and is_int(c.get("updated")), f"conversation {c['id']}: times")
        require(isinstance(c.get("sessions", {}), dict), f"conversation {c['id']}: sessions")
        require(isinstance(c.get("turns"), list), f"conversation {c['id']}: turns")
        for t in c["turns"]:
            require(isinstance(t, dict) and isinstance(t.get("id"), str) and re.match(r"^[0-9a-f]{32}$", t["id"]), "bad turn id")
            require(t.get("role") in ("user", "assistant") and isinstance(t.get("text"), str) and is_int(t.get("time")), f"turn {t['id']}")
            require(isinstance(t.get("error", ""), str) and isinstance(t.get("provider", ""), str), f"turn {t['id']}")
    for m in data.get("memories", []):
        require(isinstance(m, dict) and isinstance(m.get("id"), str) and re.match(r"^[0-9a-f]{32}$", m["id"]), "bad memory id")
        require(m.get("kind") in ("fact", "preference") and isinstance(m.get("text"), str) and m["text"].strip(), f"memory {m['id']}")
        require(is_int(m.get("created")) and is_int(m.get("updated")), f"memory {m['id']}: times")
        require(isinstance(m.get("confidence"), (int, float)) and not isinstance(m["confidence"], bool) and 0 <= m["confidence"] <= 1, f"memory {m['id']}: confidence")
        require(isinstance(m.get("source_conversation", ""), str), f"memory {m['id']}: source")
    for s in data.get("summaries", []):
        require(isinstance(s, dict) and isinstance(s.get("conversation_id"), str) and isinstance(s.get("text"), str), "bad summary")
        require(is_int(s.get("created")) and is_int(s.get("updated")), "summary times")
    for key, entry in data.get("relationship", {}).items():
        require(isinstance(key, str) and isinstance(entry, dict) and "value" in entry and is_int(entry.get("updated")), f"relationship {key}")
    return data


def import_state(db, data, replace=False, only=None):
    sections = set(only or SECTIONS)
    counts = {"conversations": 0, "memories": 0, "summaries": 0, "relationship": 0}
    with transaction(db):
        if replace:
            if "history" in sections:
                db.execute("DELETE FROM conversations")
            if "memory" in sections:
                db.execute("DELETE FROM memories")
                db.execute("DELETE FROM summaries")
            if "relationship" in sections:
                db.execute("DELETE FROM relationship")
        if "history" in sections:
            for c in data.get("conversations", []):
                row = db.execute("SELECT updated FROM conversations WHERE id = ?", (c["id"],)).fetchone()
                if row and row["updated"] >= c["updated"]:
                    continue
                db.execute("DELETE FROM conversations WHERE id = ?", (c["id"],))
                save_conversation(db, {**c, "remembered": c.get("remembered", 0)})
                for t in c["turns"]:
                    add_turn(db, c["id"], dict(t))
                counts["conversations"] += 1
        if "memory" in sections:
            for m in data.get("memories", []):
                row = db.execute("SELECT updated FROM memories WHERE id = ?", (m["id"],)).fetchone()
                if row and row["updated"] >= m["updated"]:
                    continue
                db.execute("DELETE FROM memories WHERE id = ?", (m["id"],))
                db.execute("INSERT INTO memories (id, kind, text, source_conversation, created, updated, confidence) VALUES (?, ?, ?, ?, ?, ?, ?)",
                           (m["id"], m["kind"], m["text"], m.get("source_conversation", ""), m["created"], m["updated"], float(m["confidence"])))
                counts["memories"] += 1
            for s in data.get("summaries", []):
                row = db.execute("SELECT updated FROM summaries WHERE conversation_id = ?", (s["conversation_id"],)).fetchone()
                if row and row["updated"] >= s["updated"]:
                    continue
                db.execute("""INSERT INTO summaries (conversation_id, text, created, updated) VALUES (?, ?, ?, ?)
                              ON CONFLICT(conversation_id) DO UPDATE SET text = excluded.text, created = excluded.created, updated = excluded.updated""",
                           (s["conversation_id"], s["text"], s["created"], s["updated"]))
                counts["summaries"] += 1
        if "relationship" in sections:
            for key, entry in data.get("relationship", {}).items():
                row = db.execute("SELECT updated FROM relationship WHERE key = ?", (key,)).fetchone()
                if row and row["updated"] >= entry["updated"]:
                    continue
                db.execute("""INSERT INTO relationship (key, value, updated) VALUES (?, ?, ?)
                              ON CONFLICT(key) DO UPDATE SET value = excluded.value, updated = excluded.updated""",
                           (key, json.dumps(entry["value"], sort_keys=True), entry["updated"]))
                counts["relationship"] += 1
    return counts


def import_command(args):
    if args.replace and not args.yes:
        raise SystemExit("tohru-assistant: import --replace wipes the assistant's state first; add --yes")
    try:
        with open(args.file, encoding="utf-8") as f:
            data = validate_export(json.load(f))
    except (OSError, ValueError) as error:
        print(f"tohru-assistant: cannot import {args.file}: {error}", file=sys.stderr)
        return 1
    counts = import_state(connect(), data, replace=args.replace, only=args.only)
    emit({"imported": counts, "mode": "replace" if args.replace else "merge", "only": sorted(set(args.only or SECTIONS))})
    return 0


def main(argv=None):
    parser = argparse.ArgumentParser(prog="tohru-assistant")
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("providers")
    p.add_argument("--models", default="{}", help='JSON: {"claude": {"model": "", "effort": ""}, ...}')
    p = sub.add_parser("signin")
    p.add_argument("provider")
    for name in ("chat", "remember"):
        p = sub.add_parser(name)
        if name == "chat":
            p.add_argument("--provider", required=True)
            p.add_argument("--conversation", default="")
            p.add_argument("--voice", action="store_true")
            p.add_argument("--draft", action="store_true")
            p.add_argument("--interrupted", default="")
            p.add_argument("--persona", choices=("on", "off"), default="on")
            p.add_argument("--persona-file", default="")
        else:
            p.add_argument("conversation")
            p.add_argument("--models", default="{}", help="as for providers")
        p.add_argument("--model", default="")
        p.add_argument("--effort", default="")
        p.add_argument("--memory", choices=("on", "off"), default="on")
    p = sub.add_parser("commit")
    p.add_argument("--provider", required=True)
    p.add_argument("--conversation", default="")
    p.add_argument("--voice", action="store_true")
    p.add_argument("--session", default="")
    p = sub.add_parser("rollback")
    p.add_argument("conversation")
    p = sub.add_parser("history")
    p.add_argument("--query", default="")
    p.add_argument("--provider", default="")
    p.add_argument("--since", type=int)
    p.add_argument("--limit", type=int, default=50)
    p = sub.add_parser("show")
    p.add_argument("conversation")
    p = sub.add_parser("delete")
    p.add_argument("conversation")
    p = sub.add_parser("memory")
    p.add_argument("action", choices=("list", "forget", "clear"))
    p.add_argument("id", nargs="?")
    p.add_argument("--json", action="store_true")
    p = sub.add_parser("export")
    p.add_argument("file", nargs="?")
    p = sub.add_parser("import")
    p.add_argument("file")
    mode = p.add_mutually_exclusive_group()
    mode.add_argument("--merge", action="store_true")
    mode.add_argument("--replace", action="store_true")
    p.add_argument("--yes", action="store_true")
    p.add_argument("--only", action="append", choices=SECTIONS)
    args = parser.parse_args(argv)

    if args.command == "providers":
        try:
            models = json.loads(args.models)
        except ValueError:
            models = {}
        emit(discover(models))
    elif args.command == "signin":
        signin(args.provider)
    elif args.command == "chat":
        return chat(args)
    elif args.command == "commit":
        return commit_draft(args)
    elif args.command == "rollback":
        return rollback(args)
    elif args.command == "remember":
        return remember(args)
    elif args.command == "history":
        emit(search(connect(), args.query, max(1, min(args.limit, 500)), args.provider or None, args.since))
    elif args.command == "show":
        conversation = load(connect(), args.conversation)
        if conversation is None:
            print("tohru-assistant: no such conversation", file=sys.stderr)
            return 1
        for key in ("sessions", "remembered"):
            conversation.pop(key, None)
        emit(conversation)
    elif args.command == "delete":
        db = connect()
        with transaction(db):
            gone = db.execute("DELETE FROM conversations WHERE id = ?", (check_id(args.conversation),)).rowcount
            db.execute("DELETE FROM summaries WHERE conversation_id = ?", (args.conversation,))
        return 0 if gone else 1
    elif args.command == "memory":
        return memory_command(args)
    elif args.command == "export":
        return export_command(args)
    elif args.command == "import":
        return import_command(args)
    return 0


if __name__ == "__main__":
    sys.exit(main())
