#!/usr/bin/env bash
set -uo pipefail
root=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/.." && pwd)
runtime=${TOHRU_RUNTIME_OVERRIDE:-${TOHRU_RUNTIME:-pleamar}}
styled=${TOHRU_GREETER_SCENE:-$root/shell/greeter/greeter.plm}
plain=${TOHRU_GREETER_PLAIN_SCENE:-$root/shell/greeter/plain.plm}
if [[ -n ${TOHRU_SHELL_DIR:-} ]]; then
    styled=$TOHRU_SHELL_DIR/greeter/greeter.plm
    plain=$TOHRU_SHELL_DIR/greeter/plain.plm
fi

export TOHRU_SHELL=1 TOHRU_GREETER=1 PLEAMAR_NO_PORTAL=1 PLEAMAR_GENERIC=1

scene=$styled
if ! "$runtime" --check "$styled" >/dev/null 2>&1; then
    printf 'tohru-greeter: %s does not load; using the plain style\n' "$styled" >&2
    scene=$plain
fi

# The hosting compositor may exit successfully after a failed greeter. Record
# the child result for its TUI fallback, only in the host's private runtime file.
record_status() {
    local status=$?
    local marker=${TOHRU_GREETER_EXIT_FILE:-}
    if [[ -n ${XDG_RUNTIME_DIR:-} && $marker == "$XDG_RUNTIME_DIR"/tohru-greeter-status.* && -f $marker && ! -L $marker && -O $marker ]]; then
        printf '%s\n' "$status" >"$marker"
    fi
}
trap record_status EXIT
child=
trap 'if [[ -n $child ]]; then kill -TERM "$child" 2>/dev/null || true; wait "$child" 2>/dev/null || true; fi; exit 143' TERM INT
run_scene() {
    "$runtime" --scene "$1" --no-hud --stall 0 --answer-as tohru-greeter "${@:2}" &
    child=$!
    wait "$child"
    local result=$?
    child=
    return "$result"
}
run_scene "$scene" "$@"
status=$?
if [[ $status -ne 0 && $scene != "$plain" ]]; then
    printf 'tohru-greeter: styled greeter ended with status %s; retrying with plain style\n' "$status" >&2
    run_scene "$plain" "$@"
    status=$?
fi
exit "$status"
