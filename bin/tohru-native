#!/bin/sh
# Each Rust command in this checkout is a link to this script, which runs the build of the same name.
# Builtins only: assistant providers run tools with a PATH that may lack coreutils and bash.
set -eu
case $0 in
    */*) here=${0%/*} ;;
    *) here=. ;;
esac
here=$(cd -- "$here" && pwd)
name=${0##*/}
target=${TOHRU_DESKTOP_TARGET:-${CARGO_TARGET_DIR:-$here/../desktop/target}/release}
if [ ! -x "$target/$name" ]; then
    printf '%s: not built; run cargo build --release --manifest-path %s/desktop/Cargo.toml\n' "$name" "${here%/*}" >&2
    exit 127
fi
TOHRU_BIN_DIR=${TOHRU_BIN_DIR:-$here}
export TOHRU_BIN_DIR
exec "$target/$name" "$@"
