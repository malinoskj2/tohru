#!/usr/bin/env bash
set -euo pipefail
usage() {
    cat <<'HELP'
Usage: tohru panel toggle|open sound|calendar|network|media|bluetooth|wallpaper|about|info|notifications|tray
       tohru panel close
       tohru settings open|close
       tohru session open|close|toggle
       tohru launcher toggle|open|close
       tohru lock
       tohru avatar set FILE | clear
       tohru notifications open|close|toggle|clear|seen | dnd on|off|toggle
       tohru routing-error
       tohru audio volume up|down
       tohru audio mute toggle
       tohru audio input volume up|down | input mute toggle | input select ID
       tohru audio output select ID
       tohru audio app ID volume up|down | app ID mute toggle
       tohru audio status --json
       tohru status --json
       tohru config reload
       tohru config set appearance.palette mocha|macchiato|rose_pine|nord|gruvbox|tokyo_night|dracula|everforest
       tohru config set bar.mooncoil|bar.info_button|bar.about_button|appearance.corners|polkit.agent true|false
       tohru config set appearance.font_text|appearance.font_display|appearance.font_mono FAMILY
       tohru config set wallpaper.KEY|idle.KEY VALUE   (see docs/standalone.md)
       tohru config set appearance.corner_size 1..100
       tohru config set lock.style STYLE   (still-glass, ribbon-key, flooded-monolith, drifting-frost-veil, unfolding-glass-capsule, edge-glass-drawer, horizon-meniscus, refractive-typographic-lens, corner-anchor, bar-drop-curtain)
       tohru config set notifications.position top-right|bottom-right
       tohru config set assistant.KEY VALUE   (voice, voice_source, reduced_motion, provider, backend, orca, orca_bot, orca_voice_chat, orca_offline,
                                               models.PROVIDER.model, models.PROVIDER.effort, persona, persona_file,
                                               voice_models.PROVIDER.model|effort, semantic_models.PROVIDER.model|effort,
                                               memory, discord.enabled, discord.read, discord.post,
                                               discord.desktop_first, discord.desktop_timeout_seconds, discord.destination, discord.receive,
                                               discord.token_file, discord.guild_id, discord.channels, discord.allowed_user_id, vad_model, asr_model, turn_model, voice_wake, kws_model, tts_*;
                                               see docs/configuration.md)
       tohru config set bar.preferred_output OUTPUT   ('' for every output)
       tohru assistant open|close|toggle | show [ID]   (show opens a chat; ID defaults to $TOHRU_CONVERSATION)
       tohru assistant alert [--chat ID] [--speak] [--title TITLE] MESSAGE
       tohru assistant orca init [--bot NAME] [--no-migrate] [--force-soul]
       tohru assistant memory list [--json] | memory forget ID | memory clear
       tohru assistant export [FILE]   (the whole assistant state as versioned JSON; stdout without FILE; files are 0600)
       tohru assistant import FILE [--merge | --replace --yes] [--only history|memory|relationship]...
       tohru settings-error
       tohru doctor [--json]
       tohru session-units --output DIR [--components bar,session,launcher]
       tohru echo-cancel [--output FILE]
       tohru shortcuts [status|setup|configure]
       tohru greeter-check [--config FILE] [--settings FILE] [--json]
       tohru help

Commands report native request acceptance, not completion.
Audio status reports the last native observation and command errors.
Inspect status and settings-error for settings results or failure.
HELP
}
fail() { printf '%s\n' "$1" >&2; exit 2; }
pleamar=${TOHRU_RUNTIME:-pleamar}
audio_id() {
    [[ $1 =~ ^(0|[1-9][0-9]{0,9})$ ]] && (( 10#$1 <= 4294967295 )) || fail 'Audio ID must be a canonical unsigned 32-bit integer'
}
case ${1:-help} in
    help|--help|-h)
        [[ $# -le 1 ]] || fail 'help takes no arguments'
        usage
        ;;
    doctor|session-units|echo-cancel|shortcuts|greeter-check)
        exec python3 "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/tohru_portability.py" "$@"
        ;;
    dev)
        shift
        exec "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/tohru-dev" "$@"
        ;;
    session)
        [[ $# == 2 ]] || fail 'Usage: tohru session open|close|toggle'
        case $2 in open|close|toggle) ;; *) fail 'Usage: tohru session open|close|toggle' ;; esac
        exec "$pleamar" --say tohru-session "emit menu_$2"
        ;;
    launcher)
        [[ $# == 2 ]] || fail 'Usage: tohru launcher toggle|open|close'
        case $2 in toggle|open|close) ;; *) fail 'Usage: tohru launcher toggle|open|close' ;; esac
        exec "$pleamar" --say tohru-launcher "emit launcher_$2"
        ;;
    notifications)
        case "${2:-}:${3:-}:$#" in
            open::2) exec "$pleamar" --say tohru-notifications 'emit notices_center_open 0' ;;
            close::2) exec "$pleamar" --say tohru-notifications 'emit notices_center_close 0' ;;
            toggle::2) exec "$pleamar" --say tohru-notifications 'emit notices_center_toggle 0' ;;
            clear::2) exec "$pleamar" --say tohru-notifications 'emit notices_clear_all 0' ;;
            seen::2) exec "$pleamar" --say tohru-notifications 'emit notices_seen 0' ;;
            dnd:off:3) exec "$pleamar" --say tohru-notifications 'emit notices_dnd 0' ;;
            dnd:on:3) exec "$pleamar" --say tohru-notifications 'emit notices_dnd 1' ;;
            dnd:toggle:3) exec "$pleamar" --say tohru-notifications 'emit notices_dnd 2' ;;
            *) fail 'Usage: tohru notifications open|close|toggle|clear|seen | dnd on|off|toggle' ;;
        esac
        ;;
    lock)
        [[ $# == 1 ]] || fail 'lock takes no arguments'
        exec "${TOHRU_LOCK_RUN:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/tohru-lock}"
        ;;
    avatar)
        case ${2:-} in
            set)
                [[ $# == 3 ]] || fail 'Usage: tohru avatar set FILE'
                abs=$(readlink -f -- "$3" 2>/dev/null) || fail "Cannot resolve avatar path: $3"
                [[ -f $abs && -r $abs && -s $abs ]] || fail "Avatar must be a readable, non-empty image file: $3"
                uid=$(id -u)
                updated_accounts=0
                if command -v busctl >/dev/null 2>&1; then
                    if busctl --system call org.freedesktop.Accounts "/org/freedesktop/Accounts/User${uid}" \
                        org.freedesktop.Accounts.User SetIconFile s "$abs" >/dev/null 2>&1; then
                        updated_accounts=1
                    fi
                fi
                if [[ -n ${HOME:-} && -d $HOME && -w $HOME ]]; then
                    face=$(readlink -f -- "$HOME/.face" 2>/dev/null || printf '%s/.face' "$HOME")
                    if [[ $abs != "$face" ]]; then
                        cp -- "$abs" "$HOME/.face"
                    fi
                fi
                if [[ $updated_accounts == 1 ]]; then
                    printf 'Updated avatar via AccountsService and ~/.face\n'
                else
                    printf 'Updated ~/.face (AccountsService unavailable; greeter needs accounts-daemon or services.tohru-greeter.avatars)\n'
                fi
                ;;
            clear)
                [[ $# == 2 ]] || fail 'Usage: tohru avatar clear'
                uid=$(id -u)
                if command -v busctl >/dev/null 2>&1; then
                    busctl --system call org.freedesktop.Accounts "/org/freedesktop/Accounts/User${uid}" \
                        org.freedesktop.Accounts.User SetIconFile s "" >/dev/null 2>&1 || true
                fi
                if [[ -n ${HOME:-} ]]; then
                    rm -f -- "$HOME/.face" "$HOME/.face.icon"
                fi
                printf 'Cleared user avatar\n'
                ;;
            *) fail 'Usage: tohru avatar set FILE | clear' ;;
        esac
        ;;
    routing-error)
        [[ $# == 1 ]] || fail 'routing-error takes no arguments'
        exec "$pleamar" --say tohru 'get routing_error'
        ;;
    settings)
        [[ $# == 2 ]] || fail 'Usage: tohru settings open|close'
        case $2 in
            open)
                "$pleamar" --say tohru-settings 'emit settings_open_request' >/dev/null 2>&1 && exit 0
                # A keybind's environment may lack the managed file the bar's service was given.
                if [[ -z ${TOHRU_MANAGED_CONFIG:-} ]]; then
                    managed=$("$pleamar" --say tohru 'get managed_config' 2>/dev/null) || managed=
                    if [[ -n $managed && -f $managed ]]; then export TOHRU_MANAGED_CONFIG=$managed; fi
                fi
                run=${TOHRU_SETTINGS_RUN:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/tohru-settings-run}
                (set -m; nohup "$run" </dev/null >/dev/null 2>&1 &)
                ;;
            close) exec "$pleamar" --say tohru-settings quit ;;
            *) fail 'Usage: tohru settings open|close' ;;
        esac
        ;;
    panel)
        case ${2:-} in
            open|toggle)
                [[ $# == 3 && ( $3 == sound || $3 == calendar || $3 == network || $3 == media || $3 == bluetooth || $3 == wallpaper || $3 == about || $3 == info || $3 == notifications || $3 == tray ) ]] || fail 'Usage: tohru panel open|toggle sound|calendar|network|media|bluetooth|wallpaper|about|info|notifications|tray'
                if [[ $3 == notifications ]]; then
                    case $2 in
                        open) exec "$pleamar" --say tohru-notifications 'emit notices_center_open 0' ;;
                        toggle) exec "$pleamar" --say tohru-notifications 'emit notices_center_toggle 0' ;;
                    esac
                fi
                case "$3:$2" in
                    sound:open) event=sound_open_request ;; sound:toggle) event=sound_toggle ;;
                    calendar:open) event=calendar_open ;; calendar:toggle) event=calendar_toggle ;;
                    network:open) event=network_open ;; network:toggle) event=network_toggle ;;
                    media:open) event=media_open ;; media:toggle) event=media_toggle ;;
                    bluetooth:open) event=bluetooth_open ;; bluetooth:toggle) event=bluetooth_toggle ;;
                    wallpaper:open) event=wall_open_request ;; wallpaper:toggle) event=wall_toggle ;;
                    about:open) event=about_open ;; about:toggle) event=about_toggle ;;
                    info:open) event=info_open ;; info:toggle) event=info_toggle ;;
                    tray:open) event=tray_open_request ;; tray:toggle) event=tray_overflow_toggle ;;
                esac
                exec "$pleamar" --say tohru "emit $event"
                ;;
            close)
                [[ $# == 2 ]] || fail 'Usage: tohru panel close'
                exec "$pleamar" --say tohru 'emit panel_close'
                ;;
            *) fail 'Usage: tohru panel open|toggle sound|calendar|network|media|bluetooth|wallpaper|about|info|notifications|tray | close' ;;
        esac
        ;;
    audio)
        case ${2:-} in
            input)
                [[ $# == 4 ]] || fail 'Usage: tohru audio input volume up|down | input mute toggle | input select ID'
                case "$3:$4" in
                    volume:up) event=audio_input_up ;; volume:down) event=audio_input_down ;;
                    mute:toggle) event=audio_input_mute ;;
                    select:*)
                        audio_id "$4"
                        exec "$pleamar" --say tohru "emit audio_input_select $4"
                        ;;
                    *) fail 'Usage: tohru audio input volume up|down | input mute toggle | input select ID' ;;
                esac
                exec "$pleamar" --say tohru "emit $event"
                ;;
            output)
                [[ $# == 4 && $3 == select ]] || fail 'Usage: tohru audio output select ID'
                audio_id "$4"
                exec "$pleamar" --say tohru "emit audio_output_select $4"
                ;;
            app)
                [[ $# == 5 ]] || fail 'Usage: tohru audio app ID volume up|down | app ID mute toggle'
                audio_id "$3"
                case "$4:$5" in volume:up) event=audio_app_up ;; volume:down) event=audio_app_down ;; mute:toggle) event=audio_app_mute ;; *) fail 'Usage: tohru audio app ID volume up|down | app ID mute toggle' ;; esac
                exec "$pleamar" --say tohru "emit $event $3"
                ;;
            volume)
                [[ $# == 3 ]] || fail 'Usage: tohru audio volume up|down'
                case $3 in up) step=1 ;; down) step=-1 ;; *) fail 'Usage: tohru audio volume up|down' ;; esac
                exec "$pleamar" --say tohru "emit audio_step $step"
                ;;
            mute)
                [[ $# == 3 && $3 == toggle ]] || fail 'Usage: tohru audio mute toggle'
                exec "$pleamar" --say tohru 'emit audio_mute'
                ;;
            status)
                [[ $# == 3 && $3 == --json ]] || fail 'Usage: tohru audio status --json'
                exec "$pleamar" --say tohru 'get audio_status'
                ;;
            *) fail 'Usage: tohru audio volume up|down | mute toggle | status --json' ;;
        esac
        ;;
    status)
        [[ $# == 2 && $2 == --json ]] || fail 'Usage: tohru status --json'
        exec "$pleamar" --say tohru 'get settings_status'
        ;;
    config)
        case ${2:-} in
            reload)
                [[ $# == 2 ]] || fail 'Usage: tohru config reload'
                exec "$pleamar" --say tohru 'emit config_reload'
                ;;
            set)
                [[ $# == 4 ]] || fail 'Usage: tohru config set KEY VALUE'
                case $3 in
                    bar.mooncoil|bar.info_button|bar.about_button|appearance.corners|polkit.agent)
                        case $4 in true) number=1 ;; false) number=0 ;; *) fail 'Value must be true or false' ;; esac
                        case $3 in
                            bar.mooncoil) event=setting_mooncoil ;;
                            bar.info_button) event=setting_info_button ;;
                            bar.about_button) event=setting_about_button ;;
                            appearance.corners) event=setting_corners ;;
                            polkit.agent) event=setting_polkit_agent ;;
                        esac
                        exec "$pleamar" --say tohru "emit $event $number"
                        ;;
                    appearance.palette)
                        case $4 in mocha) number=0 ;; macchiato) number=1 ;; rose_pine) number=2 ;; nord) number=3 ;; gruvbox) number=4 ;; tokyo_night) number=5 ;; dracula) number=6 ;; everforest) number=7 ;; *) fail 'Choose a canonical retained palette name' ;; esac
                        exec "$pleamar" --say tohru "emit setting_palette $number"
                        ;;
                    bar.preferred_output)
                        [[ $4 != *[[:cntrl:]]* && ${#4} -le 256 ]] || fail 'Invalid output name'
                        exec "$pleamar" --say tohru "text output_request $4" 'emit setting_output'
                        ;;
                    appearance.corner_size)
                        [[ $4 =~ ^([1-9]|[1-9][0-9]|100)$ ]] || fail 'Corner size must be an integer from 1 to 100'
                        exec "$pleamar" --say tohru "emit setting_corner_size $4"
                        ;;
                    lock.style)
                        number=0
                        for style in still-glass ribbon-key flooded-monolith drifting-frost-veil unfolding-glass-capsule edge-glass-drawer horizon-meniscus refractive-typographic-lens corner-anchor bar-drop-curtain; do
                            [[ $4 == "$style" ]] && exec "$pleamar" --say tohru "emit setting_lock_style $number"
                            number=$((number + 1))
                        done
                        fail 'Choose a lock style: still-glass, ribbon-key, flooded-monolith, drifting-frost-veil, unfolding-glass-capsule, edge-glass-drawer, horizon-meniscus, refractive-typographic-lens, corner-anchor, bar-drop-curtain'
                        ;;
                    notifications.position)
                        case $4 in top-right) number=0 ;; bottom-right) number=1 ;; *) fail 'Choose a notification position: top-right, bottom-right' ;; esac
                        exec "$pleamar" --say tohru "emit setting_notifications_position $number"
                        ;;
                    appearance.font_text|appearance.font_display|appearance.font_mono|shortcuts.*|wallpaper.*|idle.*|assistant.*)
                        [[ $3 =~ ^(assistant|appearance|wallpaper|idle|shortcuts)\.[a-z_.]+$ && $4 != *[[:cntrl:]]* && ${#4} -le 4096 ]] || fail 'Invalid assistant setting'
                        exec "$pleamar" --say tohru "text setting_key $3" "text setting_value $4" 'emit setting_assistant'
                        ;;
                    *) fail 'Unknown setting key' ;;
                esac
                ;;
            *) fail 'Usage: tohru config reload|set KEY VALUE' ;;
        esac
        ;;
    assistant)
        helper=${TOHRU_ASSISTANT:-$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/tohru-assistant}
        conv_id_ok() {
            [[ $1 =~ ^([0-9a-fA-F]{4,32}|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$ ]]
        }
        case ${2:-} in
            open|close|toggle)
                [[ $# == 2 ]] || fail "Usage: tohru assistant $2"
                exec "$pleamar" --say tohru "emit assistant_$2"
                ;;
            show)
                id=${3:-${TOHRU_CONVERSATION:-}}
                [[ $# -le 3 ]] && conv_id_ok "$id" || fail 'Usage: tohru assistant show [ID]   (ID defaults to $TOHRU_CONVERSATION)'
                exec "$pleamar" --say tohru "text ai_show_request $id" 'emit assistant_open' 'emit assistant_show_request'
                ;;
            voice-result)
                shift 2
                chat_id= request_id= completion_id=
                while [[ $# -gt 0 ]]; do
                    case $1 in
                        --chat|--request|--completion)
                            [[ $# -ge 2 ]] || fail 'Missing voice-result argument'
                            case $1 in --chat) chat_id=$2 ;; --request) request_id=$2 ;; --completion) completion_id=$2 ;; esac
                            shift 2 ;;
                        --) shift; break ;;
                        *) fail 'Invalid voice-result option' ;;
                    esac
                done
                conv_id_ok "$chat_id" || fail 'Invalid conversation ID'
                [[ $request_id =~ ^[A-Za-z0-9_:%.-]{1,512}$ && $completion_id =~ ^[A-Za-z0-9_:%.-]{1,512}$ ]] || fail 'Invalid voice-result identity'
                [[ $# == 1 && -n $1 && ${#1} -le 16384 && $1 != *[[:cntrl:]]* ]] || fail 'Invalid voice-result text'
                exec "$pleamar" --say tohru "text ai_voice_result_chat $chat_id" "text ai_voice_result_request $request_id" \
                    "text ai_voice_result_completion $completion_id" "text ai_voice_result_text $1" 'emit assistant_voice_result'
                ;;
            alert)
                shift 2
                chat_id=
                speak=0
                title=Tohru
                while [[ $# -gt 0 ]]; do
                    case $1 in
                        --chat)
                            [[ $# -ge 2 ]] || fail 'Usage: tohru assistant alert [--chat ID] [--speak] [--title TITLE] MESSAGE'
                            conv_id_ok "$2" || fail 'Invalid conversation ID'
                            chat_id=$2
                            shift 2
                            ;;
                        --speak)
                            speak=1
                            shift
                            ;;
                        --title)
                            [[ $# -ge 2 ]] || fail 'Usage: tohru assistant alert [--chat ID] [--speak] [--title TITLE] MESSAGE'
                            title=$2
                            shift 2
                            ;;
                        --)
                            shift
                            break
                            ;;
                        --*)
                            fail 'Usage: tohru assistant alert [--chat ID] [--speak] [--title TITLE] MESSAGE'
                            ;;
                        *)
                            break
                            ;;
                    esac
                done
                [[ $# == 1 && -n $1 ]] || fail 'Usage: tohru assistant alert [--chat ID] [--speak] [--title TITLE] MESSAGE'
                msg=$1
                [[ $title != *[[:cntrl:]]* && ${#title} -le 128 ]] || fail 'Invalid alert title'
                [[ $msg != *[[:cntrl:]]* && ${#msg} -le 1024 ]] || fail 'Invalid alert message'
                if [[ -n ${TOHRU_NOTIFY_CMD:-} ]]; then
                    "$TOHRU_NOTIFY_CMD" "$title" "$msg" >/dev/null 2>&1 || true
                elif command -v notify-send >/dev/null 2>&1; then
                    notify-send --app-name=Tohru "$title" "$msg" >/dev/null 2>&1 || true
                elif command -v busctl >/dev/null 2>&1; then
                    busctl --user call org.freedesktop.Notifications /org/freedesktop/Notifications \
                        org.freedesktop.Notifications Notify 'susssasa{sv}i' \
                        Tohru 0 "" "$title" "$msg" 0 0 6000 >/dev/null 2>&1 || true
                fi
                exec "$pleamar" --say tohru "text ai_alert_chat $chat_id" "text ai_alert_text $msg" "emit assistant_alert $speak"
                ;;
            orca)
                [[ ${3:-} == init ]] || fail 'Usage: tohru assistant orca init [--bot NAME] [--no-migrate] [--force-soul]'
                exec "$helper" "${@:2}"
                ;;
            memory)
                case ${3:-} in
                    list) [[ $# == 3 || ( $# == 4 && $4 == --json ) ]] || fail 'Usage: tohru assistant memory list [--json]' ;;
                    forget) [[ $# == 4 && $4 =~ ^[0-9a-f]{4,32}$ ]] || fail 'Usage: tohru assistant memory forget ID' ;;
                    clear) [[ $# == 3 ]] || fail 'Usage: tohru assistant memory clear' ;;
                    *) fail 'Usage: tohru assistant memory list|forget ID|clear' ;;
                esac
                exec "$helper" "${@:2}"
                ;;
            export)
                [[ $# -le 3 ]] || fail 'Usage: tohru assistant export [FILE]'
                exec "$helper" "${@:2}"
                ;;
            import)
                [[ $# -ge 3 ]] || fail 'Usage: tohru assistant import FILE [--merge|--replace --yes] [--only history|memory|relationship]...'
                exec "$helper" "${@:2}"
                ;;
            *) fail 'Usage: tohru assistant open|close|toggle | show [ID] | alert [--chat ID] [--speak] [--title TITLE] MESSAGE | orca init [--bot NAME] | memory list|forget ID|clear | export [FILE] | import FILE [--merge|--replace --yes] [--only SECTION]' ;;
        esac
        ;;
    settings-error)
        [[ $# == 1 ]] || fail 'Usage: tohru settings-error'
        exec "$pleamar" --say tohru 'get settings_error'
        ;;
    *) fail 'Unknown command; run tohru help' ;;
esac
