+  vi.restoreAllMocks()
+  vi.useRealTimers()
+})
+const base = { session_id: 'provider', transcript_path: '/tmp/t', cwd: '/tmp' }
+function callbacks() {
+  const hooks = claudeThinHomeOptions('home').hooks
+  const callback = hooks?.PreToolUse?.[0]?.hooks[0]
+  if (!callback) throw new Error('Missing native guard')
+  return (input: HookInput) => callback(input, 'tool', { signal: new AbortController().signal })
+}
+const shell = (id: string) => ({
+  ...base,
+  hook_event_name: 'PreToolUse' as const,
+  tool_use_id: id,
+  tool_name: 'Bash',
