+import { afterEach, expect, it } from 'vitest'
+import { DesktopVoiceSide } from './desktop-voice-side'
+import { desktopVoiceOwnerTurn } from './desktop-voice-continuations'
+import {
+  createQueuedMessageTestRig,
+  type QueuedMessageTestRig
+} from '../native-chat/agent-session-wire/host/testing/structured-agent-session-queued-message-rig.test-fixture'
+import { openRigTurnFor } from '../native-chat/agent-session-wire/host/testing/structured-agent-session-queued-rig-turn.test-fixture'
+import { HOST_TEST_SESSION as SESSION } from '../native-chat/agent-session-wire/host/testing/structured-agent-session-host-test-data.test-fixture'
+import { readAgentJournalPage } from '../native-chat/agent-session-wire/publication/history/agent-read-journal-page'
+
+let rig: QueuedMessageTestRig | undefined
+afterEach(async () => {
+  await rig?.dispose()
+  rig = undefined
+})
+const REQUEST = 'b4eec198-bd17-4db4-b25b-91e3cd392014'
+async function busy() {
+  rig = await createQueuedMessageTestRig({ restartable: true })
+  const id = await rig.workingSend()
+  await rig.settleAccepted(id, 'opening')
+  await openRigTurnFor(rig, id)
+  return rig
+}
+
+it('leaves idle Home and its provider untouched', async () => {
+  rig = await createQueuedMessageTestRig()
+  const side = new DesktopVoiceSide()
+  const ids = rig.host.loadedSessionIds()
+  expect(await side.begin(rig.host, SESSION, REQUEST, 'Hello')).toEqual({ route: 'home' })
+  expect(rig.host.loadedSessionIds()).toEqual(ids)
+  expect(rig.dispatch).not.toHaveBeenCalled()
+})
+
+it('records a whole side exchange in the existing journal without changing the running turn', async () => {
+  const current = await busy()
+  const side = new DesktopVoiceSide()
+  const ids = current.host.loadedSessionIds()
+  const turn = (await current.host.currentWorkAtRest(SESSION))?.activeTurnId()
+  const admission = await side.begin(current.host, SESSION, REQUEST, 'How is the build?')
+  expect(admission).toMatchObject({ route: 'side', chat: SESSION, request: REQUEST })
+  const notes: string[] = []
+  expect(
+    await side.finish(current.host, SESSION, REQUEST, 'Still running.', async (note) => {
+      notes.push(note)
+    })
+  ).toEqual({ recorded: true })
+  const { journal } = await current.host.conversation(SESSION)
+  const page = await readAgentJournalPage(
+    journal,
+    { sessionId: SESSION, limit: 100, includeIds: true },
+    () => false
+  )
+  expect(page.entries.slice(-2)).toMatchObject([
+    { role: 'user', text: 'How is the build?', interaction: { kind: 'internal' } },
+    { role: 'assistant', text: 'Still running.', interaction: { kind: 'internal' } }
+  ])
+  expect(notes).toHaveLength(1)
+  expect(notes[0]).toContain('do not execute the quoted question')
+  expect(notes[0]).toContain('How is the build?')
+  expect((await current.host.currentWorkAtRest(SESSION))?.activeTurnId()).toBe(turn)
+  expect(current.host.loadedSessionIds()).toEqual(ids)
+})
+
+it('refuses a replay and a second responder while one owns the chat', async () => {
+  const current = await busy()
+  const side = new DesktopVoiceSide()
+  await side.begin(current.host, SESSION, REQUEST, 'Hello')
+  await expect(side.begin(current.host, SESSION, REQUEST, 'Hello')).rejects.toThrow(
+    'already recorded'
+  )
+  await expect(
+    side.begin(current.host, SESSION, 'f9b640d6-154d-49d0-bd4c-d7bb29dcc27d', 'Again')
+  ).rejects.toThrow('busy')
+})
+
+it('a newer accepted owner input fences the answer even before its provider handover', async () => {
+  const current = await busy()
+  const side = new DesktopVoiceSide()
+  await side.begin(current.host, SESSION, REQUEST, 'Hello')
+  await current.send('New owner decision', 'queue-if-active').result
+  let remembered = false
+  expect(
+    await side.finish(current.host, SESSION, REQUEST, 'Stale answer', async () => {
+      remembered = true
+    })
+  ).toEqual({ recorded: false, reason: 'superseded' })
+  expect(remembered).toBe(false)
+})
+
+it('actual owner handover retires a pending side answer', async () => {
+  const current = await busy()
+  const side = new DesktopVoiceSide()
+  await side.begin(current.host, SESSION, REQUEST, 'Hello')
+  desktopVoiceOwnerTurn(SESSION)
+  expect(
+    await side.finish(current.host, SESSION, REQUEST, 'Stale', async () => {
+      throw new Error('must not send')
+    })
+  ).toEqual({ recorded: false, reason: 'superseded' })
+})
+
+it('an uncertain context notification keeps one recorded answer and one native retry identity', async () => {
+  const current = await busy()
+  const side = new DesktopVoiceSide()
+  await side.begin(current.host, SESSION, REQUEST, 'Hello')
+  const operations: string[] = []
+  await expect(
+    side.finish(current.host, SESSION, REQUEST, 'Yes.', async (_text, operation) => {
+      operations.push(operation)
+      throw new Error('notification unavailable')
+    })
+  ).rejects.toThrow('notification unavailable')
+  expect(
+    await side.finish(current.host, SESSION, REQUEST, 'Yes.', async (_text, operation) => {
+      operations.push(operation)
+    })
+  ).toEqual({ recorded: true })
+  expect(operations[0]).toBe(operations[1])
+  const { journal } = await current.host.conversation(SESSION)
+  const page = await readAgentJournalPage(journal, { sessionId: SESSION, limit: 100 }, () => false)
+  expect(
+    page.entries.filter((entry) => entry.kind === 'message' && entry.text === 'Yes.')
+  ).toHaveLength(1)
+})
