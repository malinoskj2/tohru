@@ -0,0 +1,55 @@
+import { BotVoiceSide } from '../../../../shared/rpc-contract/bot-voice-side-params'
+import { requireStructuredHost, runtimeBotChats } from '../../../bots/bot-chat-session'
+import { desktopVoiceSide } from '../../../bots/desktop-voice-side'
+import { SIDE_VOICE_SOURCE } from '../../../../shared/bots/bot-voice-methods'
+import { botChatTakingMail } from './bots-chats'
+import { chatThatTookIt } from '../../../bots/bot-automation-sessions'
+import { defineMethod, InvalidArgumentError } from '../core'
+
+export const BOT_VOICE_SIDE_METHOD = defineMethod({
+  name: 'bots.voice.side',
+  permission: 'workspace',
+  params: BotVoiceSide,
+  handler: async (params, context) => {
+    if (
+      context.pairedDeviceId ||
+      context.orchestrationCaller ||
+      context.caller?.kind !== 'local-cli'
+    ) {
+      throw new InvalidArgumentError(
+        'Side voice requires the local owner socket without an agent caller'
+      )
+    }
+    const { runtime } = context
+    runtime.bots.assertEnabled()
+    const bot = runtime.bots.list().find((entry) => entry.id === params.botId)
+    if (!bot || bot.paused || !bot.chatSessionId)
+      throw new InvalidArgumentError('Existing active Home required')
+    const target = await botChatTakingMail(runtime, bot, bot.chatSessionId)
+    if (!target) throw new InvalidArgumentError('Home is closed')
+    const chat = target.sessionId
+    const host = await requireStructuredHost(runtime)
+    if (params.phase === 'begin')
+      return desktopVoiceSide.begin(host, bot.chatSessionId, params.request, params.text, params.always)
+    return desktopVoiceSide.finish(
+      host,
+      chat,
+      params.request,
+      params.text,
+      async (text, operation) => {
+        // A fixed native operation identity makes an uncertain reminder admission safe to retry.
+        chatThatTookIt(
+          await runtimeBotChats(runtime).sendToSession(
+            bot.id,
+            chat,
+            text,
+            { memorySource: SIDE_VOICE_SOURCE },
+            undefined,
+            operation
+          )
+        )
+      },
+      params.answered
+    )
+  }
+})
