+import { afterEach, expect, it } from 'vitest'
+import { DesktopVoiceSide } from './desktop-voice-side'
+import { desktopVoiceOwnerTurn } from './desktop-voice-continuations'
+import { desktopVoiceTasks } from './desktop-voice-task-delivery'
+import {
+  createQueuedMessageTestRig,
+  type QueuedMessageTestRig
+} from '../native-chat/agent-session-wire/host/testing/structured-agent-session-queued-message-rig.test-fixture'
+import { openRigTurnFor } from '../native-chat/agent-session-wire/host/testing/structured-agent-session-queued-rig-turn.test-fixture'
+import { HOST_TEST_SESSION as SESSION } from '../native-chat/agent-session-wire/host/testing/structured-agent-session-host-test-data.test-fixture'
+import { readAgentJournalPage } from '../native-chat/agent-session-wire/publication/history/agent-read-journal-page'
+
+let rig: QueuedMessageTestRig | undefined
+afterEach(async () => {
+  await rig?.dispose()
+  rig = undefined
+})
+const REQUEST = 'b4eec198-bd17-4db4-b25b-91e3cd392014'
+async function busy() {
+  rig = await createQueuedMessageTestRig({ restartable: true })
+  const id = await rig.workingSend()
+  await rig.settleAccepted(id, 'opening')
+  await openRigTurnFor(rig, id)
+  return rig
+}
+
+it('leaves idle Home and its provider untouched', async () => {
+  rig = await createQueuedMessageTestRig()
+  const side = new DesktopVoiceSide()
+  const ids = rig.host.loadedSessionIds()
+  expect(await side.begin(rig.host, SESSION, REQUEST, 'Hello')).toEqual({ route: 'home' })
+  expect(rig.host.loadedSessionIds()).toEqual(ids)
+  expect(rig.dispatch).not.toHaveBeenCalled()
+})
+
+it('admits idle Home on request without starting its provider and records the exchange', async () => {
+  rig = await createQueuedMessageTestRig()
+  const side = new DesktopVoiceSide()
+  const ids = rig.host.loadedSessionIds()
+  expect(await side.begin(rig.host, SESSION, REQUEST, 'What time is it?', true)).toMatchObject({
+    route: 'side',
+    chat: SESSION,
+    request: REQUEST,
+    busy: false
+  })
+  expect(rig.host.loadedSessionIds()).toEqual(ids)
+  expect(rig.dispatch).not.toHaveBeenCalled()
+  const notes: string[] = []
+  expect(
+    await side.finish(rig.host, SESSION, REQUEST, "It's half past three.", async (note) => {
+      notes.push(note)
+    })
+  ).toEqual({ recorded: true })
+  expect(notes).toHaveLength(1)
+  const { journal } = await rig.host.conversation(SESSION)
+  const page = await readAgentJournalPage(
+    journal,
+    { sessionId: SESSION, limit: 100, includeIds: true },
+    () => false
+  )
+  expect(page.entries.slice(-2)).toMatchObject([
+    { role: 'user', text: 'What time is it?', interaction: { kind: 'internal' } },
+    { role: 'assistant', text: "It's half past three.", interaction: { kind: 'internal' } }
+  ])
+  expect(rig.dispatch).not.toHaveBeenCalled()
+})
+
+it('reports busy Home to an always admission', async () => {
+  const current = await busy()
+  const side = new DesktopVoiceSide()
+  expect(await side.begin(current.host, SESSION, REQUEST, 'How is it going?', true)).toMatchObject({
+    route: 'side',
+    busy: true
+  })
+})
+
+it('records a whole side exchange in the existing journal without changing the running turn', async () => {
+  const current = await busy()
