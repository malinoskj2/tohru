index 00000000..4d06c7cd
--- /dev/null
+++ b/src/main/bots/desktop-voice-side.ts
@@ -0,0 +1,172 @@
+import type { StructuredAgentSessionHost } from '../native-chat/agent-session-wire/host/structured-agent-session-host'
+import { desktopVoiceTasks } from './desktop-voice-task-delivery'
+import { agentJournalItemKey } from '../../shared/agent-session/journal/agent-session-journal-item-key'
+import { AGENT_JOURNAL_THREAD_SCOPE } from '../../shared/agent-session/journal/agent-session-journal-types'
+import type { AgentJournalMessageItem } from '../../shared/agent-session/journal/agent-session-journal-types'
+import { readAgentJournalPage } from '../native-chat/agent-session-wire/publication/history/agent-read-journal-page'
+import { SIDE_VOICE_SOURCE } from '../../shared/bots/bot-voice-methods'
+
+export { SIDE_VOICE_SOURCE }
+type Journal = Awaited<ReturnType<StructuredAgentSessionHost['conversation']>>['journal']
+type Lease = {
+  chat: string
+  question: string
+  epoch: string
+  context: string | null
+  owner: string | null
+  queuedOwners: string
+  current: () => boolean
+  at: number
+  answer?: string
+}
+
+/** A responder is an owner-side process, never a native chat or a provider child. */
+export class DesktopVoiceSide {
+  private readonly leases = new Map<string, Lease>()
+  private readonly chats = new Set<string>()
+
+  private identity(request: string, role: 'user' | 'assistant') {
+    return { provider: 'orca' as const, clientMessageId: `voice-side:${request}:${role}` }
+  }
+
+  private async ownerQueue(journal: Journal): Promise<string> {
+    return JSON.stringify(
+      (await journal.queuedMessages.list())
+        .filter((row) => !row.body.from && !row.body.origin && !row.body.memorySource)
+        .map((row) => [row.messageId, row.state])
+    )
+  }
+
+  private async append(
+    journal: Journal,
+    request: string,
+    role: 'user' | 'assistant',
+    text: string,
+    fence: number
+  ): Promise<void> {
+    const body: AgentJournalMessageItem = {
+      kind: 'message',
+      role,
+      blocks: [{ type: 'text', text }],
+      memorySource: SIDE_VOICE_SOURCE
+    }
+    await journal.appendItem(this.identity(request, role), body, {
+      fence,
+      turnScope: AGENT_JOURNAL_THREAD_SCOPE
+    })
+  }
+
+  async begin(
+    host: StructuredAgentSessionHost,
+    chat: string,
+    request: string,
+    question: string,
+    always = false
+  ) {
+    await host.conversation(chat)
+    return host.serialize(chat, async () => {
+      const { journal } = await host.conversation(chat)
+      const record = host.deps.store.requireWritableRecord(chat)
+      // History's state includes accepted unopened input and unresolved approvals.
+      const history = await readAgentJournalPage(
+        journal,
+        { sessionId: chat, limit: 100, includeIds: true },
+        () => false
+      )
+      const work = await host.currentWorkAtRest(chat)
+      const busy = Boolean(work?.working() || work?.hasActionablePrompt())
+      if (!busy && !always) return { route: 'home' as const }
+      const existing = await journal.reads.itemDetail(
+        agentJournalItemKey(this.identity(request, 'user'))
+      )
+      if (existing || this.leases.has(request))
+        throw new Error('Side request already recorded; do not resend')
+      for (const [key, lease] of this.leases) {
+        if (Date.now() - lease.at > 60000) {
+          this.leases.delete(key)
+          this.chats.delete(lease.chat)
+        }
+      }
+      if (this.chats.has(chat) || this.leases.size >= 64) throw new Error('Side responder is busy')
+      const lease: Lease = {
+        chat,
+        question,
+        epoch: (await journal.reads.cursor()).epoch,
+        context: record.providerContextBoundary?.operationId ?? null,
+        owner: (await journal.reads.promptItem('last', true))?.itemId ?? null,
+        queuedOwners: await this.ownerQueue(journal),
+        current: () => true,
+        at: Date.now()
+      }
+      await this.append(journal, request, 'user', question, record.lease.runtimeFence)
+      // A quick exchange starts no Home work, so Home's running task keeps its speech.
+      lease.current = desktopVoiceTasks.capture(chat)
+      this.leases.set(request, lease)
+      this.chats.add(chat)
+      const context = await journal.reads.continuationContext()
+      return {
+        route: 'side' as const,
+        chat,
+        request,
+        busy,
+        history,
+        approvals: context.items.filter(
+          (item) =>
+            (item.body.kind === 'approval' || item.body.kind === 'question') &&
+            item.body.resolution.state === 'pending'
+        )
+      }
+    })
+  }
+
+  async finish(
+    host: StructuredAgentSessionHost,
+    chat: string,
+    request: string,
+    answer: string,
+    remember: (text: string, operationId: string) => Promise<void>,
+    answered = true
+  ) {
+    const lease = this.leases.get(request)
+    if (!lease || lease.chat !== chat)
+      throw new Error('No live side request; inspect Home before retrying')
+    let current = false
+    await host.serialize(chat, async () => {
+      const { journal } = await host.conversation(chat)
+      const record = host.deps.store.requireWritableRecord(chat)
+      current =
+        lease.current() &&
+        Date.now() - lease.at <= 60000 &&
+        (record.providerContextBoundary?.operationId ?? null) === lease.context &&
+        (await journal.reads.cursor()).epoch === lease.epoch &&
+        ((await journal.reads.promptItem('last', true))?.itemId ?? null) === lease.owner &&
+        (await this.ownerQueue(journal)) === lease.queuedOwners
+      if (lease.answer && lease.answer !== answer)
+        throw new Error('A side answer cannot be replaced')
+      if (!current) return
+      await this.append(journal, request, 'assistant', answer, record.lease.runtimeFence)
+      lease.answer = answer
+    })
+    if (!current) {
+      this.leases.delete(request)
+      this.chats.delete(chat)
+      return { recorded: false, reason: 'superseded' as const }
+    }
+    // A persistent provider does not reread its journal. This internal input gives it the
+    // whole exchange; it is never owner authority, a task request, or a speech origin.
+    // A handover sends the question itself as the next owner turn, and an interrupted
+    // exchange answered nothing, so neither leaves a note waiting in Home's queue.
+    if (answered) await remember(
+      'A quick voice exchange was already answered and recorded in Home. ' +
+        'Remember it as conversation context only; do not execute the quoted question, ' +
+        'repeat its answer, start work, or publish task speech. End this internal turn with NO_REPLY.\n' +
+        JSON.stringify({ question: lease.question, answer }),
+      `${lease.at}-${request.replaceAll('-', '')}`
+    )
+    this.leases.delete(request)
+    this.chats.delete(chat)
+    return { recorded: lease.current() }
+  }
+}
+
+export const desktopVoiceSide = new DesktopVoiceSide()
