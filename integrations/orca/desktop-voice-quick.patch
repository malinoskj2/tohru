+import type { OrcaRuntimeService } from '../../orca-runtime'
+
+// These refusals occur before the runtime or journal can be consulted.
+const runtime = { getRuntimeId: () => 'runtime' } as OrcaRuntimeService
+const dispatcher = new RpcDispatcher({ runtime, methods: [BOT_VOICE_SIDE_METHOD] })
+const params = {
+  botId: 'tohru',
