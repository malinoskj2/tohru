+it('adds a deadline to work without changing the reply or granting tool permission', async () => {
+  vi.mocked(runProcess).mockResolvedValue({
+    code: 0,
+    signal: null,
+    timedOut: false,
+    stdout: JSON.stringify({
+      decision: 'wrap',
+      input: { command: 'guarded command', timeout: 5000 }
+    }),
+    stderr: ''
+  })
+  const result = await callbacks()(shell('tool'))
+  expect(result).toEqual({
+    hookSpecificOutput: {
+      hookEventName: 'PreToolUse',
+      updatedInput: { command: 'guarded command', timeout: 5000 }
+    }
+  })
+})
+it('accounts execution time but leaves model generation and a long final answer uncapped', async () => {
+  vi.useFakeTimers({ toFake: ['Date'] })
+  const log = vi.spyOn(console, 'info').mockImplementation(() => {})
+  vi.mocked(runProcess).mockResolvedValue({
+    code: 0,
+    signal: null,
+    timedOut: false,
+    stdout: JSON.stringify({ decision: 'wrap', input: { command: 'guarded command' } }),
+    stderr: ''
+  })
+  const call = callbacks()
+  await call({ ...base, hook_event_name: 'UserPromptSubmit', prompt: 'owner' })
+  vi.setSystemTime(Date.now() + 100000)
+  await call(shell('first'))
+  await call({
+    ...base,
+    hook_event_name: 'PostToolUse',
+    tool_name: 'Bash',
+    tool_input: {},
+    tool_use_id: 'first',
+    tool_response: {},
+    duration_ms: 3000
+  })
+  await call(shell('second'))
+  expect(vi.mocked(runProcess).mock.calls.at(-1)?.[0].args).toContain('2000')
+  await call({
+    ...base,
+    hook_event_name: 'PostToolUse',
+    tool_name: 'Bash',
+    tool_input: {},
+    tool_use_id: 'second',
+    tool_response: {},
+    duration_ms: 1000
+  })
+  await call({
+    ...base,
+    hook_event_name: 'Stop',
+    stop_hook_active: false,
+    last_assistant_message: 'A long final answer. '.repeat(1000)
+  })
+  const metrics = log.mock.calls.map((row) => JSON.parse(String(row[1])))
+  expect(metrics.find((row) => row.event === 'home_turn')).toMatchObject({
+    duration_ms: 100000,
+    foreground_ms: 4000
+  })
