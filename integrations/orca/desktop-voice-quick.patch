@@ -0,0 +1,115 @@
+import type { HookCallback, Options } from '@anthropic-ai/claude-agent-sdk'
+import { runProcess } from '@orca/process-host'
+import * as z from 'zod'
+
+export const THIN_HOME_MARKER = '[tohru-thin-home:5000]'
+const Plan = z.discriminatedUnion('decision', [
+  z.object({ decision: z.literal('pass'), background: z.boolean().optional() }),
+  z.object({ decision: z.literal('deny'), reason: z.string() }),
+  z.object({ decision: z.literal('wrap'), input: z.record(z.string(), z.unknown()) })
+])
+const REFUSAL =
+  'Foreground work is unavailable. Delegate through Orca worker-start --background or Bash run_in_background=true; keep answering the owner normally.'
+
+/** Only tool time spends the budget. Model generation and the final reply have no deadline. */
+export function claudeThinHomeOptions(session: string): Pick<Options, 'hooks'> {
+  let started: number | null = null
+  let spent = 0
+  let tools = 0
+  const active = new Map<string, { at: number; background: boolean }>()
+  const metric = (event: string, fields: Record<string, number | string | boolean>) => {
+    console.info('[tohru-home]', JSON.stringify({ event, session, wall_ms: Date.now(), ...fields }))
+  }
+  const deny = (reason: string) => ({
+    hookSpecificOutput: {
+      hookEventName: 'PreToolUse' as const,
+      permissionDecision: 'deny' as const,
+      permissionDecisionReason: reason
+    }
+  })
+  const hook: HookCallback = async (input) => {
+    switch (input.hook_event_name) {
+      case 'UserPromptSubmit':
+        if (started === null) {
+          started = Date.now()
+          spent = 0
+          tools = 0
+        }
+        return {}
+      case 'Stop':
+        if (started !== null)
+          metric('home_turn', { duration_ms: Date.now() - started, foreground_ms: spent, tools })
+        started = null
+        active.clear()
+        return {}
+      case 'PostToolUse':
+      case 'PostToolUseFailure': {
+        const previous = active.get(input.tool_use_id)
+        if (previous) {
+          const duration = Math.max(0, input.duration_ms ?? Date.now() - previous.at)
+          active.delete(input.tool_use_id)
+          if (!previous.background) spent += duration
+          metric('home_tool', {
+            duration_ms: duration,
+            foreground_ms: spent,
+            background: previous.background
+          })
+        }
+        return {}
+      }
+      case 'PreToolUse': {
+        if (started === null) {
+          started = Date.now()
+          spent = 0
+          tools = 0
+        }
+        if (active.size > 0)
+          return deny('Finish the current foreground tool before another. ' + REFUSAL)
+        active.set(input.tool_use_id, { at: Date.now(), background: false })
+        try {
+          const result = await runProcess({
+            program: 'tohru-home-guard',
+            args: ['plan', '--remaining-ms', String(Math.max(0, Math.floor(5000 - spent)))],
+            input: JSON.stringify({ tool: input.tool_name, input: input.tool_input }),
+            timeoutMs: 1000,
+            maxOutputBytes: 64000
+          })
+          if (result.code !== 0 || result.timedOut) {
+            active.delete(input.tool_use_id)
+            return deny(REFUSAL)
+          }
+          const plan = Plan.parse(JSON.parse(result.stdout))
+          if (plan.decision === 'deny') {
+            active.delete(input.tool_use_id)
+            metric('home_tool_blocked', { tool: input.tool_name, foreground_ms: spent })
+            return deny(plan.reason)
+          }
+          if (input.tool_name !== 'AskUserQuestion') {
+            tools += 1
+            active.set(input.tool_use_id, {
+              at: Date.now(),
+              background: plan.decision === 'pass' && plan.background === true
+            })
+          } else active.delete(input.tool_use_id)
+          return plan.decision === 'wrap'
+            ? { hookSpecificOutput: { hookEventName: 'PreToolUse', updatedInput: plan.input } }
+            : {}
+        } catch {
+          active.delete(input.tool_use_id)
+          return deny(REFUSAL)
+        }
+      }
+      default:
+        return {}
+    }
+  }
+  return {
+    hooks: {
+      UserPromptSubmit: [{ hooks: [hook] }],
+      PreToolUse: [{ hooks: [hook] }],
+      PostToolUse: [{ hooks: [hook] }],
+      PostToolUseFailure: [{ hooks: [hook] }],
+      Stop: [{ hooks: [hook] }]
+    }
+  }
+}
