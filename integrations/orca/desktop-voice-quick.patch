+import * as z from 'zod'
+
+export const BotVoiceSide = z.discriminatedUnion('phase', [
+  z.object({
+    phase: z.literal('begin'),
+    botId: z.string().min(1),
+    request: z.uuid(),
+    text: z.string().trim().min(1).max(16000),
+    /** Admit the side responder while Home is idle too, instead of routing to Home. */
+    always: z.boolean().default(false)
+  }),
+  z.object({
+    phase: z.literal('finish'),
+    botId: z.string().min(1),
+    request: z.uuid(),
+    text: z.string().trim().min(1).max(4000),
+    /** False for a handover or an interruption: Home gets no context note for it. */
+    answered: z.boolean().default(true)
+  })
+])
