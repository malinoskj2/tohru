+it('fails closed when the installed tool guard is unavailable', async () => {
+  vi.mocked(runProcess).mockRejectedValueOnce(new Error('not installed'))
+  expect(await callbacks()(shell('tool'))).toMatchObject({
+    hookSpecificOutput: { permissionDecision: 'deny' }
+  })
