@@ -0,0 +1,63 @@
+import { BotChatSend } from '../../../../shared/rpc-contract/bots-params'
+import { runtimeBotChats, startBotSession } from '../../../bots/bot-chat-session'
+import { chatThatTookIt } from '../../../bots/bot-automation-sessions'
+import { botChatTakingMail } from './bots-chats'
+import { OWNER_ACTS_FOR } from '../../../../shared/bots/bot-acts-for'
+import { agentJournalSubmissionKey } from '../../../../shared/agent-session/journal/agent-session-journal-item-key'
+import { ownerOnly } from './bots-caller-gates'
+import { defineMethod, InvalidArgumentError } from '../core'
+
+export const BOT_DESKTOP_CHAT_METHOD = defineMethod({
+  name: 'bots.chat.send',
+  permission: 'workspace',
+  params: BotChatSend,
+  handler: async ({ botId, text, chat, operationId }, context) => {
+    // The desktop assistant uses the local owner-token socket without an
+    // agent session. Agent-originated requests keep using orchestration mail.
+    if (context.orchestrationCaller) {
+      throw new InvalidArgumentError('Agent messages use orchestration mail')
+    }
+    if (context.caller?.kind !== 'local-cli') {
+      ownerOnly(context, 'Only the owner can send direct bot messages.')
+    }
+    const { runtime } = context
+    runtime.bots.assertEnabled()
+    const bot = runtime.bots.list().find((entry) => entry.id === botId)
+    if (!bot || bot.paused) {
+      throw new InvalidArgumentError('Bot is missing or paused')
+    }
+    const chats = runtimeBotChats(runtime)
+    const receipt = (sent: ReturnType<typeof chatThatTookIt>) => ({
+      ...sent,
+      promptItemId: agentJournalSubmissionKey(sent.clientMessageId)
+    })
+    if (!chat) {
+      return receipt(
+        chatThatTookIt(await chats.sendToChat(bot.id, text, undefined, undefined, operationId))
+      )
+    }
+    let sessionId = chat
+    if (chat === 'new') {
+      // A retried request addresses the same new chat and the same admission ledger.
+      const hex = operationId.slice(14)
+      sessionId = `${hex.slice(0, 8)}-${hex.slice(8, 12)}-4${hex.slice(13, 16)}-8${hex.slice(17, 20)}-${hex.slice(20)}`
+      if (!(await botChatTakingMail(runtime, bot, sessionId))) {
+        await startBotSession(runtime, bot, {
+          sessionId,
+          actsFor: { actsFor: [...OWNER_ACTS_FOR] }
+        })
+      }
+    } else {
+      const target = await botChatTakingMail(runtime, bot, chat)
+      if (!target) {
+        throw new InvalidArgumentError('Chat is closed or does not belong to this bot')
+      }
+      sessionId = target.sessionId
+    }
+    return receipt(
+      chatThatTookIt(
+        await chats.sendToSession(bot.id, sessionId, text, undefined, undefined, operationId)
+      )
+    )
+  }
+})
