+import { BotVoiceReady, BotVoiceTask } from '../../../../shared/rpc-contract/bot-voice-params'
+import { botOfSession } from '../../../bots/bot-session-tabs'
+import { desktopVoiceOrigin } from '../../../bots/desktop-voice-continuations'
+import { desktopVoiceTasks } from '../../../bots/desktop-voice-task-delivery'
+import { defineMethod, InvalidArgumentError } from '../core'
+
+export const BOT_VOICE_METHODS = [
+  defineMethod({
+    name: 'bots.voice.ready',
+    permission: 'workspace',
+    params: BotVoiceReady,
+    handler: async (origin, context) => {
+      if (
+        context.pairedDeviceId ||
+        context.orchestrationCaller ||
+        context.caller?.kind !== 'local-cli'
+      ) {
+        throw new InvalidArgumentError(
+          'Desktop registration requires the local owner socket without an agent caller'
+        )
+      }
+      const current = await desktopVoiceOrigin(context.runtime, origin.chat)
+      if (current?.request !== origin.request) {
+        throw new InvalidArgumentError('Voice request is not current')
+      }
+      await desktopVoiceTasks.ready(origin)
+      return { registered: true }
+    }
+  }),
+  defineMethod({
+    name: 'bots.voice.task',
+    permission: 'workspace',
+    params: BotVoiceTask,
+    handler: async ({ callerSessionId, request, ...event }, context) => {
+      const caller = context.orchestrationCaller
+      if (
+        context.pairedDeviceId ||
+        caller?.orcaSessionId !== callerSessionId ||
+        !botOfSession(context.runtime.bots, callerSessionId)
+      ) {
+        throw new InvalidArgumentError(
+          'Only the coordinating bot in its own local chat can publish task speech'
+        )
+      }
+      const origin = await desktopVoiceOrigin(context.runtime, callerSessionId)
+      if (!origin || (request !== undefined && request !== origin.request)) {
+        throw new InvalidArgumentError('No matching current desktop voice request')
+      }
+      const delivery = await desktopVoiceTasks.publish(origin, event)
+      return { request: origin.request, delivery }
+    }
+  })
+]
