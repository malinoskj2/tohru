@@ -0,0 +1,32 @@
+import { runProcess } from '@orca/process-host'
+import { DesktopVoiceTaskQueue } from './desktop-voice-task-queue'
+
+export async function runDesktopAssistant(args: string[]): Promise<void> {
+  const result = await runProcess({
+    program: process.env.ORCA_DESKTOP_ASSISTANT_COMMAND ?? 'tohru',
+    args,
+    timeoutMs: 5000,
+    maxOutputBytes: 4096
+  })
+  if (result.code !== 0) {
+    throw new Error('Desktop voice IPC failed or timed out')
+  }
+}
+export const desktopVoiceTasks = new DesktopVoiceTaskQueue(async (origin, event) => {
+  await runDesktopAssistant([
+    'assistant',
+    'voice-task',
+    '--chat',
+    origin.chat,
+    '--request',
+    origin.request,
+    '--task',
+    event.task,
+    '--sequence',
+    String(event.sequence),
+    '--kind',
+    event.kind,
+    '--',
+    event.text
+  ])
+})
