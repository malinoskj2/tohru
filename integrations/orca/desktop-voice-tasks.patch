+import { expect, it } from 'vitest'
+import { DesktopVoiceTaskQueue } from './desktop-voice-task-queue'
+import { BotVoiceTask, type DesktopVoiceTask } from '../../shared/rpc-contract/bot-voice-params'
+
+const origin = { chat: '12345678-1234-4234-8234-123456789abc', request: 'orca:voice-request' }
+const event = (
+  kind: DesktopVoiceTask['kind'],
+  sequence: number,
+  task = 'workspace'
+): DesktopVoiceTask => ({
+  task,
+  kind,
+  sequence,
+  text: kind === 'ack' ? "I'll create that workspace now." : `${kind} confirmed`
+})
+
+it('waits for desktop registration in either order without delaying task execution', async () => {
+  const seen: string[] = []
+  const queue = new DesktopVoiceTaskQueue(async (_, update) => {
+    seen.push(update.text)
+  })
+  expect(await queue.publish(origin, event('ack', 1))).toBe('pending')
+  expect(seen).toEqual([])
+  expect(queue.taskMode(origin)).toBe(false)
+  await queue.ready(origin)
+  expect(seen).toEqual(["I'll create that workspace now."])
+  expect(queue.taskMode(origin)).toBe(true)
+  await queue.publish(origin, event('progress', 2))
+  await queue.publish(origin, event('done', 3))
+  expect(seen).toEqual(["I'll create that workspace now.", 'progress confirmed', 'done confirmed'])
+  const other = { ...origin, chat: '22345678-1234-4234-8234-123456789abc' }
+  await queue.ready(other)
+  await queue.publish(other, event('ack', 1))
+  expect(seen[3]).toBe("I'll create that workspace now.")
+})
+
+it('coalesces progress before readiness and never replays terminal events', async () => {
+  const seen: string[] = []
+  const queue = new DesktopVoiceTaskQueue(async (_, update) => {
+    seen.push(update.kind)
+  })
+  await queue.publish(origin, event('ack', 1))
+  await queue.publish(origin, event('progress', 2))
+  await queue.publish(origin, event('failed', 3))
+  expect(await queue.publish(origin, event('done', 4))).toBe('replay')
+  await queue.ready(origin)
+  await queue.ready(origin)
+  expect(seen).toEqual(['ack', 'failed'])
+})
+
+it('drains an acknowledgement that races an empty registration flush', async () => {
+  const seen: string[] = []
+  const queue = new DesktopVoiceTaskQueue(async (_, update) => {
+    seen.push(update.kind)
+  })
+  await Promise.all([queue.ready(origin), queue.publish(origin, event('ack', 1))])
+  expect(seen).toEqual(['ack'])
+})
+
+it('fences in-flight delivery and readiness when the owner supersedes a request', async () => {
+  const seen: string[] = []
+  let release: () => void = () => {}
+  const held = new Promise<void>((resolve) => {
+    release = resolve
+  })
+  const queue = new DesktopVoiceTaskQueue(async (_, update) => {
+    seen.push(update.kind)
+    await held
+  })
+  await queue.publish(origin, event('ack', 1))
+  await queue.publish(origin, event('done', 2))
+  const unchanged = queue.capture()
+  const ready = queue.ready(origin)
+  queue.ownerTurn(origin.chat)
+  expect(unchanged()).toBe(false)
+  release()
+  await ready
+  expect(seen).toEqual(['ack'])
+  expect(queue.taskMode(origin)).toBe(false)
+})
+
+it('bounds requests and task IDs, expires queued speech, and consumes ambiguous failures', async () => {
+  let now = 0
+  const seen: string[] = []
+  const queue = new DesktopVoiceTaskQueue(
+    async (_, update) => {
+      seen.push(update.kind)
+    },
+    () => now
+  )
+  for (let i = 0; i < 8; i++) {
+    await queue.publish(origin, event('ack', 1, String(i)))
+  }
+  await expect(queue.publish(origin, event('ack', 1, 'overflow'))).rejects.toThrow('at most eight')
+  now = 30001
+  await queue.ready(origin)
+  expect(seen).toEqual([])
+  const failed = new DesktopVoiceTaskQueue(async () => {
+    throw new Error('IPC exited after possible delivery')
+  })
+  await failed.ready(origin)
+  await expect(failed.publish(origin, event('ack', 1))).rejects.toThrow('IPC exited')
+  expect(await failed.publish(origin, event('ack', 1))).toBe('replay')
+  for (let i = 0; i < 63; i++) {
+    await queue.ready({ ...origin, chat: `other-${i}` })
+  }
+  await expect(queue.ready({ ...origin, chat: 'overflow' })).rejects.toThrow('capacity')
+})
+
+it('validates the authoring boundary before anything enters the speech channel', () => {
+  const base = { ...event('ack', 1), callerSessionId: origin.chat }
+  expect(BotVoiceTask.safeParse(base).success).toBe(true)
+  for (const patch of [
+    { kind: 'commentary' },
+    { kind: 'worker_done' },
+    { text: '\ninternal' },
+    { text: '🦋'.repeat(81) },
+    { sequence: 0 },
+    { task: 'bad\nidentity' },
+    { kind: 'done' }
+  ]) {
+    expect(BotVoiceTask.safeParse({ ...base, ...patch }).success).toBe(false)
+  }
+})
diff --git a/src/main/bots/desktop-voice-task-queue.ts b/src/main/bots/desktop-voice-task-queue.ts
new file mode 100644
index 00000000..c7715422
--- /dev/null
+++ b/src/main/bots/desktop-voice-task-queue.ts
@@ -0,0 +1,142 @@
+import type {
+  DesktopVoiceOrigin,
+  DesktopVoiceTask
+} from '../../shared/rpc-contract/bot-voice-params'
+
+type Pending = { event: DesktopVoiceTask; at: number }
+type Task = { sequence: number; terminal: boolean }
+type Request = {
+  origin: DesktopVoiceOrigin
+  at: number
+  ready: boolean
+  taskMode: boolean
+  tasks: Map<string, Task>
+  pending: Pending[]
+  drain: Promise<void> | null
+}
+
+export class DesktopVoiceTaskQueue {
+  private readonly requests = new Map<string, Request>()
+  private revision = 0
+
+  constructor(
+    private readonly deliver: (
+      origin: DesktopVoiceOrigin,
+      event: DesktopVoiceTask
+    ) => Promise<void>,
+    private readonly clock: () => number = Date.now
+  ) {}
+
+  ownerTurn(chat: string): void {
+    this.revision += 1
+    this.requests.delete(chat)
+  }
+
+  capture(): () => boolean {
+    const revision = this.revision
+    return () => this.revision === revision
+  }
+
+  taskMode(origin: DesktopVoiceOrigin): boolean {
+    const state = this.requests.get(origin.chat)
+    return (
+      state?.origin.request === origin.request &&
+      state.taskMode &&
+      this.clock() - state.at <= 600000
+    )
+  }
+
+  private state(origin: DesktopVoiceOrigin): Request {
+    for (const [chat, state] of this.requests) {
+      if (this.clock() - state.at > 600000) {
+        this.requests.delete(chat)
+      }
+    }
+    let state = this.requests.get(origin.chat)
+    if (state && state.origin.request !== origin.request) {
+      throw new Error('Voice request was superseded')
+    }
+    if (!state) {
+      if (this.requests.size >= 64) {
+        throw new Error('Desktop voice request capacity reached')
+      }
+      state = {
+        origin,
+        at: this.clock(),
+        ready: false,
+        taskMode: false,
+        tasks: new Map(),
+        pending: [],
+        drain: null
+      }
+      this.requests.set(origin.chat, state)
+    }
+    return state
+  }
+
+  async ready(origin: DesktopVoiceOrigin): Promise<void> {
+    const state = this.state(origin)
+    state.ready = true
+    await this.flush(state)
+  }
+
+  async publish(
+    origin: DesktopVoiceOrigin,
+    event: DesktopVoiceTask
+  ): Promise<'pending' | 'dispatched' | 'replay'> {
+    const state = this.state(origin)
+    const task = state.tasks.get(event.task)
+    if (task && (task.terminal || event.sequence <= task.sequence || event.kind === 'ack')) {
+      return 'replay'
+    }
+    if (!task && (event.kind !== 'ack' || state.tasks.size >= 8)) {
+      throw new Error('A task must start with acknowledgement; at most eight tasks per request')
+    }
+    state.tasks.set(event.task, {
+      sequence: event.sequence,
+      terminal: event.kind === 'done' || event.kind === 'failed' || event.kind === 'cancelled'
+    })
+    state.pending = state.pending.filter(
+      ({ event: queued }) => queued.task !== event.task || queued.kind === 'ack'
+    )
+    state.pending.push({ event, at: this.clock() })
+    if (!state.ready) {
+      return 'pending'
+    }
+    await this.flush(state)
+    return 'dispatched'
+  }
+
+  private async flush(state: Request): Promise<void> {
+    if (state.drain) {
+      await state.drain
+      if (state.pending.length > 0 && this.requests.get(state.origin.chat) === state) {
+        await this.flush(state)
+      }
+      return
+    }
+    state.drain = this.drain(state)
+    try {
+      await state.drain
+    } finally {
+      state.drain = null
+    }
+  }
+
+  private async drain(state: Request): Promise<void> {
+    while (state.ready && this.requests.get(state.origin.chat) === state) {
+      const next = state.pending.shift()
+      if (!next) {
+        return
+      }
+      if (this.clock() - next.at > 30000) {
+        continue
+      }
+      // Consume before IPC: a failed process may already have delivered its payload.
+      if (next.event.kind === 'ack') {
+        state.taskMode = true
+      }
+      await this.deliver(state.origin, next.event)
+    }
+  }
+}
