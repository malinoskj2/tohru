+): Promise<void> {
+  const origin = continuations.dispatchOrigin(dispatch)
+  if (!origin) return
+  const task = `dispatch:${dispatch}`
+  if (state !== 'accepted' && !desktopVoiceTasks.hasTask(origin, task)) return
+  try {
+    await desktopVoiceTasks.publish(origin, {
+      task,
+      sequence: state === 'accepted' ? 1 : 2,
+      kind:
+        state === 'accepted'
+          ? 'ack'
+          : state === 'cancelled'
+            ? 'cancelled'
+            : state === 'failed'
+              ? 'failed'
+              : 'progress',
+      text:
+        state === 'accepted'
+          ? 'I have accepted that work. It is being set up, and we can keep talking.'
+          : state === 'ready'
+            ? 'The background worker is ready and has received the task.'
+            : state === 'unknown'
+              ? 'The launch is not confirmed yet. I have kept its task record for inspection.'
+              : state === 'cancelled'
+                ? 'The background launch was cancelled.'
+                : 'The background worker could not start. The task record has the details.'
+    })
+  } catch {
+    // Speech failure never changes the durable task result or retries an uncertain IPC write.
+    trace('launch_speech_dropped', { dispatch, state })
+  }
